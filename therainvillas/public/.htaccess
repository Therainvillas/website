  # Slug lama (nama saja) -> slug baru, satu 301 langsung ke tujuan akhir.
  RewriteRule ^villa-agave/?$ /villa-agave-batulayang-puncak/ [R=301,L]
  RewriteRule ^villa-wanela/?$ /villa-wanela-sukagalih-puncak/ [R=301,L]
