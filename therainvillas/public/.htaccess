  RewriteRule ^villa-elora/?$ /villa-elora-leuwimalang-puncak/ [R=301,L]

  # URL lama /villas/{slug-lama}/ -> slug baru.
  RewriteRule ^villas/villa-agave/?$ /villa-agave-batulayang-puncak/ [R=301,L]
  RewriteRule ^villas/villa-wanela/?$ /villa-wanela-sukagalih-puncak/ [R=301,L]
  RewriteRule ^villas/villa-cemara/?$ /villa-cemara-cibeureum-puncak/ [R=301,L]
  RewriteRule ^villas/villa-aleia/?$ /villa-aleia-tugu-selatan-puncak/ [R=301,L]
  RewriteRule ^villas/villa-4d/?$ /villa-4d-tugu-selatan-puncak/ [R=301,L]
  RewriteRule ^villas/villa-calmora/?$ /villa-calmora-tugu-utara-puncak/ [R=301,L]
  RewriteRule ^villas/villa-twins/?$ /villa-twins-batulayang-puncak/ [R=301,L]
