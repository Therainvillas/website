<IfModule mod_rewrite.c>
  RewriteEngine On
  # URL lama /villas/{id}/ -> slug baru (nama + area + puncak).
  RewriteRule ^villas/1/?$ /villa-agave-batulayang-puncak/ [R=301,L]
  RewriteRule ^villas/2/?$ /villa-wanela-sukagalih-puncak/ [R=301,L]
