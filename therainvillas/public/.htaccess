  # Villa Hariza sudah berganti nama menjadi Villa Elora.
  RewriteRule ^villa-hariza/?$ /villa-elora-leuwimalang-puncak/ [R=301,L]
  RewriteRule ^villas/villa-hariza/?$ /villa-elora-leuwimalang-puncak/ [R=301,L]

  # www -> non-www. Target sudah berslash supaya tetap satu 301.
  RewriteCond %{HTTP_HOST} ^www\.therainvillas\.com$ [NC]
  RewriteRule ^(.*[^/])$ https://therainvillas.com/$1/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.therainvillas\.com$ [NC]
  RewriteRule ^(.*)$ https://therainvillas.com/$1 [R=301,L]

  # Semua halaman tanpa trailing slash -> versi berslash (SATU 301).
  # Lewati file statis (punya ekstensi) dan /.well-known/ (ACME, dll).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(robots\.txt|sitemap-index\.xml|sitemap-0\.xml)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Expires "0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(admin/|index\.html)$">
    Header append Link '</llms.txt>; rel="alternate"; type="text/plain", </>; rel="canonical"'
  </FilesMatch>
  <FilesMatch "^admin/">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_ACCEPT} text/markdown
  RewriteRule ^$ /index.md [L]
</IfModule>
