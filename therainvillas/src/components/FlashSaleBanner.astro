---
/**
 * Banner Flash Sale 24 Oktober 2026.
 * Tampil otomatis selama flash sale belum berakhir (lihat flashSale.js).
 */
import { formatPrice } from '../data/villas.js';
import {
  FLASH_SALE_DATE,
  FLASH_SALE_LABEL,
  flashSaleVillas,
  isFlashSaleActive,
} from '../data/flashSale.js';

const active = isFlashSaleActive();
const items = active ? flashSaleVillas : [];

function bookingHref(name: string) {
  const checkOut = '2026-10-25';
  return `/booking?villa=${encodeURIComponent(name)}&checkIn=${FLASH_SALE_DATE}&checkOut=${checkOut}`;
}
---

{active && (
  <section class="flash-sale" id="flash-sale" aria-label={FLASH_SALE_LABEL}>
    <div class="container">
      <div class="flash-sale__head">
        <span class="flash-sale__eyebrow">⚡ {FLASH_SALE_LABEL}</span>
        <h2 class="flash-sale__title">Harga Spesial Hanya 24 Oktober 2026</h2>
        <p class="flash-sale__sub">
          Harga normal dicoret, harga flash sale berlaku untuk menginap tanggal 24 Oktober 2026.
          Kuota terbatas — konfirmasi cepat via WhatsApp.
        </p>
      </div>

      <div class="flash-sale__grid">
        {items.map((item) => (
          <a class="flash-sale__card" href={bookingHref(item.name)}>
            <div class="flash-sale__media">
              <img src={item.image} alt={item.name} loading="lazy" decoding="async" />
              <span class="flash-sale__tag">⚡ Flash Sale</span>
            </div>
            <div class="flash-sale__body">
              <h3>{item.name}</h3>
              <p class="flash-sale__meta">
                {item.capacity} tamu • {item.bedrooms} kamar
              </p>
              <p class="flash-sale__price">
                {item.originalPrice != null && <s>{formatPrice(item.originalPrice)}</s>}
                <strong>{formatPrice(item.salePrice)}</strong>
                <span class="flash-sale__pernight">/malam</span>
              </p>
              <span class="flash-sale__saving">Hemat {formatPrice(item.saving)}</span>
            </div>
          </a>
        ))}
      </div>

      <p class="flash-sale__note">
        Harga di atas adalah harga per malam untuk tanggal 24 Oktober 2026 dan sudah otomatis
        dihitung di form booking.
      </p>
    </div>
  </section>
)}

<style>
  .flash-sale {
    position: relative;
    padding: 64px 0 72px;
    background:
      radial-gradient(circle at 12% 0%, rgba(255, 122, 24, 0.18) 0%, transparent 55%),
      radial-gradient(circle at 88% 100%, rgba(255, 61, 110, 0.16) 0%, transparent 55%),
      var(--color-gray-light);
    overflow: hidden;
  }

  .flash-sale__head {
    max-width: 680px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .flash-sale__eyebrow {
    display: inline-block;
    padding: 7px 18px;
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(135deg, #ff3d6e 0%, #ff7a18 100%);
    box-shadow: 0 8px 22px rgba(255, 61, 110, 0.32);
  }

  .flash-sale__title {
    margin: 16px 0 10px;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    line-height: 1.15;
    color: var(--color-dark);
  }

  .flash-sale__sub {
    margin: 0;
    color: var(--color-gray);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .flash-sale__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .flash-sale__card {
    display: flex;
    flex-direction: column;
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.07);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .flash-sale__card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 44px rgba(255, 61, 110, 0.18);
  }

  .flash-sale__media {
    position: relative;
    height: 160px;
    overflow: hidden;
  }

  .flash-sale__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .flash-sale__card:hover .flash-sale__media img {
    transform: scale(1.06);
  }

  .flash-sale__tag {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(135deg, #ff3d6e 0%, #ff7a18 100%);
    box-shadow: 0 6px 16px rgba(255, 61, 110, 0.4);
  }

  .flash-sale__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px 18px;
  }

  .flash-sale__body h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-dark);
  }

  .flash-sale__meta {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  .flash-sale__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 7px;
    margin: 4px 0 0;
  }

  .flash-sale__price s {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  .flash-sale__price strong {
    font-size: 1.15rem;
    font-weight: 800;
    color: #d92e5c;
  }

  .flash-sale__pernight {
    font-size: 0.72rem;
    color: var(--color-muted);
  }

  .flash-sale__saving {
    align-self: flex-start;
    margin-top: 2px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    font-size: 0.7rem;
    font-weight: 700;
    color: #8a2318;
    background: rgba(255, 122, 24, 0.16);
  }

  .flash-sale__note {
    max-width: 720px;
    margin: 28px auto 0;
    text-align: center;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  @media (max-width: 1024px) {
    .flash-sale__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .flash-sale {
      padding: 48px 0 56px;
    }

    .flash-sale__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
