          ctx.globalAlpha = al;
          ctx.strokeStyle = p.c;
          ctx.lineWidth = p.size;
          ctx.beginPath();
          ctx.moveTo(p.px, p.py);
          ctx.lineTo(p.x + 0.01, p.y);
          ctx.stroke();
          continue;
        }
        p.px = p.x;
        p.py = p.y;
        p.vx *= Math.pow(p.f, f);
        p.vy *= Math.pow(p.f, f);
        p.vy += p.g * f;
        p.x += p.vx * f;
        p.y += p.vy * f;
        p.life -= p.decay * f;
        if (p.life <= 0) {
          parts.splice(i, 1);
          continue;
        }
        ctx.globalAlpha = Math.min(1, p.life * 1.4);
        ctx.strokeStyle = p.c;
        ctx.lineWidth = p.size * (0.5 + 0.5 * p.life);
        ctx.beginPath();
        ctx.moveTo(p.px, p.py);
        ctx.lineTo(p.x, p.y);
        ctx.stroke();
