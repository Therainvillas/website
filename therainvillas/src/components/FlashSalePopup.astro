    var WC = ['#ffd479', '#fff2c9', '#7fe7ff', '#ff8fb0'];       // warna cahaya jendela
    var FONT = '"Inter Variable","Inter","Work Sans Variable","Segoe UI",Arial,sans-serif';

    var cv, ctx, W = 0, H = 0, U = 1, dpr = 1, running = false, shown = false, raf = 0, last = 0, t = 0, R;
    var baseY, walkY, trackY, sky, ground, far, mid, near, wheel, cars, peds, sparks = [], train, blimp, stars, beams, fog, sign;

