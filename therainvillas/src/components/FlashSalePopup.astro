      let x;
      let y;
      if (!T.pts.length) return;
      if (isBrand) {
        // besar, di tengah, tepat di atas kartu
        pal = PAL[0];
        const hh = (T.h * sc) / 2;
        x = W / 2;
        y = Math.max(hh + 12, Math.min(H * 0.3, box().t - hh - 14));
      } else {
        // kecil, tempat acak
        const pos = place(T, sc);
        if (!pos) return;
        x = pos.x;
        y = pos.y;
        pal = pick(PAL);
      }
      reserve(x, y, T, sc, wait, !isBrand);
      const x0 = W / 2 + (x - W / 2) * 0.6;
      rockets.push({
        x0,
        y0: H - 30,
        x1: x,
        y1: y,
        p: 0,
        dur: rnd(0.8, 1.15),
        wait: wait || 0,
        T,
        sc,
        pal,
        small: !isBrand,
        px: x0,
        py: H - 30,
      });
    }

    function spark(x, y) {
      parts.push({
        x,
        y,
        px: x,
        py: y,
        vx: rnd(-0.6, 0.6),
        vy: rnd(0.2, 1.2),
        life: 1,
        decay: rnd(0.05, 0.09),
        size: 1.2,
        c: '#ffd9a0',
        g: 0.04,
        f: 0.96,
      });
    }

    function explode(r, x, y) {
      const T = r.T;
      const sc = r.sc;
      const col = r.pal[0];
      const P = 6.4 * S * (r.small ? 0.4 : 1);
      const sp = 6 * sc;
      const sz = Math.max(1.4, Math.min(3.4, sp * 0.7));
      let i;
      let a;
      for (i = 0; i < T.pts.length; i++) {
        // titik-titik huruf terbang dari pusat ledakan
        const q = T.pts[i];
        parts.push({
          x,
          y,
          px: x,
          py: y,
          sx: x,
          sy: y,
          tx: x + q[0] * sc,
          ty: y + q[1] * sc,
          t: -Math.random() * 0.1,
          size: sz,
          c: Math.random() < 0.72 ? col : '#fff6e0',
          txt: 1,
          vy: 0,
