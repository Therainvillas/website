---
// Popup promo Paket 2 Malam Tahun Baru 2027.
//
// Dulu komponen ini Vue (client:idle) sehingga seluruh runtime Vue (~33 KB gzip)
// ikut diunduh di halaman depan hanya untuk sebuah modal. Markup, teks, dan gaya
// di bawah ini identik dengan versi Vue; interaksinya ditangani script vanilla
// kecil agar first paint / TBT tetap ringan.
import { getGeneralImageSeo } from '../utils/imageSeo';

const flashSaleImageSeo = getGeneralImageSeo('flash-sale');
---

<div class="flash-popup" data-flash-popup hidden>
  <div
    class="flash-popup__modal"
    data-flash-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="flash-sale-title"
    aria-describedby="flash-sale-desc"
  >
    <button
      type="button"
      class="flash-popup__close"
      data-flash-close
      aria-label="Tutup popup promo paket 2 malam Tahun Baru 2027"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>

    <figure class="flash-popup__hero">
      <picture>
        <source data-flash-source media="(max-width: 560px)" />
        <img
          data-flash-img
          alt={flashSaleImageSeo.alt}
          title={flashSaleImageSeo.title}
          class="flash-popup__img"
          width="1200"
          height="848"
          decoding="async"
        />
      </picture>
      <div class="flash-popup__fireworks" aria-hidden="true">
        <span class="flash-popup__fw flash-popup__fw--1"></span>
        <span class="flash-popup__fw flash-popup__fw--2"></span>
        <span class="flash-popup__fw flash-popup__fw--3"></span>
        <span class="flash-popup__fw flash-popup__fw--4"></span>
      </div>
    </figure>

    <div class="flash-popup__panel">
      <p class="flash-popup__kicker">
        <span class="flash-popup__dot" aria-hidden="true"></span>
        <span id="flash-sale-title">Paket 2 Malam · Tahun Baru 2027</span>
      </p>

      <p id="flash-sale-desc" class="flash-popup__headline">
        Paket 2 malam lebih murah dibanding menginap 1 malam untuk Tahun Baru
      </p>

      <div class="flash-popup__actions">
        <a
          href="https://wa.me/6282125492037?text=Halo%20The%20Rain%20Villas%2C%20saya%20ingin%20tanya%20promo%20paket%202%20malam%20Tahun%20Baru%202027."
          target="_blank"
          rel="noopener"
          class="flash-popup__btn flash-popup__btn--primary"
          data-flash-close
        >
          Tanya Paket 2 Malam
        </a>
        <a href="/our-villas/" class="flash-popup__btn" data-flash-close>Lihat Villa</a>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    // Popup dianggap sudah ditutup hanya untuk sesi browser ini. Saat halaman
    // di-refresh, popup sengaja ditampilkan lagi; saat pindah halaman biasa
    // dalam sesi yang sama, popup tidak muncul ulang.
    const DISMISS_KEY = 'trv_promo_ny2027_dismissed';
    const SHOW_DELAY_MS = 900;

    const popup = document.querySelector('[data-flash-popup]');
    if (!popup) return;

    const modal = popup.querySelector('[data-flash-modal]');
    const closeBtn = popup.querySelector('.flash-popup__close');
    const img = popup.querySelector('[data-flash-img]');
    const source = popup.querySelector('[data-flash-source]');

    let visible = false;
    let revealTimer = 0;
    let closeTimer = 0;
    let lastFocused = null;
    let prevOverflow = '';
    let prevPaddingRight = '';
    let bodyLocked = false;

    /** true bila halaman ini dibuka lewat refresh/reload, bukan navigasi biasa. */
    function isReload() {
      try {
        const [nav] = performance.getEntriesByType('navigation');
        if (nav && nav.type) return nav.type === 'reload';
        return Boolean(performance.navigation) && performance.navigation.type === 1;
      } catch (error) {
        return false;
      }
    }

    function canShow() {
      if (/^\/admin(\/|$)/.test(location.pathname)) return false;
      // Refresh selalu memunculkan popup, meskipun sebelumnya sudah ditutup.
      if (isReload()) return true;
      try {
        if (sessionStorage.getItem(DISMISS_KEY) === '1') return false;
      } catch (error) {
        /* ignore */
      }
      return true;
    }

    function lockBody() {
      if (bodyLocked) return;
      bodyLocked = true;
      prevOverflow = document.body.style.overflow;
      prevPaddingRight = document.body.style.paddingRight;
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.overflow = 'hidden';
      if (scrollbarWidth > 0) document.body.style.paddingRight = `${scrollbarWidth}px`;
    }

    function unlockBody() {
      if (!bodyLocked) return;
      bodyLocked = false;
      document.body.style.overflow = prevOverflow || '';
      document.body.style.paddingRight = prevPaddingRight || '';
    }

    function preloadHero() {
      const mobile = window.matchMedia('(max-width: 560px)').matches;
      const src = mobile
        ? '/promo/promo-2-malam-800.webp'
        : '/promo/promo-2-malam-1200.webp';
      if (source) source.srcset = '/promo/promo-2-malam-800.webp';
      if (img) {
        img.src = src;
        if (img.decode) img.decode().catch(() => {});
      }
    }

    function trapFocus(event) {
      if (!modal) return;
      const focusable = modal.querySelectorAll(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
      );
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    function onKeydown(event) {
      if (!visible) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }
      if (event.key === 'Tab') trapFocus(event);
    }

    function show() {
      if (visible) return;

      visible = true;
      preloadHero();

      popup.hidden = false;
      popup.classList.add('flash-popup--enter');
      void popup.offsetWidth;
      requestAnimationFrame(() => {
        popup.classList.add('flash-popup--in');
        popup.classList.remove('flash-popup--enter');
      });

      lockBody();
      document.addEventListener('keydown', onKeydown);

      lastFocused = document.activeElement;
      if (closeBtn) closeBtn.focus({ preventScroll: true });
    }

    function close() {
      if (!visible) return;
      visible = false;
      document.removeEventListener('keydown', onKeydown);
      unlockBody();

      try {
        sessionStorage.setItem(DISMISS_KEY, '1');
      } catch (error) {
        /* ignore */
      }

      popup.classList.remove('flash-popup--in');
      popup.classList.add('flash-popup--leave');
      clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        popup.hidden = true;
        popup.classList.remove('flash-popup--leave');
      }, 300);

      const last = lastFocused;
      lastFocused = null;
      if (last && typeof last.focus === 'function' && document.contains(last)) {
        try {
          last.focus({ preventScroll: true });
        } catch (error) {
          /* ignore */
        }
      }
    }

    function reveal() {
      if (!canShow()) return;
      revealTimer = window.setTimeout(show, SHOW_DELAY_MS);
    }

    popup.addEventListener('click', (event) => {
      if (event.target === popup) close();
    });

    popup.querySelectorAll('[data-flash-close]').forEach((node) => {
      node.addEventListener('click', () => close());
    });

    if (document.visibilityState === 'hidden') {
      const onVisible = () => {
        if (document.visibilityState !== 'visible') return;
        document.removeEventListener('visibilitychange', onVisible);
        reveal();
      };
      document.addEventListener('visibilitychange', onVisible);
    } else {
      reveal();
    }

    window.addEventListener('pagehide', () => {
      clearTimeout(revealTimer);
      clearTimeout(closeTimer);
    }, { once: true });
  })();
</script>

<style scoped>
  .flash-popup {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(3, 8, 18, 0.74);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 1;
    transition: opacity 0.28s ease;
  }
  .flash-popup[hidden] {
    display: none;
  }
  .flash-popup--enter {
    opacity: 0;
  }
  .flash-popup--leave {
    opacity: 0;
  }

  .flash-popup__modal {
    position: relative;
    width: 100%;
    /* Lebar kartu mengikuti tinggi layar supaya gambar selalu selebar kartu
       (tidak ada celah di kiri/kanan) dan isinya tetap muat tanpa scroll. */
    max-width: min(560px, calc((100vh - 240px) * 1.4145));
    max-width: min(560px, calc((100dvh - 240px) * 1.4145));
    max-height: calc(100vh - 32px);
    max-height: calc(100dvh - 32px);
    overflow: hidden auto;
    border-radius: 24px;
    border: 1px solid rgba(247, 207, 107, 0.32);
    background: #050d19;
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    isolation: isolate;
  }
  .flash-popup--enter .flash-popup__modal {
    transform: translateY(18px) scale(0.96);
  }
  .flash-popup--in .flash-popup__modal {
    transition: transform 0.34s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .flash-popup--leave .flash-popup__modal {
    transition: none;
  }

  .flash-popup__hero {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: #0b1a2e;
  }

  .flash-popup__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 848;
  }

  .flash-popup__fireworks {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .flash-popup__fw {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    color: #ffd67a;
    background: currentColor;
    opacity: 0;
    transform: scale(0.1);
    animation: flash-fw 6s ease-out infinite;
    will-change: transform, opacity;
    /* Satu titik + 12 bayangan = satu ledakan kembang api. */
    box-shadow:
      0 -30px 0 currentColor,
      15px -26px 0 currentColor,
      26px -15px 0 currentColor,
      30px 0 0 currentColor,
      26px 15px 0 currentColor,
      15px 26px 0 currentColor,
      0 30px 0 currentColor,
      -15px 26px 0 currentColor,
      -26px 15px 0 currentColor,
      -30px 0 0 currentColor,
      -26px -15px 0 currentColor,
      -15px -26px 0 currentColor;
  }

  .flash-popup__fw--1 {
    top: 16%;
    left: 10%;
    color: #ffd67a;
    animation-delay: -0.6s;
  }

  .flash-popup__fw--2 {
    top: 26%;
    left: 78%;
    color: #eaf4ff;
    animation-delay: -2.7s;
  }

  .flash-popup__fw--3 {
    top: 62%;
    left: 14%;
    color: #9be6d6;
    animation-delay: -4.3s;
  }

  .flash-popup__fw--4 {
    top: 70%;
    left: 82%;
    color: #ffd67a;
    animation-delay: -1.5s;
  }

  @keyframes flash-fw {
    0% {
      opacity: 0;
      transform: scale(0.1);
    }
    8% {
      opacity: 0;
      transform: scale(0.25);
    }
    14% {
      opacity: 1;
    }
    38% {
      opacity: 0.9;
      transform: scale(1);
    }
    60% {
      opacity: 0;
      transform: scale(1.2);
    }
    100% {
      opacity: 0;
      transform: scale(1.2);
    }
  }

  .flash-popup__panel {
    position: relative;
    z-index: 2;
    padding: 14px 26px 24px;
    text-align: center;
    background:
      radial-gradient(90% 130% at 50% 0%, rgba(56, 130, 190, 0.16) 0%, transparent 62%),
      linear-gradient(180deg, #08111f 0%, #050d19 100%);
  }

  .flash-popup__close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(6, 14, 26, 0.58);
    color: #dbe8f5;
    cursor: pointer;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .flash-popup__close:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    transform: rotate(90deg);
  }
  .flash-popup__close:focus-visible {
    outline: 3px solid rgba(247, 207, 107, 0.62);
    outline-offset: 2px;
  }

  .flash-popup__kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: #f7cf6b;
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }
  .flash-popup__dot {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #f7cf6b;
    box-shadow: 0 0 0 0 rgba(247, 207, 107, 0.6);
    animation: flash-pulse 1.8s ease-out infinite;
  }
  @keyframes flash-pulse {
    0% { box-shadow: 0 0 0 0 rgba(247, 207, 107, 0.6); }
    70% { box-shadow: 0 0 0 9px rgba(247, 207, 107, 0); }
    100% { box-shadow: 0 0 0 0 rgba(247, 207, 107, 0); }
  }

  .flash-popup__headline {
    margin: 10px 0 0;
    color: #fff6d8;
    font-family: var(--font-display);
    font-size: 1.16rem;
    font-weight: 600;
    line-height: 1.32;
    text-wrap: balance;
  }

  .flash-popup__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 18px;
  }
  .flash-popup__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 11px 22px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.06);
    color: #e6f1fb;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }
  .flash-popup__btn:hover {
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.13);
  }
  .flash-popup__btn--primary {
    border-color: transparent;
    background: linear-gradient(135deg, #ffe7a3 0%, #f7cf6b 45%, #d39a35 100%);
    color: #201403;
    box-shadow: 0 12px 26px rgba(247, 207, 107, 0.22);
  }
  .flash-popup__btn--primary:hover {
    background: linear-gradient(135deg, #fff0bd 0%, #ffd97a 45%, #e0a93f 100%);
    box-shadow: 0 16px 32px rgba(247, 207, 107, 0.3);
  }
  .flash-popup__btn:focus-visible {
    outline: 3px solid rgba(247, 207, 107, 0.62);
    outline-offset: 2px;
  }

  @media (max-width: 430px) {
    .flash-popup {
      padding: 12px;
    }
    .flash-popup__modal {
      max-height: calc(100vh - 24px);
      max-height: calc(100dvh - 24px);
      border-radius: 20px;
    }
    .flash-popup__panel {
      padding: 14px 16px 22px;
    }
    .flash-popup__headline {
      font-size: 1.02rem;
    }
    .flash-popup__actions {
      flex-direction: column;
    }
    .flash-popup__btn {
      width: 100%;
    }
  }

  @media (max-height: 700px) {
    .flash-popup__panel {
      padding: 12px 20px 18px;
    }
    .flash-popup__headline {
      margin-top: 8px;
      font-size: 1rem;
    }
    .flash-popup__actions {
      margin-top: 12px;
    }
  }

  /* Layar sangat pendek (mis. ponsel landscape): kartu lebih ramping lagi,
     dan bila masih kurang, gambar dipotong sedikit agar tetap selebar kartu. */
  @media (max-height: 560px) {
    .flash-popup__modal {
      max-width: min(560px, calc((100vh - 300px) * 1.4145));
      max-width: min(560px, calc((100dvh - 300px) * 1.4145));
    }
  }

  @media (max-height: 480px) {
    .flash-popup__hero {
      height: 120px;
    }
    .flash-popup__img {
      height: 100%;
      object-fit: cover;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flash-popup__fw,
    .flash-popup__dot {
      animation: none;
    }
    .flash-popup__fw {
      opacity: 0.75;
      transform: scale(0.9);
    }
    .flash-popup,
    .flash-popup--in .flash-popup__modal,
    .flash-popup__close,
    .flash-popup__btn {
      transition: none;
    }
    .flash-popup__close:hover,
    .flash-popup__btn:hover {
      transform: none;
    }
  }
</style>
