        if (x + w > wheel.x - wheel.R - 8 * U && x < wheel.x + wheel.R + 8 * U) h *= .3;   // sisakan ruang untuk bianglala
        bd = { x: x, w: w, h: h, y: baseY - h }; b.push(bd);
