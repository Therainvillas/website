---
// Popup promo Paket 2 Malam Tahun Baru 2027.
//
// Versi baru (tema malam tahun baru): latar navy + bintang, bukit + rumah
// menyala, konfeti, angka 2027 Playfair, dan kembang api canvas.
// Tanpa hitung mundur. Markup, gaya, dan script vanilla (tanpa library).
import { getGeneralImageSeo } from '../utils/imageSeo';

const flashSaleImageSeo = getGeneralImageSeo('flash-sale');
---

<div
  class="ny-pop"
  id="nyPromo"
  role="dialog"
  aria-modal="true"
  aria-labelledby="nyTitle"
  aria-describedby="nyOffer"
  hidden
>
  <div class="ny-confetti" id="nyConfetti" aria-hidden="true"></div>

  <svg class="ny-hills" viewBox="0 0 1440 200" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <path
      d="M0 120C120 70 240 90 360 110C500 135 600 60 760 70C920 80 1040 130 1180 100C1300 75 1380 90 1440 105V200H0Z"
      fill="#0d1230"></path>
    <path d="M0 150C200 118 360 150 520 150H1120C1240 150 1340 125 1440 140V200H0Z" fill="#060817"></path>
    <path d="M990 150V132H1050V150ZM984 132L1020 110L1056 132Z" fill="#060817"></path>
    <rect class="ny-light" x="1008" y="138" width="9" height="8" fill="#ffd479"></rect>
    <rect class="ny-light" x="1026" y="138" width="9" height="8" fill="#ffd479" style="animation-delay:-1.3s"></rect>
  </svg>

  <div class="ny-card" id="nyCard" tabindex="-1">
    <button class="ny-x" id="nyClose" type="button" aria-label="Tutup promo">
      <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M2 2l10 10M12 2L2 12"></path>
      </svg>
    </button>

    <div class="ny-scroll">
      <!-- Gambar promo tampil utuh (tidak dipotong). Sembunyikan otomatis bila gagal dimuat. -->
      <figure class="ny-figure" id="nyFigure">
        <img
          class="ny-img"
          id="nyImg"
          alt={flashSaleImageSeo.alt}
          title={flashSaleImageSeo.title}
          width="1200"
          height="848"
          decoding="async"
        />
      </figure>

      <div class="ny-body">
        <!-- EDIT teks promo di sini -->
        <p class="ny-kicker">Paket 2 Malam · Tahun Baru 2027</p>
        <div class="ny-year" role="img" aria-label="2027">
          <span style="--i:0">2</span><span style="--i:1">0</span><span style="--i:2">2</span><span style="--i:3">7</span>
        </div>

        <h2 class="ny-title" id="nyTitle">Malam Tahun Baru di Puncak</h2>
        <p class="ny-offer" id="nyOffer">
          <b>Paket 2 malam</b> lebih murah dibanding menginap 1 malam untuk Tahun Baru.
        </p>

        <a
          class="ny-cta"
          id="nyCta"
          href="https://wa.me/6282125492037?text=Halo%20The%20Rain%20Villas%2C%20saya%20ingin%20tanya%20promo%20paket%202%20malam%20Tahun%20Baru%202027."
          target="_blank"
          rel="noopener"
        >
          Tanya Paket 2 Malam
        </a>
        <button class="ny-later" id="nyLater" type="button">Nanti saja</button>
        <p class="ny-note">Kuota terbatas · menginap 30–31 Desember 2026</p>
      </div>
    </div>
  </div>

  <canvas class="ny-fx" id="nyFx" aria-hidden="true"></canvas>
</div>

<script>
  (() => {
    const root = document.getElementById('nyPromo');
    if (!root) return;

    /* === Pengaturan (EDIT DI SINI) === */
    const CONFIG = {
      image: '/promo/promo-2-malam-1200.webp', // '' = sembunyikan slot gambar
      imageSmall: '/promo/promo-2-malam-800.webp',
      imageMaxWidthPx: 440,
      hideAfter: '2026-12-30T00:00:00+07:00', // setelah paket mulai, popup berhenti muncul
      delayMs: 1200, // jeda sebelum popup muncul
      respectReducedMotion: false, // true = matikan kembang api/konfeti saat OS reduce-motion
    };

    const card = document.getElementById('nyCard');
    const xBtn = document.getElementById('nyClose');
    const cta = document.getElementById('nyCta');
    const later = document.getElementById('nyLater');
    const figure = document.getElementById('nyFigure');
    const img = document.getElementById('nyImg');
    const cv = document.getElementById('nyFx');
    const ctx = cv ? cv.getContext('2d') : null;

    const mqReduce = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;
    const forceFx = /[?&](fx|fireworks)\b/.test(location.search);
    let reduce = !!(mqReduce && mqReduce.matches) && CONFIG.respectReducedMotion && !forceFx;
    const debug = /[?&]debug\b/.test(location.search);
    root.classList.toggle('ny-anim-on', !reduce);

    const DISMISS_KEY = 'trv_promo_ny2027_dismissed';

    const rnd = (a, b) => a + Math.random() * (b - a);
    const pick = (a) => a[Math.floor(Math.random() * a.length)];

    /* ---------- Gambar promo ---------- */
    function imageSources() {
      if (!CONFIG.image) return null;
      return {
        src: CONFIG.image,
        srcset: CONFIG.imageSmall
          ? `${CONFIG.imageSmall} 800w, ${CONFIG.image} 1200w`
          : undefined,
      };
    }

    function preloadImage() {
      const src = imageSources();
      if (!src) return;
      const im = new Image();
      if (src.srcset) {
        im.srcset = src.srcset;
        im.sizes = `(max-width: 560px) 92vw, ${CONFIG.imageMaxWidthPx}px`;
      }
      im.src = src.src;
    }

    function applyImage() {
      const src = imageSources();
      if (!src) {
        figure.hidden = true;
        return;
      }
      if (src.srcset) {
        img.srcset = src.srcset;
        img.sizes = `(max-width: 560px) 92vw, ${CONFIG.imageMaxWidthPx}px`;
      }
      img.src = src.src;
      img.addEventListener('error', () => {
        figure.hidden = true;
      });
    }

    /* ---------- Kembang api ---------- */
    let W = 0;
    let H = 0;
    let S = 1;
    let parts = [];
    let rockets = [];
    let raf = 0;
    let last = 0;
    let next = 0;
    let running = false;
    let frames = 0;
    let drawn = 0;
    let ticker = 0;
    let debugEl = null;

    const PAL = [
      ['#ffd479', '#ffb347'],
      ['#ff6f91', '#ffb0c2'],
      ['#7fe7ff', '#4fb8ff'],
      ['#fff6e0', '#f3dca4'],
      ['#9dffb0', '#4fe39a'],
      ['#c9a6ff', '#8f7bff'],
    ];

    function badge() {
      if (!debug || debugEl || !ctx) return;
      debugEl = document.createElement('div');
      debugEl.style.cssText =
        'position:fixed;left:8px;bottom:8px;z-index:100000;font:11px/1.5 monospace;color:#fff;' +
        'background:rgba(0,0,0,.75);padding:6px 8px;border-radius:8px;max-width:74vw;white-space:pre;pointer-events:none';
      document.body.appendChild(debugEl);
      setInterval(() => {
        debugEl.textContent = [
          `reduce=${reduce ? 1 : 0}  animon=${root.classList.contains('ny-anim-on') ? 1 : 0}  instant=${
            root.classList.contains('ny-instant') ? 1 : 0
          }`,
          `open=${!root.hidden && root.classList.contains('is-open') ? 1 : 0}  canvas=${W}x${H}  rafFrames=${frames}  draws=${drawn}`,
          `parts=${parts.length}  rockets=${rockets.length}  reduceCSS=${mqReduce && mqReduce.matches ? 1 : 0}`,
        ].join('\n');
      }, 250);
    }

    function size() {
      if (!ctx) return;
      const d = Math.min(window.devicePixelRatio || 1, 2);
      W = cv.clientWidth || window.innerWidth || 0;
      H = cv.clientHeight || window.innerHeight || 0;
      cv.width = Math.max(1, W * d);
      cv.height = Math.max(1, H * d);
      ctx.setTransform(d, 0, 0, d, 0, 0);
      S = Math.max(0.55, Math.min(1.3, Math.min(W, H) / 720));
    }

    function launch(tx, ty, wait, type, dur) {
      const x1 = tx == null ? rnd(W * 0.1, W * 0.9) : tx;
      const y1 = ty == null ? rnd(H * 0.1, H * 0.45) : ty;
      const x0 = tx == null ? x1 + rnd(-70, 70) : W / 2 + (tx - W / 2) * 0.6;
      rockets.push({
        x0,
        y0: H - 30,
        x1,
        y1,
        p: 0,
        dur: dur || rnd(0.8, 1.15),
        wait: wait || 0,
        type,
        pal: pick(PAL),
        px: x0,
        py: H - 30,
      });
    }

    function spark(x, y) {
      parts.push({
        x,
        y,
        px: x,
        py: y,
        vx: rnd(-0.6, 0.6),
        vy: rnd(0.2, 1.2),
        life: 1,
        decay: rnd(0.05, 0.09),
        size: 1.2,
        c: '#ffd9a0',
        g: 0.04,
        f: 0.96,
      });
    }

    function burst(x, y, pal, type) {
      type = type || pick(['sphere', 'sphere', 'crackle', 'ring', 'willow', 'heart', 'double']);
      const k = S < 0.8 ? 0.7 : 1;
      const P = 6.4 * S;
      let n;
      let i;
      let a;
      let v;
      const add = (vx, vy, c, o) => {
        o = o || {};
        parts.push({
          x,
          y,
          px: x,
          py: y,
          vx,
          vy,
          life: 1,
          decay: o.decay || rnd(0.011, 0.019),
          size: o.size || rnd(1.4, 2.4),
          c,
          g: o.g == null ? 0.05 : o.g,
          f: o.f || 0.965,
          tw: o.tw,
          cr: o.cr,
        });
      };

      if (type === 'ring') {
        n = Math.round(70 * k);
        const tilt = rnd(0.35, 1);
        for (i = 0; i < n; i++) {
          a = (i / n) * 6.283;
          add(Math.cos(a) * P * 0.95, Math.sin(a) * P * 0.95 * tilt, pal[0]);
        }
      } else if (type === 'heart') {
        n = Math.round(90 * k);
        for (i = 0; i < n; i++) {
          a = (i / n) * 6.283;
          const s = Math.sin(a);
          add(
            (16 * s * s * s * P) / 17,
            -(
              (13 * Math.cos(a) - 5 * Math.cos(2 * a) - 2 * Math.cos(3 * a) - Math.cos(4 * a)) *
              (P / 17)
            ),
            '#ff6f91',
            { decay: 0.012, g: 0.02 },
          );
        }
      } else if (type === 'willow') {
        n = Math.round(90 * k);
        for (i = 0; i < n; i++) {
          a = rnd(0, 6.283);
          v = rnd(0.3, 1) * P * 0.85;
          add(Math.cos(a) * v, Math.sin(a) * v, '#ffd479', {
            decay: rnd(0.005, 0.009),
            g: 0.035,
            f: 0.975,
            tw: true,
          });
        }
      } else if (type === 'double') {
        n = Math.round(100 * k);
        for (i = 0; i < n; i++) {
          a = rnd(0, 6.283);
          v = P * Math.sqrt(Math.random());
          add(Math.cos(a) * v, Math.sin(a) * v, pal[0]);
        }
        n = Math.round(60 * k);
        for (i = 0; i < n; i++) {
          a = rnd(0, 6.283);
          v = P * 0.5 * Math.sqrt(Math.random());
          add(Math.cos(a) * v, Math.sin(a) * v, pal[1]);
        }
      } else {
        n = Math.round(120 * k);
        for (i = 0; i < n; i++) {
          a = rnd(0, 6.283);
          v = P * Math.sqrt(Math.random());
          add(Math.cos(a) * v, Math.sin(a) * v, Math.random() < 0.5 ? pal[0] : pal[1], {
            cr: type === 'crackle' && Math.random() < 0.3,
          });
        }
      }
    }

    function stepRocket(r, dt) {
      if (r.wait > 0) {
        r.wait -= dt;
        return true;
      }
      r.p += dt / r.dur;
      const e = 1 - Math.pow(1 - Math.min(r.p, 1), 2.2);
      const x = r.x0 + (r.x1 - r.x0) * e;
      const y = r.y0 + (r.y1 - r.y0) * e;
      ctx.strokeStyle = 'rgba(255,243,207,.9)';
      ctx.lineWidth = 2.2;
      ctx.beginPath();
      ctx.moveTo(r.px, r.py);
      ctx.lineTo(x, y);
      ctx.stroke();
      spark(x, y);
      r.px = x;
      r.py = y;
      if (r.p >= 1) {
        burst(x, y, r.pal, r.type);
        return false;
      }
      return true;
    }

    function draw(t) {
      if (!running || !ctx) return;
      const now = t == null ? performance.now() : t;
      const dt = Math.min((now - last) / 1000 || 0.016, 0.1);
      const f = dt * 60;
      let i;
      let j;
      let p;
      last = now;
      drawn++;

      // Jejak memudar berbasis waktu (bukan per frame) supaya tampilan tetap
      // sama saat frame rate turun / digambar lewat timer.
      ctx.globalCompositeOperation = 'destination-out';
      ctx.fillStyle = `rgba(0,0,0,${(1 - Math.pow(0.78, f)).toFixed(3)})`;
      ctx.fillRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'lighter';
      ctx.lineCap = 'round';

      next -= dt;
      if (next <= 0) {
        launch();
        if (Math.random() < 0.35) launch(null, null, 0.18);
        if (Math.random() < 0.12) launch(null, null, 0.34);
        next = rnd(0.3, 0.8);
      }
      for (i = rockets.length - 1; i >= 0; i--) if (!stepRocket(rockets[i], dt)) rockets.splice(i, 1);

      for (i = parts.length - 1; i >= 0; i--) {
        p = parts[i];
        p.px = p.x;
        p.py = p.y;
        p.vx *= Math.pow(p.f, f);
        p.vy *= Math.pow(p.f, f);
        p.vy += p.g * f;
        p.x += p.vx * f;
        p.y += p.vy * f;
        p.life -= p.decay * f;
        if (p.life <= 0) {
          if (p.cr && parts.length < 2400) {
            for (j = 0; j < 4; j++) {
              parts.push({
                x: p.x,
                y: p.y,
                px: p.x,
                py: p.y,
                vx: rnd(-1.6, 1.6),
                vy: rnd(-1.6, 1.6),
                life: 1,
                decay: 0.09,
                size: 1.2,
                c: '#ffffff',
                g: 0.03,
                f: 0.95,
              });
            }
          }
          parts.splice(i, 1);
          continue;
        }
        if (p.tw && Math.random() < 0.25) continue; // kelap-kelip
        ctx.globalAlpha = Math.min(1, p.life * 1.4);
        ctx.strokeStyle = p.c;
        ctx.lineWidth = p.size * (0.5 + 0.5 * p.life);
        ctx.beginPath();
        ctx.moveTo(p.px, p.py);
        ctx.lineTo(p.x, p.y);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
    }

    function loop(t) {
      if (!running) return;
      frames++;
      draw(t);
      raf = requestAnimationFrame(loop);
    }

    function onVis() {
      if (!running) return;
      if (document.hidden) {
        cancelAnimationFrame(raf);
        raf = 0;
      } else {
        last = performance.now();
        raf = requestAnimationFrame(loop);
      }
    }

    function startFx() {
      if (!ctx) return;
      size();
      parts = [];
      rockets = [];
      running = true;
      frames = 0;
      drawn = 0;
      last = performance.now();
      next = 2;

      // Rentetan pembuka: ledakan pertama < 1 detik.
      const xs = [0.15, 0.85, 0.3, 0.7, 0.5, 0.08, 0.92];
      for (let i = 0; i < xs.length; i++) {
        launch(W * xs[i], H * rnd(0.14, 0.38), 0.05 + i * 0.13, i === 6 ? 'double' : null, 0.62 + Math.random() * 0.18);
      }
      // Ledakan instan supaya kembang api langsung terlihat tanpa menunggu roket.
      burst(W * 0.5, H * 0.24, PAL[0], 'sphere');
      burst(W * 0.2, H * 0.3, PAL[3], 'ring');
      burst(W * 0.8, H * 0.3, PAL[1], 'sphere');
      draw(performance.now());

      document.addEventListener('visibilitychange', onVis);
      raf = requestAnimationFrame(loop);

      // Pengaman: bila requestAnimationFrame tidak berjalan (tab/preview beku),
      // gambar tetap dilanjutkan lewat timer.
      if (!ticker) {
        ticker = window.setInterval(() => {
          if (!running) return;
          if (performance.now() - last > 100) draw(performance.now());
        }, 100);
      }
    }

    function stopFx() {
      running = false;
      cancelAnimationFrame(raf);
      raf = 0;
      clearInterval(ticker);
      ticker = 0;
      document.removeEventListener('visibilitychange', onVis);
      if (ctx) ctx.clearRect(0, 0, W, H);
    }

    /* ---------- Konfeti ---------- */
    function confetti() {
      const box = document.getElementById('nyConfetti');
      if (!box || box.children.length || reduce) return;
      const cols = ['#ffd479', '#ff6f91', '#7fe7ff', '#fff6e0', '#9dffb0', '#c9a6ff'];
      for (let i = 0; i < 38; i++) {
        const e = document.createElement('i');
        const s = e.style;
        s.left = `${rnd(0, 100)}%`;
        s.background = pick(cols);
        s.width = `${rnd(6, 10)}px`;
        s.height = `${rnd(10, 16)}px`;
        s.setProperty('--dx', `${rnd(-80, 80)}px`);
        s.animationDuration = `${rnd(5, 10)}s`;
        s.animationDelay = `${-rnd(0, 10)}s`;
        box.appendChild(e);
      }
    }

    /* ---------- Buka / tutup ---------- */
    let visible = false;
    let hideTimer = 0;
    let closing = false;
    let opener = null;
    let prevOverflow = '';
    let prevPadding = '';

    function ensureVisible() {
      if (!visible) return;
      const o = parseFloat(getComputedStyle(root).opacity) || 0;
      const c = parseFloat(getComputedStyle(card).opacity) || 0;
      // Bila transisi tidak berjalan (opacity masih 0), tampilkan tanpa animasi.
      if (o < 0.9 || c < 0.9) root.classList.add('ny-instant');
    }

    function lockBody() {
      prevOverflow = document.body.style.overflow;
      prevPadding = document.body.style.paddingRight;
      const gap = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.overflow = 'hidden';
      if (gap > 0) document.body.style.paddingRight = `${gap}px`;
    }

    function unlockBody() {
      document.body.style.overflow = prevOverflow || '';
      document.body.style.paddingRight = prevPadding || '';
    }

    function show() {
      if (visible) return;
      visible = true;
      closing = false;
      clearTimeout(hideTimer);
      hideTimer = 0;

      opener = document.activeElement;
      applyImage();
      root.hidden = false;
      root.classList.toggle('ny-anim-on', !reduce);
      lockBody();
      void root.offsetWidth;
      root.classList.add('is-open');
      badge();
      confetti();
      if (!reduce) startFx();
      if (!reduce && window.NYText) window.NYText.start(root, card);
      document.addEventListener('keydown', onKeydown);

      window.setTimeout(() => {
        if (card) card.focus({ preventScroll: true });
      }, 60);
      // Jaga-jaga bila animasi CSS macet.
      window.setTimeout(ensureVisible, 750);
      window.setTimeout(() => {
        ensureVisible();
        if (!reduce && !running) startFx();
        if (!reduce && window.NYText) window.NYText.start(root, card);
      }, 1700);
    }

    function close() {
      if (!visible || closing) return;
      closing = true;
      visible = false;
      clearTimeout(hideTimer);
      document.removeEventListener('keydown', onKeydown);
      try {
        sessionStorage.setItem(DISMISS_KEY, '1');
      } catch (error) {
        /* ignore */
      }

      root.classList.remove('is-open');
      hideTimer = window.setTimeout(() => {
        root.hidden = true;
        closing = false;
        stopFx();
        if (window.NYText) window.NYText.stop();
        unlockBody();
        const lastFocus = opener;
        opener = null;
        if (lastFocus && typeof lastFocus.focus === 'function' && document.contains(lastFocus)) {
          try {
            lastFocus.focus({ preventScroll: true });
          } catch (error) {
            /* ignore */
          }
        }
      }, 520);
    }

    function trapFocus(event) {
      const focusable = [xBtn, cta, later].filter(Boolean);
      if (!focusable.length) return;
      const i = focusable.indexOf(document.activeElement);
      const n = event.shiftKey ? i - 1 : i + 1;
      if (i === -1 || n < 0 || n >= focusable.length) {
        focusable[n < 0 ? focusable.length - 1 : 0].focus();
        event.preventDefault();
      }
    }

    function onKeydown(event) {
      if (!visible) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }
      if (event.key === 'Tab') trapFocus(event);
    }

    xBtn.addEventListener('click', close);
    later.addEventListener('click', close);
    cta.addEventListener('click', () => {
      try {
        sessionStorage.setItem(DISMISS_KEY, '1');
      } catch (error) {
        /* ignore */
      }
    });

    // Klik latar = kembang api di titik itu (fokus tetap di dalam dialog).
    root.addEventListener('click', (event) => {
      if (card.contains(event.target)) return;
      if (!reduce && ctx) {
        if (!running) startFx();
        launch(event.clientX, event.clientY);
      }
      window.setTimeout(() => {
        if (card && !card.contains(document.activeElement)) card.focus({ preventScroll: true });
      }, 0);
    });

    window.addEventListener('resize', () => {
      if (running) size();
    });

    if (mqReduce && mqReduce.addEventListener) {
      mqReduce.addEventListener('change', (event) => {
        reduce = event.matches && CONFIG.respectReducedMotion && !forceFx;
        root.classList.toggle('ny-anim-on', !reduce);
        if (!visible) return;
        if (reduce) {
          stopFx();
          if (window.NYText) window.NYText.stop();
        } else {
          if (!running) startFx();
          if (window.NYText) window.NYText.start(root, card);
        }
        confetti();
      });
    }

    window.addEventListener(
      'pagehide',
      () => {
        clearTimeout(hideTimer);
        if (running) stopFx();
        if (window.NYText) window.NYText.stop();
      },
      { once: true },
    );

    /* ---------- Muncul otomatis ---------- */
    function isReload() {
      try {
        const [nav] = performance.getEntriesByType('navigation');
        if (nav && nav.type) return nav.type === 'reload';
        return Boolean(performance.navigation) && performance.navigation.type === 1;
      } catch (error) {
        return false;
      }
    }

    function canShow() {
      if (/^\/admin(\/|$)/.test(location.pathname)) return false;
      if (/[?&]promo\b/.test(location.search)) return true; // ?promo untuk menguji
      if (Date.now() >= Date.parse(CONFIG.hideAfter)) return false;
      if (isReload()) return true; // refresh selalu menampilkan lagi
      try {
        if (sessionStorage.getItem(DISMISS_KEY) === '1') return false;
      } catch (error) {
        /* ignore */
      }
      return true;
    }

    function schedule() {
      if (!canShow()) return;
      preloadImage();
      window.setTimeout(show, CONFIG.delayMs);
    }

    if (document.visibilityState === 'hidden') {
      const onVisible = () => {
        if (document.visibilityState !== 'visible') return;
        document.removeEventListener('visibilitychange', onVisible);
        schedule();
      };
      document.addEventListener('visibilitychange', onVisible);
    } else if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', schedule);
    } else {
      schedule();
    }

    // Pintu darurat untuk uji manual dari console: __nyPromo.open()
    window.__nyPromo = { open: show, close };
  })();

  /* =====================================================================
     Kembang api berbentuk tulisan "therainvillas" + nama-nama villa.
     Canvas terpisah di atas popup, jadi kode kembang api utama tidak diubah.
     Font memakai font situs (Inter/Work Sans) yang sudah di-host sendiri.
     ===================================================================== */
  (() => {
    const OPT = {
      brand: 'therainvillas', // tulisan utama (besar, di atas kartu)
      names: [
        'Agave', 'Arisyfa', 'Awan', 'Aleia', 'Arsy', 'Albi',
        'Bodas', 'Baduo', 'Calmora', 'Cempaka', 'Cemara', 'Cyrena',
        'De Summit', 'Halla', 'Echa', 'Valora',
        'Wanela', 'Rjs Cottage', 'Rjs 2', 'Rjs 3', 'The Helina',
        'Ranna', 'Rayya', 'Twins', 'Thymi', 'Opung', 'Elora',
        '4D', 'Rio', 'Kaca 1', 'Kaca 2',
      ],
      nameChance: 0.4, // peluang tiap peluncuran menjadi nama villa (0-1)
      maxNames: 3, // maksimal nama villa yang tampil bersamaan
      brandEvery: 16, // tulisan utama muncul lagi tiap X detik
      font: '600 120px "Inter Variable","Inter","Work Sans Variable","Segoe UI",Arial,sans-serif',
    };

    const PAL = [
      ['#ffd479', '#ffb347'],
      ['#ff6f91', '#ffb0c2'],
      ['#7fe7ff', '#4fb8ff'],
      ['#fff6e0', '#f3dca4'],
      ['#9dffb0', '#4fe39a'],
      ['#c9a6ff', '#8f7bff'],
    ];
    const T1 = 1;
    const HOLD = 1.9;
    const FALL = 1; // detik: huruf mengembang / bertahan / jatuh

    let root;
    let card;
    let cv;
    let ctx;
    let W = 0;
    let H = 0;
    let S = 1;
    let parts = [];
    let rockets = [];
    let live = [];
    let cache = {};
    let bag = [];
    let raf = 0;
    let last = 0;
    let clock = 0;
    let next = 0;
    let brandWait = 0;
    let running = false;

    const rnd = (a, b) => a + Math.random() * (b - a);
    const pick = (a) => a[Math.floor(Math.random() * a.length)];

    function size() {
      const d = Math.min(window.devicePixelRatio || 1, 2);
      W = cv.clientWidth || window.innerWidth;
      H = cv.clientHeight || window.innerHeight;
      cv.width = W * d;
      cv.height = H * d;
      ctx.setTransform(d, 0, 0, d, 0, 0);
      S = Math.max(0.55, Math.min(1.3, Math.min(W, H) / 720));
    }

    /* posisi kartu terhadap overlay (tidak terpengaruh animasi masuk kartu) */
    function box() {
      if (card.offsetParent === root) {
        return {
          l: card.offsetLeft,
          t: card.offsetTop,
          r: card.offsetLeft + card.offsetWidth,
          b: card.offsetTop + card.offsetHeight,
        };
      }
      const a = root.getBoundingClientRect();
      const c = card.getBoundingClientRect();
      return { l: c.left - a.left, t: c.top - a.top, r: c.right - a.left, b: c.bottom - a.top };
    }

    /* ---------- Tulisan menjadi titik-titik ---------- */
    function textGet(str) {
      if (cache[str]) return cache[str];
      const c = document.createElement('canvas');
      const g = c.getContext('2d');
      const pts = [];
      g.font = OPT.font;
      const w = Math.ceil(g.measureText(str).width) + 24;
      const h = 180;
      c.width = w;
      c.height = h;
      g.font = OPT.font;
      g.textBaseline = 'middle';
      g.fillStyle = '#fff';
      g.fillText(str, 12, h / 2);
      const d = g.getImageData(0, 0, w, h).data;
      let x0 = 1e9;
      let x1 = -1e9;
      let y0 = 1e9;
      let y1 = -1e9;
      for (let y = 0; y < h; y += 6) {
        for (let x = 0; x < w; x += 6) {
          if (d[(y * w + x) * 4 + 3] > 128) {
            pts.push([x, y]);
            if (x < x0) x0 = x;
            if (x > x1) x1 = x;
            if (y < y0) y0 = y;
            if (y > y1) y1 = y;
          }
        }
      }
      const cx = (x0 + x1) / 2;
      const cy = (y0 + y1) / 2;
      for (let i = 0; i < pts.length; i++) {
        pts[i][0] -= cx;
        pts[i][1] -= cy;
      }
      return (cache[str] = { pts, w: x1 - x0 + 6, h: y1 - y0 + 6 });
    }

    /* tulisan utama besar, nama villa kecil */
    function textScale(T, small) {
      const cap = small ? Math.max(0.28, Math.min(0.3, W / 1300)) : Math.max(0.45, Math.min(0.7, W / 1000));
      return Math.min(cap, (W * (small ? 0.45 : 0.86)) / T.w);
    }

    function nextName() {
      if (!bag.length) {
        bag = OPT.names.slice();
        for (let i = bag.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          const t = bag[i];
          bag[i] = bag[j];
          bag[j] = t;
        }
      }
      return bag.pop();
    }

    /* ---------- Tempat acak untuk nama villa ---------- */
    const hit = (a, b) => a.l < b.r && a.r > b.l && a.t < b.b && a.b > b.t;

    function place(T, sc) {
      const hw = (T.w * sc) / 2 + 8;
      const hh = (T.h * sc) / 2 + 8;
      let c = box();
      c = { l: c.l - 10, t: c.t - 10, r: c.r + 10, b: c.b + 10 };
      for (let n = 0; n < 50; n++) {
        // 30 percobaan pertama: di luar kartu; sisanya (layar HP): boleh di atas kartu
        const x = rnd(hw, Math.max(hw, W - hw));
        const y = rnd(hh, Math.max(hh, H * 0.88 - hh));
        const r = { l: x - hw, t: y - hh, r: x + hw, b: y + hh };
        let ok = n >= 30 || !hit(r, c);
        for (let j = 0; ok && j < live.length; j++) {
          if (live[j].until > clock && hit(r, live[j])) ok = false;
        }
        if (ok) return { x, y };
      }
      return null;
    }

    function reserve(x, y, T, sc, wait, isName) {
      const hw = (T.w * sc) / 2 + 8;
      const hh = (T.h * sc) / 2 + 8;
      live = live.filter((o) => o.until > clock);
      live.push({
        l: x - hw,
        t: y - hh,
        r: x + hw,
        b: y + hh,
        name: isName,
        until: clock + (wait || 0) + 1.2 + T1 + HOLD + FALL,
      });
    }
    const namesLive = () => live.filter((o) => o.name && o.until > clock).length;

    /* ---------- Roket & ledakan ---------- */
    function launchText(str, isBrand, wait) {
      const T = textGet(str);
      const sc = textScale(T, !isBrand);
      let pal;
      let x;
      let y;
      if (!T.pts.length) return;
      if (isBrand) {
        // besar, di tengah, tepat di atas kartu
        pal = PAL[0];
        const hh = (T.h * sc) / 2;
        x = W / 2;
        y = Math.max(hh + 12, Math.min(H * 0.3, box().t - hh - 14));
      } else {
        // kecil, tempat acak
        const pos = place(T, sc);
        if (!pos) return;
        x = pos.x;
        y = pos.y;
        pal = pick(PAL);
      }
      reserve(x, y, T, sc, wait, !isBrand);
      const x0 = W / 2 + (x - W / 2) * 0.6;
      rockets.push({
        x0,
        y0: H - 30,
        x1: x,
        y1: y,
        p: 0,
        dur: rnd(0.8, 1.15),
        wait: wait || 0,
        T,
        sc,
        pal,
        small: !isBrand,
        px: x0,
        py: H - 30,
      });
    }

    function spark(x, y) {
      parts.push({
        x,
        y,
        px: x,
        py: y,
        vx: rnd(-0.6, 0.6),
        vy: rnd(0.2, 1.2),
        life: 1,
        decay: rnd(0.05, 0.09),
        size: 1.2,
        c: '#ffd9a0',
        g: 0.04,
        f: 0.96,
      });
    }

    function explode(r, x, y) {
      const T = r.T;
      const sc = r.sc;
      const col = r.pal[0];
      const P = 6.4 * S * (r.small ? 0.4 : 1);
      const sp = 6 * sc;
      const sz = Math.max(1.4, Math.min(3.4, sp * 0.7));
      let i;
      let a;
      for (i = 0; i < T.pts.length; i++) {
        // titik-titik huruf terbang dari pusat ledakan
        const q = T.pts[i];
        parts.push({
          x,
          y,
          px: x,
          py: y,
          sx: x,
          sy: y,
          tx: x + q[0] * sc,
          ty: y + q[1] * sc,
          t: -Math.random() * 0.1,
          size: sz,
          c: Math.random() < 0.72 ? col : '#fff6e0',
          txt: 1,
          vy: 0,
        });
      }
      const n = r.small ? 50 : 70; // cincin kilat di pusat
      for (i = 0; i < n; i++) {
        a = (i / n) * 6.283;
        parts.push({
          x,
          y,
          px: x,
          py: y,
          vx: Math.cos(a) * P * 0.95,
          vy: Math.sin(a) * P * 0.95 * 0.6,
          life: 1,
          decay: rnd(0.011, 0.019),
          size: rnd(1.4, 2.2),
          c: col,
          g: 0.05,
          f: 0.965,
        });
      }
    }

    function stepRocket(r, dt) {
      if (r.wait > 0) {
        r.wait -= dt;
        return true;
      }
      r.p += dt / r.dur;
      const e = 1 - Math.pow(1 - Math.min(r.p, 1), 2.2);
      const x = r.x0 + (r.x1 - r.x0) * e;
      const y = r.y0 + (r.y1 - r.y0) * e;
      ctx.strokeStyle = 'rgba(255,243,207,.9)';
      ctx.lineWidth = 2.2;
      ctx.beginPath();
      ctx.moveTo(r.px, r.py);
      ctx.lineTo(x, y);
      ctx.stroke();
      spark(x, y);
      r.px = x;
      r.py = y;
      if (r.p >= 1) {
        explode(r, x, y);
        return false;
      }
      return true;
    }

    function spawn() {
      if (brandWait <= 0 && OPT.brand) {
        launchText(OPT.brand, true, 0);
        brandWait = OPT.brandEvery;
        return;
      }
      if (OPT.names.length && Math.random() < OPT.nameChance && namesLive() < OPT.maxNames) {
        launchText(nextName(), false, 0);
      }
    }

    function frame(t) {
      if (!running) return;
      const dt = Math.min((t - last) / 1000 || 0.016, 0.05);
      const f = dt * 60;
      last = t;
      clock += dt;
      brandWait -= dt;
      next -= dt;
      ctx.globalCompositeOperation = 'destination-out';
      ctx.fillStyle = 'rgba(0,0,0,.24)';
      ctx.fillRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'lighter';
      ctx.lineCap = 'round';

      if (next <= 0) {
        spawn();
        next = rnd(0.5, 0.9);
      }
      for (let i = rockets.length - 1; i >= 0; i--) {
        if (!stepRocket(rockets[i], dt)) rockets.splice(i, 1);
      }

      for (let i = parts.length - 1; i >= 0; i--) {
        const p = parts[i];
        if (p.txt) {
          // huruf: mengembang > diam berkelip > jatuh
          p.t += dt;
          if (p.t < 0) continue;
          let al = 0.95;
          p.px = p.x;
          p.py = p.y;
          if (p.t < T1) {
            const k = p.t / T1;
            const e = 1 - Math.pow(1 - k, 3);
            p.x = p.sx + (p.tx - p.sx) * e;
            p.y = p.sy + (p.ty - p.sy) * e;
          } else if (p.t < T1 + HOLD) {
            p.x = p.tx + rnd(-0.4, 0.4);
            p.y = p.ty + rnd(-0.4, 0.4);
            p.px = p.x;
            p.py = p.y;
            al = 0.8 + Math.random() * 0.2;
          } else {
            const fq = (p.t - T1 - HOLD) / FALL;
            if (fq >= 1) {
              parts.splice(i, 1);
              continue;
            }
            p.vy += 0.05 * f;
            p.y += p.vy * f;
            p.x += rnd(-0.3, 0.3);
            al = 1 - fq;
          }
          ctx.globalAlpha = al;
          ctx.strokeStyle = p.c;
          ctx.lineWidth = p.size;
          ctx.beginPath();
          ctx.moveTo(p.px, p.py);
          ctx.lineTo(p.x + 0.01, p.y);
          ctx.stroke();
          continue;
        }
        p.px = p.x;
        p.py = p.y;
        p.vx *= Math.pow(p.f, f);
        p.vy *= Math.pow(p.f, f);
        p.vy += p.g * f;
        p.x += p.vx * f;
        p.y += p.vy * f;
        p.life -= p.decay * f;
        if (p.life <= 0) {
          parts.splice(i, 1);
          continue;
        }
        ctx.globalAlpha = Math.min(1, p.life * 1.4);
        ctx.strokeStyle = p.c;
        ctx.lineWidth = p.size * (0.5 + 0.5 * p.life);
        ctx.beginPath();
        ctx.moveTo(p.px, p.py);
        ctx.lineTo(p.x, p.y);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(frame);
    }

    /* ---------- Dipanggil dari popup ---------- */
    const onResize = () => {
      if (running) size();
    };

    function start(rootEl, cardEl) {
      if (running || !rootEl || !cardEl) return;
      root = rootEl;
      card = cardEl;
      if (!cv) {
        cv = document.createElement('canvas');
        cv.setAttribute('aria-hidden', 'true');
        cv.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:5';
        ctx = cv.getContext('2d');
      }
      if (cv.parentNode !== root) root.appendChild(cv);
      size();
      parts = [];
      rockets = [];
      live = [];
      clock = 0;
      brandWait = 0;
      next = 1.6;
      running = true;
      last = performance.now();
      window.addEventListener('resize', onResize);
      launchText(OPT.brand, true, 1); // tulisan utama pertama, sesaat setelah popup terbuka
      brandWait = OPT.brandEvery;
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(raf);
      window.removeEventListener('resize', onResize);
      if (ctx) ctx.clearRect(0, 0, W, H);
      if (cv && cv.parentNode) cv.parentNode.removeChild(cv);
    }

    // Hitung ulang titik huruf setelah font situs termuat.
    if (document.fonts && document.fonts.load) {
      document.fonts.load(OPT.font).then(() => {
        cache = {};
      });
    }

    window.NYText = { start, stop };
  })();
</script>

