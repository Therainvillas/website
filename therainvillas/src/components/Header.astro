const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isLinkActive = (href: string) => {
  if (href.includes('#')) return false;
  const path = href.replace(/\/+$/, '') || '/';
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
};
---

<!-- Top Bar: Logo & Actions -->
<header class="header" id="main-header" data-header-theme="light">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="The Rain Villas beranda">
      <span class="header__logo-media">
        <img src="/logo-header.webp" alt="The Rain Villas" width="144" height="80" class="header__logo-img header__logo-img--dark" />
        <img
          src="/logo-header-light.webp"
          alt=""
          aria-hidden="true"
          width="144"
          height="80"
          class="header__logo-img header__logo-img--light"
        />
