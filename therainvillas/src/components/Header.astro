    <div class="header__actions">
      <!-- Referensi Switch Dark Mode Beranimasi -->
      <button class="theme" id="theme" type="button" role="switch" aria-checked="false" aria-label="Mode malam" title="Mode malam">
        <span class="sky"></span>
        <span class="stars"><i></i><i></i><i></i><i></i><i></i></span>
        <span class="clouds"><i></i><i></i></span>
        <span class="knob"><b></b><b></b><b></b></span>
      </button>

      <a href="https://wa.me/6282125492037?text=Halo%20Admin%20Therainvillas%2C%20Saya%20ingin%20bertanya%20villa%20dan%20ketersediaan%20villa.%20Terima%20kasih." target="_blank" rel="noopener nofollow" class="btn btn--whatsapp header__cta">
        Hubungi Kami
      </a>
    </div>
  </div>
</header>

<!-- Dock Navbar Bawah Sesuai Referensi -->
<header class="dock-header show" id="dockHeader">
  <nav class="shelf" id="shelf" aria-label="Navigasi utama">
    <ul>
      {navLinks.map((link) => (
        <>
          <li class={`item ${isLinkActive(link.href) ? 'active' : ''}`} data-id={link.id}>
            <a
              class="icon"
              href={link.href}
              aria-label={link.label}
              data-track={link.track}
              aria-current={isLinkActive(link.href) ? 'page' : undefined}
            >
              <span class="tile">
                <svg viewBox="0 0 24 24" set:html={link.icon} />
              </span>
              <span class="tip">{link.label}</span>
            </a>
          </li>
        </>
      ))}
    </ul>
  </nav>
</header>
<button class="handle" id="handle" type="button" aria-label="Tampilkan menu"></button>

<script is:inline>
  (() => {
    // 1. Observer logo kontras pada section gelap
    const header = document.getElementById('main-header');
    const darkSelectors = ['.journey-hero', '.evening', '.reviews-marquee', '.satisfaction'];
    function isDarkSection(el) {
      return darkSelectors.some((sel) => el.matches(sel));
    }

    const sections = document.querySelectorAll('section');
    if (header && sections.length) {
      const observer = new IntersectionObserver((entries) => {
        let maxRatio = 0;
        let theme = 'light';
        entries.forEach((entry) => {
          if (entry.intersectionRatio > maxRatio) {
            maxRatio = entry.intersectionRatio;
            theme = isDarkSection(entry.target) ? 'dark' : 'light';
          }
        });
        header.setAttribute('data-header-theme', theme);
      }, { threshold: [0, 0.18, 0.36, 0.54, 0.72, 0.9, 1] });

      sections.forEach((s) => observer.observe(s));
    }

    // 2. Mode gelap dengan transisi tirai hujan
    const root = document.documentElement;
    const themeBtn = document.getElementById('theme');
    const reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const reduceMotion = reduceQuery.matches;
    const TRANSITION_MS = 1900;
    let transitioning = false;
    let fadeTimer = 0;

    function dark() {
      const attr = root.getAttribute('data-theme');
      if (attr === 'dark') return true;
      if (attr === 'light') return false;
      return window.matchMedia('(prefers-color-scheme: dark)').matches;
    }

    function syncThemeControl() {
      if (!themeBtn) return;
      const isDark = dark();
      const label = isDark ? 'Mode siang' : 'Mode malam';
      themeBtn.setAttribute('aria-checked', String(isDark));
      themeBtn.setAttribute('aria-label', label);
      themeBtn.setAttribute('title', label);
    }

    function applyTheme(next) {
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('therainvillas_theme', next);
      } catch (e) {}
      syncThemeControl();
    }

    function fadeTheme(next) {
      root.classList.add('theme-colors');
      applyTheme(next);
      window.clearTimeout(fadeTimer);
      fadeTimer = window.setTimeout(() => root.classList.remove('theme-colors'), 380);
    }

    function rainTransition(next) {
      transitioning = true;
      if (themeBtn) themeBtn.setAttribute('aria-disabled', 'true');

      const canvas = document.createElement('canvas');
      canvas.className = 'theme-rain';
      canvas.setAttribute('aria-hidden', 'true');
      document.body.appendChild(canvas);

      const ctx = canvas.getContext('2d');
      const w = window.innerWidth;
      const h = window.innerHeight;
      const small = w <= 600;
      const dpr = Math.min(window.devicePixelRatio || 1, small ? 1.25 : 2);
      canvas.width = Math.max(1, Math.round(w * dpr));
      canvas.height = Math.max(1, Math.round(h * dpr));
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const curtain = next === 'dark' ? '8,17,27' : '198,212,222';
      const maxStreaks = small ? 220 : 420;
      const maxSplashes = 50;
      const half = TRANSITION_MS / 2;
      const streaks = [];
      const splashes = [];
      let spawn = 0;
      let swapped = false;
      let phase2Clock = 0;
      let phase2Pending = false;
      let raf = 0;
      let last = performance.now();
      const start = last;

      const ease = (t) =>
        t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

      function addStreak() {
        const speed = 1500 + Math.random() * 1100;
        const len = 16 + Math.random() * 30;
        streaks.push({
          x: Math.random() * (w * 1.4) - w * 0.2,
          y: -len - Math.random() * h * 0.25,
          len,
          vx: speed * 0.22,
          vy: speed,
          a: 0.25 + Math.random() * 0.5
        });
      }

      function frame(now) {
        const elapsed = now - start;
        const p = Math.min(1, elapsed / TRANSITION_MS);
        const dt = Math.min(0.05, Math.max(0.001, (now - last) / 1000));
        last = now;

        // Tema berganti sekali saja, tepat saat layar tertutup penuh.
        if (!swapped && elapsed >= half) {
          swapped = true;
          applyTheme(next);
          // Mulai jam fase buka pada frame berikutnya. Style recalc tema
          // bisa memakan waktu; tirai tetap menutup penuh selama itu dan
          // reveal baru berjalan setelah layar siap.
          phase2Pending = true;
        }

        ctx.clearRect(0, 0, w, h);

        const closing = !swapped;
        let local;
        if (closing) {
          local = Math.min(1, elapsed / half);
        } else if (phase2Pending) {
          local = 0;
        } else {
          if (!phase2Clock) phase2Clock = now;
          local = Math.min(1, (now - phase2Clock) / half);
        }
        // Fase tutup: garis depan turun dari atas. Fase buka: garis depan
        // kembali ke atas lalu turun, memperlihatkan tema baru dari atas.
        const front = closing
          ? -120 + ease(local) * (h + 240)
          : -160 + ease(local) * (h + 320);
        const time = elapsed / 1000;

        // Tirai 4 lapisan dengan tepi bergelombang.
        ctx.fillStyle = `rgba(${curtain}, 0.55)`;
        const offsets = closing ? [-90, -60, -30, 0] : [0, 30, 60, 90];
        for (let l = 0; l < offsets.length; l++) {
          const off = offsets[l];
          ctx.beginPath();
          for (let x = 0; x <= w + 16; x += 16) {
            const y =
              front +
              off +
              Math.sin(x * 0.012 + time * 9) * 13 +
              Math.sin(x * 0.031 - time * 6) * 6;
            if (x === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          if (closing) {
            ctx.lineTo(w + 16, -240);
            ctx.lineTo(0, -240);
          } else {
            ctx.lineTo(w + 16, h + 240);
            ctx.lineTo(0, h + 240);
          }
          ctx.closePath();
          ctx.fill();
        }

        // Hujan: intensitas naik-turun dengan puncak di tengah transisi.
        spawn +=
          (2 + 9 * Math.pow(Math.sin(Math.PI * p), 0.6)) * dt * 60;
        if (streaks.length >= maxStreaks) spawn = Math.min(spawn, 1);
        while (spawn >= 1 && streaks.length < maxStreaks) {
          addStreak();
          spawn -= 1;
        }
        if (spawn > 8) spawn = 8;

        ctx.strokeStyle = 'rgb(140, 178, 232)';
        ctx.lineWidth = 1.3;
        ctx.lineCap = 'round';
        for (let i = streaks.length - 1; i >= 0; i--) {
          const s = streaks[i];
          s.x += s.vx * dt;
          s.y += s.vy * dt;
          if (s.y - s.len > h || s.x - s.len * 0.22 > w + 40) {
            streaks.splice(i, 1);
            continue;
          }
          ctx.globalAlpha = s.a;
          ctx.beginPath();
          ctx.moveTo(s.x, s.y);
          ctx.lineTo(s.x - 0.22 * s.len, s.y - s.len);
          ctx.stroke();
        }

        // Percikan di sepanjang garis depan tirai.
        if (front > 0 && front < h) {
          for (let k = 0; k < 2; k++) {
            if (splashes.length < maxSplashes) {
              splashes.push({ x: Math.random() * w, y: front, born: now });
            }
          }
        }
        for (let i = splashes.length - 1; i >= 0; i--) {
          const s = splashes[i];
          const age = (now - s.born) / 420;
          if (age >= 1) {
            splashes.splice(i, 1);
            continue;
          }
          const radius = 3 + 17 * age;
          ctx.globalAlpha = 0.55 * (1 - age);
          ctx.beginPath();
          ctx.ellipse(s.x, s.y, radius, radius * 0.35, 0, 0, Math.PI * 2);
          ctx.stroke();
        }
        ctx.globalAlpha = 1;

        if (phase2Pending) phase2Pending = false;

        if ((swapped && local >= 1) || elapsed > 6000) {
          if (!swapped) applyTheme(next);
          cancelAnimationFrame(raf);
          canvas.remove();
          transitioning = false;
          if (themeBtn) themeBtn.removeAttribute('aria-disabled');
          syncThemeControl();
          return;
        }

        raf = requestAnimationFrame(frame);
      }

      raf = requestAnimationFrame(frame);
    }

    syncThemeControl();

    themeBtn?.addEventListener('click', () => {
      if (transitioning) return;
      const next = dark() ? 'light' : 'dark';
      if (reduceQuery.matches) {
        fadeTheme(next);
        return;
      }
      rainTransition(next);
    });

    // 3. Auto-hide Dock & Handle
    const dockHeader = document.getElementById('dockHeader');
    const shelf = document.getElementById('shelf');
    const handle = document.getElementById('handle');
    const desktopDock = window.matchMedia('(min-width: 861px)');
    const ZONE = 32;
    let hideT = 0;
    let inside = false;
    let near = false;
    let focused = false;

    function showDock() {
      if (hideT) {
        clearTimeout(hideT);
        hideT = 0;
      }
      dockHeader?.classList.add('show');
      dockHeader?.classList.remove('peek');
    }

    function hideSoon(ms) {
      if (hideT) return;
      if (desktopDock.matches) {
        hideT = window.setTimeout(() => {
          hideT = 0;
          if (!inside && !near && !focused) {
            dockHeader?.classList.remove('show');
            dockHeader?.classList.add('peek');
          }
        }, ms);
      } else {
        // On mobile the dock stays visible; don't auto-hide.
        hideT = 0;
      }
    }

    function syncDockMode(event) {
      if (!event.matches) {
        // Mobile: dock stays visible.
        showDock();
      } else if (!inside && !near && !focused) {
        hideSoon(2600);
      }
    }

    if (desktopDock.addEventListener) {
      desktopDock.addEventListener('change', syncDockMode);
    } else {
      desktopDock.addListener(syncDockMode);
    }

    shelf?.addEventListener('pointerenter', () => {
      inside = true;
      showDock();
    });

    shelf?.addEventListener('pointerleave', (e) => {
      inside = false;
      hideSoon(e.pointerType === 'touch' ? 3500 : 450);
    });

    document.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      near = e.clientY >= window.innerHeight - ZONE;
      if (near) {
        showDock();
      } else if (!inside) {
        hideSoon(450);
      }
    });

    document.documentElement.addEventListener('mouseleave', () => {
      near = false;
      hideSoon(300);
    });

    handle?.addEventListener('click', () => {
      showDock();
      hideSoon(3500);
    });

    document.addEventListener('focusin', (e) => {
      if (
        (shelf?.contains(e.target) || e.target === handle) &&
        e.target.matches(':focus-visible')
      ) {
        focused = true;
        showDock();
      }
    });

    document.addEventListener('focusout', () => {
      focused = false;
      hideSoon(600);
    });

    if (desktopDock.matches) hideSoon(2600);
    else showDock();

    // 4. Efek Magnifikasi macOS Dock
    const items = shelf ? Array.from(shelf.querySelectorAll('.item')) : [];
    const icons = items.map((li) => li.querySelector('.icon'));
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    let base = 48;
    let max = 79;
    let radius = 135;
    let cx = 0;
    let offs = [];
    let cur = [];
    let mouseX = null;
    let raf = 0;

    function applyDock() {
      items.forEach((li, i) => {
        const s = `${cur[i]}px`;
        li.style.width = s;
        if (icons[i]) {
          icons[i].style.width = s;
          icons[i].style.height = s;
        }
      });
    }

    function measureDock() {
      items.forEach((li, i) => {
        li.style.width = '';
        if (icons[i]) {
          icons[i].style.width = '';
          icons[i].style.height = '';
        }
      });
      base = items[0]?.getBoundingClientRect().width || 48;
      max = (reduceMotion || !fine.matches) ? base : base * 1.65;
      radius = base * 2.8;
      cur = items.map(() => base);
      applyDock();
      if (shelf) {
        const r = shelf.getBoundingClientRect();
        cx = r.left + r.width / 2;
        offs = items.map((li) => {
          const b = li.getBoundingClientRect();
          return b.left + b.width / 2 - cx;
        });
      }
    }

    function frameDock() {
      let moving = false;
      items.forEach((li, i) => {
        let t = base;
        if (mouseX !== null) {
          const d = Math.abs(mouseX - (cx + offs[i]));
          if (d < radius) {
            t = base + (max - base) * Math.pow(Math.cos((d / radius) * (Math.PI / 2)), 2);
          }
        }
        const diff = t - cur[i];
        if (Math.abs(diff) > 0.2) {
          cur[i] += diff * 0.3;
          moving = true;
        } else {
          cur[i] = t;
        }
      });
      applyDock();
      raf = moving ? requestAnimationFrame(frameDock) : 0;
    }

    function kickDock() {
      if (!raf) raf = requestAnimationFrame(frameDock);
    }

    shelf?.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch' || max === base) return;
      mouseX = e.clientX;
      kickDock();
    });

    shelf?.addEventListener('pointerleave', () => {
      mouseX = null;
      kickDock();
    });

    window.addEventListener('resize', () => {
      mouseX = null;
      measureDock();
    });

    icons.forEach((a, i) => {
      if (!a) return;
      a.addEventListener('click', (e) => {
        const li = items[i];
        a.classList.remove('bounce');
        void a.offsetWidth;
        a.classList.add('bounce');
        li.classList.add('show-tip');
        setTimeout(() => li.classList.remove('show-tip'), 1300);

        const targetId = li.dataset.id;
        if (targetId === 'lokasi') {
          const currentP = window.location.pathname.replace(/\/+$/, '') || '/';
          if (currentP === '/') {
            e.preventDefault();
            const lokasiEl = document.getElementById('lokasi');
            if (lokasiEl) {
              lokasiEl.scrollIntoView({ behavior: 'smooth' });
            }
            window.history.pushState(null, '', '#lokasi');
            items.forEach((item) => item.classList.remove('active'));
            li.classList.add('active');
          }
        }
      });
      a.addEventListener('animationend', () => a.classList.remove('bounce'));
    });

    function syncActiveHash() {
      if (window.location.hash === '#lokasi') {
        items.forEach((li) => {
          const on = li.dataset.id === 'lokasi';
          li.classList.toggle('active', on);
          const a = li.querySelector('.icon');
          if (on) a?.setAttribute('aria-current', 'page');
          else a?.removeAttribute('aria-current');
        });
      }
    }
    window.addEventListener('hashchange', syncActiveHash);
    syncActiveHash();

    measureDock();
  })();
</script>

<style>
  /* ===== Header Top Bar ===== */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(251, 252, 250, 0.78);
    border-bottom: 1px solid rgba(23, 68, 60, 0.1);
    backdrop-filter: blur(18px) saturate(145%);
    -webkit-backdrop-filter: blur(18px) saturate(145%);
    transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .header[data-header-theme="dark"] {
    background: rgba(8, 18, 16, 0.58);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.14);
  }

  html[data-theme="dark"] .header {
    background: rgba(14, 20, 18, 0.75);
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 70px;
    gap: 16px;
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .header__logo-media {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .header__logo-img {
    display: block;
    width: auto;
    height: 40px;
    object-fit: contain;
    transition: opacity 0.25s ease;
  }

  .header__logo-img--light {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    pointer-events: none;
  }

  .header[data-header-theme="dark"] .header__logo-img--dark,
  html[data-theme="dark"] .header__logo-img--dark {
    opacity: 0;
  }

  .header[data-header-theme="dark"] .header__logo-img--light,
  html[data-theme="dark"] .header__logo-img--light {
    opacity: 1;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 0 0 auto;
  }

  .header__cta {
    min-height: 40px;
    padding: 0 18px;
    font-size: 0.86rem;
  }



  /* ===== Tombol Theme (Mode Gelap/Terang Beranimasi Sesuai Referensi) ===== */
  .theme {
    position: relative;
    width: 56px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 99px;
    overflow: hidden;
    cursor: pointer;
    background: #5cb8ff;
    box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.4), 0 6px 16px rgba(0, 0, 0, 0.22);
    -webkit-tap-highlight-color: transparent;
    flex: 0 0 auto;
  }

  .theme:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  .theme .sky,
  .theme .sky::after {
    position: absolute;
    inset: 0;
    transition: opacity 0.7s ease;
  }

  .theme .sky {
    background: linear-gradient(180deg, #4aa8ff, #bfe8ff);
  }

  .theme .sky::after {
    content: "";
    background: linear-gradient(180deg, #080c26, #2b2366);
    opacity: 0;
  }

  :root[data-theme="dark"] .theme .sky::after,
  html[data-theme="dark"] .theme .sky::after {
    opacity: 1;
  }

  .theme .stars i {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #fff;
    opacity: 0;
    transform: translateY(-10px) scale(0.4);
    transition: opacity 0.5s ease 0.15s, transform 0.6s ease 0.15s;
  }

