<!-- Top Bar: Logo & Actions -->
<header class="header" id="main-header" data-header-theme="light">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="The Rain Villas beranda">
      <span class="header__logo-media">
        <img src="/logo%20trv2.png" alt="The Rain Villas" class="header__logo-img header__logo-img--dark" />
        <img
          src="/logo%20trv2%20putih.png"
          alt=""
          aria-hidden="true"
          class="header__logo-img header__logo-img--light"
        />
      </span>
    </a>

    <div class="header__actions">
      <!-- Referensi Switch Dark Mode Beranimasi -->
      <button class="theme" id="theme" type="button" role="switch" aria-checked="false" aria-label="Mode gelap">
        <span class="sky"></span>
        <span class="stars"><i></i><i></i><i></i><i></i><i></i></span>
        <span class="clouds"><i></i><i></i></span>
        <span class="knob"><b></b><b></b><b></b></span>
      </button>

      <a href="https://wa.me/6282125492037" target="_blank" rel="nofollow" class="btn btn--whatsapp header__cta">
        Hubungi Kami
      </a>
    </div>
  </div>
</header>

<!-- Dock Navbar Bawah Sesuai Referensi -->
<header class="dock-header show" id="dockHeader">
  <nav class="shelf" id="shelf" aria-label="Navigasi utama">
    <ul>
      {navLinks.map((link) => (
        <>
          {link.sep && <li class="sep" aria-hidden="true" />}
          <li class={`item ${isLinkActive(link.href) ? 'active' : ''}`} data-id={link.id}>
            <a
              class="icon"
              href={link.href}
              aria-label={link.label}
              data-track={link.track}
              aria-current={isLinkActive(link.href) ? 'page' : undefined}
            >
              <span class="tile">
                <svg viewBox="0 0 24 24" set:html={link.icon} />
              </span>
              <span class="tip">{link.label}</span>
            </a>
          </li>
        </>
      ))}
    </ul>
  </nav>
</header>
<button class="handle" id="handle" type="button" aria-label="Tampilkan menu"></button>

<script is:inline>
  (() => {
    // 1. Observer logo kontras pada section gelap
    const header = document.getElementById('main-header');
    const darkSelectors = ['.journey-hero', '.evening', '.reviews-marquee', '.satisfaction'];
    function isDarkSection(el) {
      return darkSelectors.some((sel) => el.matches(sel));
    }

    const sections = document.querySelectorAll('section');
    if (header && sections.length) {
      const observer = new IntersectionObserver((entries) => {
        let maxRatio = 0;
        let theme = 'light';
        entries.forEach((entry) => {
          if (entry.intersectionRatio > maxRatio) {
            maxRatio = entry.intersectionRatio;
            theme = isDarkSection(entry.target) ? 'dark' : 'light';
          }
        });
        header.setAttribute('data-header-theme', theme);
      }, { threshold: [0, 0.18, 0.36, 0.54, 0.72, 0.9, 1] });

      sections.forEach((s) => observer.observe(s));
    }

    // 2. Mode Gelap dengan Animasi Lingkaran Membesar (View Transition)
    const root = document.documentElement;
    const themeBtn = document.getElementById('theme');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function setTheme(t) {
      root.setAttribute('data-theme', t);
      if (themeBtn) {
        themeBtn.setAttribute('aria-checked', String(t === 'dark'));
      }
      try {
        localStorage.setItem('therainvillas_theme', t);
      } catch (e) {}
    }

    const initialTheme = root.getAttribute('data-theme') || 'light';
    if (themeBtn) {
      themeBtn.setAttribute('aria-checked', String(initialTheme === 'dark'));
    }

    themeBtn?.addEventListener('click', () => {
      const current = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      const next = current === 'dark' ? 'light' : 'dark';

      if (!document.startViewTransition || reduceMotion) {
        setTheme(next);
        return;
      }

      const r = themeBtn.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      const end = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y)
      );

      const vt = document.startViewTransition(() => {
        setTheme(next);
      });

      vt.ready.then(() => {
        root.animate(
          {
            clipPath: [
              `circle(0px at ${x}px ${y}px)`,
              `circle(${end}px at ${x}px ${y}px)`
            ]
          },
          {
            duration: 850,
            easing: 'cubic-bezier(.4, 0, .2, 1)',
            pseudoElement: '::view-transition-new(root)'
          }
        );
      });
    });

    // 3. Auto-hide Dock & Handle
    const dockHeader = document.getElementById('dockHeader');
    const shelf = document.getElementById('shelf');
    const handle = document.getElementById('handle');
    const desktopDock = window.matchMedia('(min-width: 861px)');
    const ZONE = 32;
    let hideT = 0;
    let inside = false;
    let near = false;
    let focused = false;

    function showDock() {
      if (hideT) {
        clearTimeout(hideT);
        hideT = 0;
      }
      dockHeader?.classList.add('show');
      dockHeader?.classList.remove('peek');
    }

    function hideSoon(ms) {
      if (hideT) return;
      if (desktopDock.matches) {
        hideT = window.setTimeout(() => {
          hideT = 0;
          if (!inside && !near && !focused) {
            dockHeader?.classList.remove('show');
            dockHeader?.classList.add('peek');
          }
        }, ms);
      } else {
        // On mobile the dock stays visible; don't auto-hide.
        hideT = 0;
      }
    }

    function syncDockMode(event) {
      if (!event.matches) {
        // Mobile: dock stays visible.
        showDock();
      } else if (!inside && !near && !focused) {
        hideSoon(2600);
      }
    }

    if (desktopDock.addEventListener) {
      desktopDock.addEventListener('change', syncDockMode);
    } else {
      desktopDock.addListener(syncDockMode);
    }

    shelf?.addEventListener('pointerenter', () => {
      inside = true;
      showDock();
    });

    shelf?.addEventListener('pointerleave', (e) => {
      inside = false;
      hideSoon(e.pointerType === 'touch' ? 3500 : 450);
    });

    document.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      near = e.clientY >= window.innerHeight - ZONE;
      if (near) {
        showDock();
      } else if (!inside) {
        hideSoon(450);
      }
    });

    document.documentElement.addEventListener('mouseleave', () => {
      near = false;
      hideSoon(300);
    });

    handle?.addEventListener('click', () => {
      showDock();
      hideSoon(3500);
    });

    document.addEventListener('focusin', (e) => {
      if (
        (shelf?.contains(e.target) || e.target === handle) &&
        e.target.matches(':focus-visible')
      ) {
        focused = true;
        showDock();
      }
    });

    document.addEventListener('focusout', () => {
      focused = false;
      hideSoon(600);
    });

    if (desktopDock.matches) hideSoon(2600);
    else showDock();

    // 4. Efek Magnifikasi macOS Dock
    const items = shelf ? Array.from(shelf.querySelectorAll('.item')) : [];
    const icons = items.map((li) => li.querySelector('.icon'));
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    let base = 48;
    let max = 79;
    let radius = 135;
    let cx = 0;
    let offs = [];
    let cur = [];
    let mouseX = null;
    let raf = 0;

    function applyDock() {
      items.forEach((li, i) => {
        const s = `${cur[i]}px`;
        li.style.width = s;
        if (icons[i]) {
          icons[i].style.width = s;
          icons[i].style.height = s;
        }
      });
    }

    function measureDock() {
      items.forEach((li, i) => {
        li.style.width = '';
        if (icons[i]) {
          icons[i].style.width = '';
          icons[i].style.height = '';
        }
      });
      base = items[0]?.getBoundingClientRect().width || 48;
      max = (reduceMotion || !fine.matches) ? base : base * 1.65;
      radius = base * 2.8;
      cur = items.map(() => base);
      applyDock();
      if (shelf) {
        const r = shelf.getBoundingClientRect();
        cx = r.left + r.width / 2;
        offs = items.map((li) => {
          const b = li.getBoundingClientRect();
          return b.left + b.width / 2 - cx;
        });
      }
    }

    function frameDock() {
      let moving = false;
      items.forEach((li, i) => {
        let t = base;
        if (mouseX !== null) {
          const d = Math.abs(mouseX - (cx + offs[i]));
          if (d < radius) {
            t = base + (max - base) * Math.pow(Math.cos((d / radius) * (Math.PI / 2)), 2);
          }
        }
        const diff = t - cur[i];
        if (Math.abs(diff) > 0.2) {
          cur[i] += diff * 0.3;
          moving = true;
        } else {
          cur[i] = t;
        }
      });
      applyDock();
      raf = moving ? requestAnimationFrame(frameDock) : 0;
    }

    function kickDock() {
      if (!raf) raf = requestAnimationFrame(frameDock);
    }

    shelf?.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch' || max === base) return;
      mouseX = e.clientX;
      kickDock();
    });

    shelf?.addEventListener('pointerleave', () => {
      mouseX = null;
      kickDock();
    });

    window.addEventListener('resize', () => {
      mouseX = null;
      measureDock();
    });

    icons.forEach((a, i) => {
      if (!a) return;
      a.addEventListener('click', (e) => {
        const li = items[i];
        a.classList.remove('bounce');
        void a.offsetWidth;
        a.classList.add('bounce');
        li.classList.add('show-tip');
        setTimeout(() => li.classList.remove('show-tip'), 1300);

        const targetId = li.dataset.id;
        if (targetId === 'lokasi') {
          const currentP = window.location.pathname.replace(/\/+$/, '') || '/';
          if (currentP === '/') {
            e.preventDefault();
            const lokasiEl = document.getElementById('lokasi');
            if (lokasiEl) {
              lokasiEl.scrollIntoView({ behavior: 'smooth' });
            }
            window.history.pushState(null, '', '#lokasi');
            items.forEach((item) => item.classList.remove('active'));
            li.classList.add('active');
          }
        }
      });
      a.addEventListener('animationend', () => a.classList.remove('bounce'));
    });

    function syncActiveHash() {
      if (window.location.hash === '#lokasi') {
        items.forEach((li) => {
          const on = li.dataset.id === 'lokasi';
          li.classList.toggle('active', on);
          const a = li.querySelector('.icon');
          if (on) a?.setAttribute('aria-current', 'page');
          else a?.removeAttribute('aria-current');
        });
      }
    }
    window.addEventListener('hashchange', syncActiveHash);
    syncActiveHash();

    measureDock();
  })();
</script>

<style>
  /* ===== Header Top Bar ===== */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(251, 252, 250, 0.78);
    border-bottom: 1px solid rgba(23, 68, 60, 0.1);
    backdrop-filter: blur(18px) saturate(145%);
    -webkit-backdrop-filter: blur(18px) saturate(145%);
    transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .header[data-header-theme="dark"] {
    background: rgba(8, 18, 16, 0.58);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.14);
  }

  html[data-theme="dark"] .header {
    background: rgba(14, 20, 18, 0.75);
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 70px;
    gap: 16px;
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .header__logo-media {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .header__logo-img {
    display: block;
    width: auto;
    height: 40px;
    object-fit: contain;
    transition: opacity 0.25s ease;
  }

  .header__logo-img--light {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    pointer-events: none;
  }

  .header[data-header-theme="dark"] .header__logo-img--dark,
  html[data-theme="dark"] .header__logo-img--dark {
    opacity: 0;
  }

  .header[data-header-theme="dark"] .header__logo-img--light,
  html[data-theme="dark"] .header__logo-img--light {
    opacity: 1;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 0 0 auto;
  }

  .header__cta {
    min-height: 40px;
    padding: 0 18px;
    font-size: 0.86rem;
  }

  /* ===== Tombol Theme (Mode Gelap/Terang Beranimasi Sesuai Referensi) ===== */
  .theme {
    position: relative;
    width: 56px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 99px;
    overflow: hidden;
    cursor: pointer;
    background: #5cb8ff;
    box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.4), 0 6px 16px rgba(0, 0, 0, 0.22);
    -webkit-tap-highlight-color: transparent;
    flex: 0 0 auto;
  }

  .theme:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  .theme .sky,
  .theme .sky::after {
    position: absolute;
    inset: 0;
    transition: opacity 0.7s ease;
  }

  .theme .sky {
    background: linear-gradient(180deg, #4aa8ff, #bfe8ff);
  }

  .theme .sky::after {
    content: "";
    background: linear-gradient(180deg, #080c26, #2b2366);
    opacity: 0;
  }

  :root[data-theme="dark"] .theme .sky::after,
  html[data-theme="dark"] .theme .sky::after {
    opacity: 1;
  }

  .theme .stars i {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #fff;
    opacity: 0;
    transform: translateY(-10px) scale(0.4);
    transition: opacity 0.5s ease 0.15s, transform 0.6s ease 0.15s;
  }

  .theme .stars i:nth-child(1) { left: 10px; top: 7px; }
  .theme .stars i:nth-child(2) { left: 18px; top: 18px; width: 1.5px; height: 1.5px; }
  .theme .stars i:nth-child(3) { left: 25px; top: 8px; }
  .theme .stars i:nth-child(4) { left: 13px; top: 22px; width: 1.5px; height: 1.5px; }
  .theme .stars i:nth-child(5) { left: 32px; top: 20px; width: 1.5px; height: 1.5px; }

  :root[data-theme="dark"] .theme .stars i,
  html[data-theme="dark"] .theme .stars i {
    opacity: 1;
    transform: none;
    animation: theme-twinkle 2.6s ease-in-out infinite;
  }

  :root[data-theme="dark"] .theme .stars i:nth-child(even),
  html[data-theme="dark"] .theme .stars i:nth-child(even) {
    animation-delay: -1.3s;
  }

  @keyframes theme-twinkle {
    50% { opacity: 0.3; }
  }

  .theme .clouds i {
    position: absolute;
    border-radius: 99px;
    background: #fff;
    opacity: 0.95;
    transition: transform 0.7s cubic-bezier(0.5, 0, 0.3, 1), opacity 0.5s ease;
  }

  .theme .clouds i:nth-child(1) { width: 22px; height: 8px; right: 5px; bottom: 2px; }
  .theme .clouds i:nth-child(2) { width: 15px; height: 7px; right: 20px; bottom: 8px; opacity: 0.7; }

  :root[data-theme="dark"] .theme .clouds i,
  html[data-theme="dark"] .theme .clouds i {
    transform: translateY(24px);
    opacity: 0;
  }

  .theme .knob {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff3a8, #ffc83d 55%, #ff9a1f);
    box-shadow: 0 0 0 4px rgba(255, 214, 90, 0.28), 0 0 16px 4px rgba(255, 190, 50, 0.75);
    transform: translateX(0) rotate(0deg);
    transition: transform 0.8s cubic-bezier(0.3, 1.35, 0.4, 1), box-shadow 0.6s ease;
  }

  .theme .knob::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f7f9ff, #c9d0e3 60%, #9aa3bd);
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .theme .knob b {
    position: absolute;
    border-radius: 50%;
    background: rgba(120, 130, 160, 0.45);
    opacity: 0;
    transition: opacity 0.5s ease 0.2s;
  }

  .theme .knob b:nth-child(1) { width: 5px; height: 5px; left: 12px; top: 5px; }
  .theme .knob b:nth-child(2) { width: 4px; height: 4px; left: 5px; top: 12px; }
  .theme .knob b:nth-child(3) { width: 3px; height: 3px; left: 14px; top: 15px; }

  :root[data-theme="dark"] .theme .knob,
  html[data-theme="dark"] .theme .knob {
    transform: translateX(26px) rotate(360deg);
    box-shadow: 0 0 0 4px rgba(200, 210, 255, 0.14), 0 0 14px 2px rgba(190, 205, 255, 0.45);
  }

  :root[data-theme="dark"] .theme .knob::before,
  :root[data-theme="dark"] .theme .knob b,
  html[data-theme="dark"] .theme .knob::before,
  html[data-theme="dark"] .theme .knob b {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme .knob,
    .theme .knob::before,
    .theme .knob b,
    .theme .sky::after,
    .theme .stars i,
    .theme .clouds i {
      transition: none;
      animation: none !important;
    }
  }

  /* ===== Dock Navbar Bawah (Persis Sesuai Referensi) ===== */
  .dock-header {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 120;
    display: flex;
    justify-content: center;
    padding: 0 10px calc(env(safe-area-inset-bottom, 0px) + 12px);
    pointer-events: none;
  }

  .shelf {
    pointer-events: auto;
    display: inline-flex;
    background: var(--glass);
    -webkit-backdrop-filter: blur(26px) saturate(180%);
    backdrop-filter: blur(26px) saturate(180%);
    border: 1px solid var(--glass-line);
    border-radius: 22px;
    box-shadow: 0 10px 30px rgba(20, 30, 28, 0.16), 0 0 0 0.5px rgba(20, 30, 28, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.5);
    transform: translateY(calc(100% + 40px + env(safe-area-inset-bottom, 0px)));
    opacity: 0;
    transition: transform 0.5s cubic-bezier(0.2, 0.85, 0.25, 1), opacity 0.35s ease;
  }

  .dock-header.show .shelf {
    transform: none;
    opacity: 1;
  }

  .dock-header.peek .shelf {
    transform: translateY(75%);
    opacity: 1;
  }

  @media (min-width: 861px) {
    .dock-header.peek .shelf {
      transform: translateY(calc(75% + env(safe-area-inset-bottom, 0px)));
    }
  }

  .shelf ul {
    list-style: none;
    margin: 0;
    padding: 8px 10px 16px;
    display: flex;
    align-items: flex-start;
    gap: var(--gap, 6px);
  }

  .item {
    position: relative;
    height: var(--base, 48px);
    width: var(--base, 48px);
  }

  .sep {
    width: 1px;
    height: calc(var(--base, 48px) * 0.82);
    margin: 4px 4px 0;
    background: var(--sep);
    border-radius: 1px;
  }

  .icon {
    position: absolute;
    left: 0;
    bottom: 0;
