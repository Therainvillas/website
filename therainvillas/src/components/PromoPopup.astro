        type="image/webp"
        media="(min-width: 641px)"
      />
      <source srcset="/promo/promo%204-900.webp" type="image/webp" />
      <img
        class="promo-popup__image"
        src="/promo/promo%204-1400.webp"
        alt="Flash Sale 10%-20% The Rain Villas"
        width="2000"
        height="1414"
