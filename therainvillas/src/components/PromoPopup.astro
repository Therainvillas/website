<script>
  document.addEventListener('DOMContentLoaded', () => {
    const popup = document.getElementById('promo-popup');
    if (!popup) return;

    const closeBtn = popup.querySelector('.promo-popup__close');
    const cta = popup.querySelector('.promo-popup__cta');

    function open() { popup.classList.add('promo-popup--open'); }
    function close() { popup.classList.remove('promo-popup--open'); }

    const isReload = performance.getEntriesByType?.('navigation')
      .some(n => n.type === 'reload');
    if (isReload) sessionStorage.removeItem('promoShown');

    if (sessionStorage.getItem('promoShown')) return;
    setTimeout(() => {
      open();
      sessionStorage.setItem('promoShown', 'true');
    }, 800);

    closeBtn?.addEventListener('click', close);
    cta?.addEventListener('click', close);
    popup.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) close();
    });
  });
</script>

<div id="promo-popup" class="promo-popup">
  <div class="promo-popup__card">
    <button class="promo-popup__close" aria-label="Tutup">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <img
      class="promo-popup__image"
      src="/promo/promo%203.PNG"
      alt="Flash Sale 10%-20% The Rain Villas"
      loading="lazy"
    />
    <div class="promo-popup__body">
      <h2 class="promo-popup__title">Flash Sale 10%-20%</h2>
      <p class="promo-popup__desc">Untuk September!!. Untuk 20% kuota terbatas!!, Grab the best deals before it's too late</p>
      <a href="https://wa.me/6282125492037?text=Halo%20The%20Rain%20Villas%2C%20saya%20tertarik%20dengan%20Flash%20Sale%2010%25-20%25%20untuk%20September" target="_blank" rel="nofollow" class="btn btn--primary promo-popup__cta">Klaim Sekarang</a>
    </div>
  </div>
</div>

