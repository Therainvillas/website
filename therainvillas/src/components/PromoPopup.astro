    border-radius: 20px;
    max-width: 420px;
    width: 100%;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    transform: scale(0.9);
    transition: transform 0.35s ease;
  }

  .promo-popup--open .promo-popup__card {
    transform: scale(1);
  }

  .promo-popup__close {
    position: absolute;
