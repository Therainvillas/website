<script>
  document.addEventListener('DOMContentLoaded', () => {
    const popup = document.getElementById('promo-popup');
    if (!popup) return;

    const closeBtn = popup.querySelector('.promo-popup__close');
    const cta = popup.querySelector('.promo-popup__cta');

    function open() { popup.classList.add('promo-popup--open'); }
    function close() { popup.classList.remove('promo-popup--open'); }

    const isReload = performance.getEntriesByType?.('navigation')
      .some(n => n.type === 'reload');
    if (isReload) sessionStorage.removeItem('promoShown');

    if (sessionStorage.getItem('promoShown')) return;
    setTimeout(() => {
      open();
      sessionStorage.setItem('promoShown', 'true');
    }, 800);

    closeBtn?.addEventListener('click', close);
    cta?.addEventListener('click', close);
    popup.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) close();
    });
  });

  document.addEventListener('DOMContentLoaded', () => {
    const target = (function () {
      const now = new Date();
      let t = new Date(now.getFullYear(), 9, 10, 0, 0, 0);
      if (t.getTime() <= now.getTime()) t = new Date(now.getFullYear() + 1, 9, 10, 0, 0, 0);
      return t;
    })();

    const countEl = document.querySelector('.promo-popup__count');
    const endedEl = document.querySelector('.promo-popup__ended');
    const daysEl = document.querySelector('[data-cd-days]');
    const hoursEl = document.querySelector('[data-cd-hours]');
    const minutesEl = document.querySelector('[data-cd-minutes]');
    const secondsEl = document.querySelector('[data-cd-seconds]');
    if (!countEl && !endedEl) return;

    function tick() {
      const diff = target.getTime() - Date.now();
      if (diff <= 0) {
        if (countEl) countEl.hidden = true;
        if (endedEl) endedEl.hidden = false;
        return;
      }
      const days = Math.floor(diff / 86400000);
      const hours = Math.floor(diff / 3600000) % 24;
      const minutes = Math.floor(diff / 60000) % 60;
      const seconds = Math.floor(diff / 1000) % 60;
      const pad = (n) => ('0' + n).slice(-2);
      if (daysEl) daysEl.textContent = days;
      if (hoursEl) hoursEl.textContent = pad(hours);
      if (minutesEl) minutesEl.textContent = pad(minutes);
      if (secondsEl) secondsEl.textContent = pad(seconds);
    }

    tick();
    setInterval(tick, 1000);
  });
</script>

<div id="promo-popup" class="promo-popup">
  <div class="promo-popup__card">
    <button class="promo-popup__close" aria-label="Tutup">
