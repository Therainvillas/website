    </picture>
    <div class="promo-popup__body">
      <h2 class="promo-popup__title">Flash Sale 10.10</h2>
      <p class="promo-popup__desc">Flash Sale 250.000 The Rain Villas — hitung mundur hingga flash sale dibuka:</p>
      <div class="promo-popup__count">
        <div class="promo-popup__count-item">
          <strong data-cd-days>0</strong>
          <span>Hari</span>
        </div>
        <div class="promo-popup__count-item">
          <strong data-cd-hours>0</strong>
          <span>Jam</span>
        </div>
        <div class="promo-popup__count-item">
          <strong data-cd-minutes>0</strong>
          <span>Menit</span>
        </div>
        <div class="promo-popup__count-item">
          <strong data-cd-seconds>0</strong>
          <span>Detik</span>
        </div>
      </div>
      <p class="promo-popup__ended" data-cd-ended hidden>🔥 Flash Sale 10.10 telah dimulai!</p>
      <a href="/promo" class="btn btn--primary promo-popup__cta">Lihat Promo Sekarang</a>
    </div>
  </div>
</div>

