---
import { sampleReviews, reviewCardHTML } from '../data/reviews.js';

const SSR_SETS = 4;
const reviewsTrackHTML = Array.from({ length: SSR_SETS }, () => sampleReviews.map(reviewCardHTML).join('')).join('');
---

<section class="reviews-marquee" id="apa-kata-mereka">
  <div class="reviews-marquee__orb reviews-marquee__orb--accent"></div>
  <div class="reviews-marquee__orb reviews-marquee__orb--primary"></div>

  <div class="container">
    <div class="reviews-marquee__header reveal">
      <span class="reviews-marquee__badge reveal">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        Ulasan Tamu
      </span>
      <h2 class="reviews-marquee__title reveal">
        Apa Kata <span class="reviews-marquee__title-accent">Mereka</span>
      </h2>
      <div class="reviews-marquee__divider reveal" aria-hidden="true">
        <span class="reviews-marquee__line"></span>
        <span class="reviews-marquee__dot"></span>
        <span class="reviews-marquee__line"></span>
      </div>
      <p class="reviews-marquee__subtitle reveal reveal--delay-1">Ulasan asli dari penyewa yang telah menginap di The Rain Villas</p>
    </div>
  </div>

  <div class="reviews-marquee__viewport">
    <div class="reviews-marquee__track" id="reviewsTrack" set:html={reviewsTrackHTML}></div>
  </div>
</section>

<script>
  import { REVIEWS_API_URL, parseReviews, reviewCardHTML } from '../data/reviews.js';

  const track = document.getElementById('reviewsTrack');
  if (track) {
    const CACHE_KEY = 'trv_reviews_cache';
    const TIMEOUT_MS = 5000;

    function renderReviews(reviews) {
      if (!reviews || !reviews.length) return;
      const cards = reviews.map(reviewCardHTML).join('');
      const viewportW = window.innerWidth || 1600;
      const approxSetW = reviews.length * 424; // card width + gap
      const halves = Math.max(2, Math.ceil((viewportW * 2) / approxSetW) * 2);
      const copies = halves % 2 === 0 ? halves : halves + 1;
      // Even number of identical copies → translateX(-50%) loops seamlessly
      track.innerHTML = cards.repeat(copies);
      try { sessionStorage.setItem(CACHE_KEY, JSON.stringify(reviews)); } catch (e) {}
    }

    (async () => {
      // show last fetched reviews instantly, then refresh in background
      try {
        const cached = JSON.parse(sessionStorage.getItem(CACHE_KEY));
        if (Array.isArray(cached) && cached.length) renderReviews(cached);
      } catch (e) {}

      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);

      try {
        const url = REVIEWS_API_URL + '?action=reviews&_=' + Date.now();
        const res = await fetch(url, { redirect: 'follow', cache: 'no-store', signal: controller.signal });
        const text = await res.text();
        let data = null;
        try {
          data = JSON.parse(text);
        } catch (e) {
          const m = text.match(/\(([\s\S]*)\)\s*;?\s*$/);
          if (m) {
            try { data = JSON.parse(m[1]); } catch (e2) { data = null; }
          }
        }
        renderReviews(parseReviews(data));
      } catch (e) {
        // network error / timeout → keep SSR sample cards (never blank)
      } finally {
        clearTimeout(timer);
      }
    })();
  }
</script>

<style is:global>
  .reviews-marquee {
    position: relative;
    overflow: hidden;
    /* Glassmorphism transparan — mengikuti latar halaman di belakangnya. */
    background:
      radial-gradient(900px 420px at 12% 0%, rgba(var(--color-accent-rgb), 0.1), transparent 70%),
      radial-gradient(800px 400px at 88% 100%, rgba(var(--color-primary-rgb), 0.1), transparent 70%),
      linear-gradient(160deg, var(--glass), rgba(255, 255, 255, 0) 55%, var(--glass));
    -webkit-backdrop-filter: blur(22px) saturate(140%);
    backdrop-filter: blur(22px) saturate(140%);
    border-top: 1px solid var(--glass-line);
    border-bottom: 1px solid var(--glass-line);
    padding: 108px 0 76px;
    isolation: isolate;
  }

  /* ===== ambient glow orbs ===== */
  .reviews-marquee__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.45;
    pointer-events: none;
    z-index: -1;
  }
  .reviews-marquee__orb--accent {
    width: 520px;
    height: 520px;
    top: -180px;
    left: -120px;
    background: radial-gradient(circle, rgba(var(--color-accent-rgb), 0.28), transparent 70%);
  }
  .reviews-marquee__orb--primary {
    width: 620px;
    height: 620px;
    bottom: -260px;
    right: -160px;
    background: radial-gradient(circle, rgba(var(--color-primary-rgb), 0.22), transparent 70%);
  }

  .reviews-marquee__header {
    text-align: center;
    max-width: 660px;
    margin: 0 auto 56px;
    padding: 0 24px;
  }

  .reviews-marquee__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-primary);
    background: rgba(var(--color-primary-rgb), 0.1);
    border: 1px solid rgba(var(--color-primary-rgb), 0.22);
    border-radius: 999px;
    padding: 9px 20px;
    margin-bottom: 20px;
    box-shadow: 0 0 24px rgba(var(--color-primary-rgb), 0.1) inset;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .reviews-marquee__title {
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    font-weight: 700;
    color: var(--color-dark);
    line-height: 1.15;
    margin-bottom: 18px;
  }

  .reviews-marquee__title-accent {
    background: linear-gradient(90deg, var(--color-accent-dark), var(--color-accent));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .reviews-marquee__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 18px;
  }
  .reviews-marquee__line {
    width: 56px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(var(--color-accent-rgb), 0.7));
  }
  .reviews-marquee__line:last-child {
    background: linear-gradient(90deg, rgba(var(--color-accent-rgb), 0.7), transparent);
  }
  .reviews-marquee__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px rgba(var(--color-accent-rgb), 0.6);
  }

  .reviews-marquee__subtitle {
    color: var(--color-gray);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .reviews-marquee__viewport {
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
  }

  .reviews-marquee__track {
    display: flex;
    gap: 24px;
    width: max-content;
    padding: 10px 0 20px;
    will-change: transform;
    animation: reviews-marquee-scroll 45s linear infinite;
  }

  .reviews-marquee:hover .reviews-marquee__track {
    animation-play-state: paused;
  }

  @keyframes reviews-marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ===== card ===== */
  .reviews-marquee__card {
    position: relative;
    width: 400px;
    max-width: 86vw;
    flex-shrink: 0;
    background: var(--glass);
    border: 1px solid var(--glass-line);
    border-radius: 28px;
    padding: 30px 30px 26px;
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    backdrop-filter: blur(14px) saturate(130%);
    box-shadow: 0 20px 50px rgba(21, 35, 30, 0.12);
    transition: transform 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;
  }

  .reviews-marquee__card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 28px;
    padding: 2px;
    background: linear-gradient(135deg, rgba(var(--color-accent-rgb), 0.65), transparent 40%, transparent 70%, rgba(var(--color-primary-rgb), 0.4));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.28s ease;
    pointer-events: none;
  }

  .reviews-marquee__card:hover {
    transform: translateY(-6px);
    border-color: rgba(var(--color-accent-rgb), 0.5);
    box-shadow: 0 28px 60px rgba(21, 35, 30, 0.18);
  }

  .reviews-marquee__card:hover::before {
    opacity: 1;
  }

  .reviews-marquee__quote {
    position: absolute;
    top: 4px;
    right: 22px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 5.5rem;
    line-height: 1;
    color: rgba(var(--color-accent-rgb), 0.22);
    user-select: none;
  }

  .reviews-marquee__rect {
    position: relative;
    background: var(--glass);
    border: 1px solid rgba(var(--color-primary-rgb), 0.16);
    border-radius: 18px;
    padding: 18px 20px;
    margin-bottom: 18px;
    box-shadow: 0 6px 16px rgba(21, 35, 30, 0.06);
  }

  .reviews-marquee__stars {
    position: relative;
    display: inline-flex;
    gap: 3px;
    color: var(--color-accent);
    font-size: 1.05rem;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .reviews-marquee__text {
    position: relative;
    color: var(--color-gray-dark);
    font-size: 0.97rem;
    line-height: 1.75;
    margin: 0 0 26px;
    min-height: 86px;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .reviews-marquee__author {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }

  .reviews-marquee__avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    flex-shrink: 0;
    padding: 2px;
    background: linear-gradient(135deg, var(--color-accent), var(--color-primary));
    box-shadow: 0 4px 14px rgba(var(--color-accent-rgb), 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .reviews-marquee__avatar-initial {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--color-panel);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .reviews-marquee__meta {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .reviews-marquee__name-row {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .reviews-marquee__name {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--color-dark);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .reviews-marquee__check {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.5);
    color: #16a34a;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .reviews-marquee__villa {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--color-accent-dark);
    background: rgba(var(--color-accent-rgb), 0.1);
    border: 1px solid rgba(var(--color-accent-rgb), 0.28);
    border-radius: 999px;
    padding: 4px 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  @media (max-width: 768px) {
    .reviews-marquee {
      padding: 76px 0 60px;
    }
    .reviews-marquee__viewport {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .reviews-marquee__card {
      width: 330px;
    }
    .reviews-marquee__text {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews-marquee__track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      padding: 0 24px;
    }
    .reviews-marquee__card {
      flex: 1 1 330px;
      max-width: none;
    }
  }
</style>