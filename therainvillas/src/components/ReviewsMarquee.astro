---
import { sampleReviews, reviewCardHTML } from '../data/reviews.js';

const SSR_SETS = 2;
const reviewsTrackHTML = Array.from({ length: SSR_SETS }, () => sampleReviews.map(reviewCardHTML).join('')).join('');
// Satu set kartu (5 kartu × 424px) ≈ 2120px. Durasi awal disamakan dengan
// kecepatan target 94 px/s; script hanya menyempurnakannya setelah diukur.
const ssrDuration = ((sampleReviews.length * 424 + 12) / 94).toFixed(2);
---

<section class="reviews-marquee" id="apa-kata-mereka">
  <div class="container">
    <div class="reviews-marquee__header reveal">
      <span class="reviews-marquee__badge reveal">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        Ulasan Tamu
      </span>
      <h2 class="reviews-marquee__title reveal">
        Apa Kata <span class="reviews-marquee__title-accent">Mereka</span>
      </h2>
      <div class="reviews-marquee__divider reveal" aria-hidden="true">
        <span class="reviews-marquee__line"></span>
        <span class="reviews-marquee__dot"></span>
        <span class="reviews-marquee__line"></span>
      </div>
      <p class="reviews-marquee__subtitle reveal reveal--delay-1">Ulasan asli dari penyewa yang telah menginap di The Rain Villas</p>
    </div>
  </div>

  <div class="reviews-marquee__viewport">
    <div
      class="reviews-marquee__track"
      id="reviewsTrack"
      style={`--marquee-duration:${ssrDuration}s`}
      set:html={reviewsTrackHTML}
    ></div>
  </div>
</section>

<script>
  // Script marquee (fetch + penggantian DOM) baru dimuat saat section mendekati
  // viewport. Kartu SSR tetap tampil & beranimasi walau JS belum/tidak jalan.
  (() => {
    const track = document.getElementById('reviewsTrack');
    if (!track) return;

    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      if (observer) observer.disconnect();
      import('../scripts/reviewsMarquee.js')
        .then((mod) => mod.initReviewsMarquee(track))
        .catch(() => {});
    };

    let observer = null;
    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) start();
        },
        { rootMargin: '800px 0px' },
      );
      observer.observe(track);
    } else {
      start();
    }
  })();
</script>

<style is:global>
  .reviews-marquee {
    position: relative;
    overflow: hidden;
    /* Circle gradient aesthetic: midnight navy sebagai warna utama, powder blue di tepi. */
    background:
      radial-gradient(circle at 18% 8%, rgba(176, 224, 230, 0.16), transparent 52%),
      radial-gradient(circle at 82% 92%, rgba(176, 224, 230, 0.12), transparent 58%),
      radial-gradient(circle at 50% 36%, #24357c 0%, #191970 40%, #191970 68%, #b0e0e6 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    border-bottom: 1px solid rgba(25, 25, 112, 0.15);
    padding: 108px 0 76px;
    isolation: isolate;
  }

  .reviews-marquee__header {
    text-align: center;
    max-width: 660px;
    margin: 0 auto 56px;
    padding: 0 24px;
  }

  .reviews-marquee__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #cdeef3;
    background: rgba(176, 224, 230, 0.08);
    border: 1px solid rgba(176, 224, 230, 0.42);
    border-radius: 999px;
    padding: 9px 20px;
    margin-bottom: 20px;
    box-shadow: 0 0 24px rgba(176, 224, 230, 0.14) inset;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .reviews-marquee__title {
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 18px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
  }

  .reviews-marquee__title-accent {
    background: linear-gradient(90deg, #eaf9fb, #b0e0e6);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .reviews-marquee__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 18px;
  }
  .reviews-marquee__line {
    width: 56px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(176, 224, 230, 0.8));
  }
  .reviews-marquee__line:last-child {
    background: linear-gradient(90deg, rgba(176, 224, 230, 0.8), transparent);
  }
  .reviews-marquee__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #b0e0e6;
    box-shadow: 0 0 12px rgba(176, 224, 230, 0.9);
  }

  .reviews-marquee__subtitle {
    color: rgba(230, 247, 250, 0.8);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .reviews-marquee__viewport {
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
  }

  .reviews-marquee__track {
    display: flex;
    gap: 24px;
    width: max-content;
    padding: 10px 0 20px;
    will-change: transform;
    animation: reviews-marquee-scroll var(--marquee-duration, 22.55s) linear infinite;
  }

  .reviews-marquee:hover .reviews-marquee__track {
    animation-play-state: paused;
  }

  @keyframes reviews-marquee-scroll {
    from { transform: translateX(0); }
    /* -50% saja menyisakan selisih setengah gap (12px) setiap loop;
       kompensasi ini membuat sambungan set benar-benar mulus. */
    to { transform: translateX(calc(-50% - 12px)); }
  }

  /* ===== card ===== */
  .reviews-marquee__card {
    position: relative;
    width: 400px;
    max-width: 86vw;
    flex-shrink: 0;
    /* Kartu putih solid agar tetap terpisah dari bagian gradient yang memutih. */
    background: #ffffff;
    border: 1px solid rgba(25, 25, 112, 0.14);
    border-radius: 28px;
    padding: 30px 30px 26px;
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    backdrop-filter: blur(14px) saturate(120%);
    box-shadow: 0 20px 46px rgba(9, 12, 40, 0.35);
    transition: transform 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;
  }

  .reviews-marquee__card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 28px;
    padding: 2px;
    background: linear-gradient(135deg, rgba(176, 224, 230, 0.85), transparent 40%, transparent 70%, rgba(25, 25, 112, 0.5));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.28s ease;
    pointer-events: none;
  }

  .reviews-marquee__card:hover {
    transform: translateY(-6px);
    border-color: rgba(127, 184, 196, 0.8);
    box-shadow: 0 28px 58px rgba(9, 12, 40, 0.45);
  }

  .reviews-marquee__card:hover::before {
    opacity: 1;
  }

  .reviews-marquee__quote {
    position: absolute;
    top: 4px;
    right: 22px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 5.5rem;
    line-height: 1;
    color: rgba(25, 25, 112, 0.16);
    user-select: none;
  }

  .reviews-marquee__rect {
    position: relative;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(25, 25, 112, 0.12);
    border-radius: 18px;
    padding: 18px 20px;
    margin-bottom: 18px;
    box-shadow: 0 6px 16px rgba(25, 25, 112, 0.06);
  }

  .reviews-marquee__stars {
    position: relative;
    display: inline-flex;
    gap: 3px;
    color: #191970;
    font-size: 1.05rem;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .reviews-marquee__text {
    position: relative;
    color: #1f2947;
    font-size: 0.97rem;
    line-height: 1.75;
    margin: 0 0 26px;
    min-height: 86px;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .reviews-marquee__author {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 20px;
    border-top: 1px solid rgba(25, 25, 112, 0.1);
  }

  .reviews-marquee__avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    flex-shrink: 0;
    padding: 2px;
    background: linear-gradient(135deg, #b0e0e6, #191970);
    box-shadow: 0 4px 14px rgba(25, 25, 112, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .reviews-marquee__avatar-initial {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #ffffff;
    color: #191970;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .reviews-marquee__meta {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .reviews-marquee__name-row {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .reviews-marquee__name {
    font-size: 0.98rem;
    font-weight: 600;
    color: #101a3a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .reviews-marquee__check {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.5);
    color: #16a34a;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .reviews-marquee__villa {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: #191970;
    background: #eef8fa;
    border: 1px solid #bfe4ea;
    border-radius: 999px;
    padding: 4px 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  @media (max-width: 768px) {
    .reviews-marquee {
      padding: 76px 0 60px;
    }
    .reviews-marquee__viewport {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .reviews-marquee__card {
      width: 330px;
    }
    .reviews-marquee__text {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews-marquee__track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      padding: 0 24px;
    }
    .reviews-marquee__card {
      flex: 1 1 330px;
      max-width: none;
    }
  }
</style>