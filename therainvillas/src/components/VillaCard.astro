---
import { slugify } from '../lib/slugify.js';
import { formatPrice } from '../data/villas.js';

interface Props {
  id: number;
  name: string;
  description: string;
  image: string;
  price?: string | number;
  priceLabel?: string;
  originalPrice?: number;
  badge?: string;
  capacity?: number;
  bedrooms?: number;
  bathrooms?: number;
  parking?: number;
}

const {
  id,
  name,
  description,
  image,
  priceLabel,
  price,
  originalPrice,
  badge,
  capacity = 0,
  bedrooms = 0,
  bathrooms = 0,
  parking = 0,
} = Astro.props;

function parsePriceValue(value) {
  if (typeof value === 'number' && Number.isFinite(value)) return value;
  if (typeof value === 'string') {
    const digits = value.replace(/[^\d]/g, '');
    return digits ? Number(digits) : null;
  }
  return null;
}

const priceText = typeof price === 'number'
  ? formatPrice(price)
  : (price ?? priceLabel ?? 'Cek harga');
const priceNumber = parsePriceValue(price) ?? parsePriceValue(priceLabel);
const showOriginal = typeof originalPrice === 'number'
  && (!priceNumber || originalPrice > priceNumber);
const originalPriceText = showOriginal ? formatPrice(originalPrice) : '';
const discountPercent = showOriginal && priceNumber && originalPrice > priceNumber
  ? Math.round((1 - priceNumber / originalPrice) * 100)
  : 0;
const showDiscount = discountPercent >= 1 && discountPercent <= 99;
const link = `/${slugify(name)}`;
---

<article class="villa-card">
  <a href={link} class="villa-card__media" aria-hidden="true" tabindex="-1">
    <img src={image} alt={name} width="1200" height="675" loading="lazy" decoding="async" />
    {badge && <span class="villa-card__badge">{badge}</span>}
    {showDiscount && (
      <span class="villa-card__discount" aria-label={`Diskon ${discountPercent} persen`}>
        <strong>-{discountPercent}%</strong>
        <small>Hemat</small>
      </span>
    )}
    <span class="villa-card__price">
      {originalPriceText && <s class="villa-card__price-old">{originalPriceText}</s>}
      <span>{priceText}</span>
    </span>
  </a>

  <div class="villa-card__body">
    <h3 class="villa-card__title">
      <a href={link}>{name}</a>
    </h3>
    <p class="villa-card__desc">{description}</p>

    <ul class="villa-card__stats">
      <li>
        <span class="villa-card__stat-icon"><img class="ti ti--light" src="/icon/icon%20light/bed.png" alt="" width="16" height="16" loading="lazy" decoding="async" /><img class="ti ti--dark" src="/icon/icon%20dark/bedroom.png" alt="" width="16" height="16" loading="lazy" decoding="async" /></span>
        <strong>{bedrooms}</strong> kamar
      </li>
      <li>
        <span class="villa-card__stat-icon"><img class="ti ti--light" src="/icon/icon%20light/bathroom.png" alt="" width="16" height="16" loading="lazy" decoding="async" /><img class="ti ti--dark" src="/icon/icon%20dark/bathroom.png" alt="" width="16" height="16" loading="lazy" decoding="async" /></span>
        <strong>{bathrooms}</strong> kamar mandi
      </li>
      <li>
        <span class="villa-card__stat-icon"><img class="ti ti--light" src="/icon/icon%20light/groupp.png" alt="" width="16" height="16" loading="lazy" decoding="async" /><img class="ti ti--dark" src="/icon/icon%20dark/grup.png" alt="" width="16" height="16" loading="lazy" decoding="async" /></span>
        <strong>{capacity}</strong> tamu
      </li>
      <li>
        <span class="villa-card__stat-icon"><img class="ti ti--light" src="/icon/icon%20light/parking.png" alt="" width="16" height="16" loading="lazy" decoding="async" /><img class="ti ti--dark" src="/icon/icon%20dark/parking.png" alt="" width="16" height="16" loading="lazy" decoding="async" /></span>
        <strong>{parking}</strong> parkir
      </li>
    </ul>

    <a href={link} class="villa-card__btn">Lihat Detail</a>
  </div>
</article>

<style>
  .villa-card {
    --tilt-rx: 0deg;
    --tilt-ry: 0deg;
    --tilt-gx: 50%;
    --tilt-gy: 50%;
    --tilt-glare: 0;
    --card-radius: 20px;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    overflow: hidden;
    transform: none;
    transform-origin: center;
    transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* Kilau tipis mengikuti kursor, hanya tampil saat hover. */
  .villa-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    pointer-events: none;
    opacity: var(--tilt-glare);
    background: radial-gradient(
      circle 190px at var(--tilt-gx) var(--tilt-gy),
      rgba(255, 255, 255, 0.24),
      rgba(255, 255, 255, 0) 70%
    );
    transition: opacity 0.3s ease;
  }

  /* Pengguna keyboard: kartu terangkat halus saat tautan/tombol difokus. */
  .villa-card:has(a:focus-visible),
  .villa-card:has(button:focus-visible) {
    transform: translateY(-4px);
  }

  .villa-card.is-tilting {
    --tilt-glare: 1;
    z-index: 1;
    transform: perspective(700px) rotateX(var(--tilt-rx)) rotateY(var(--tilt-ry)) translateY(-6px);
    transition: transform 0.18s ease-out;
    will-change: transform;
  }

  /* Pastikan sudut tetap membulat penuh saat kartu diputar 3D,
     termasuk ketika kartu sedang kembali ke posisi semula. */
  .villa-card.is-tilting,
  .villa-card.is-resetting {
    clip-path: inset(0 round var(--card-radius));
  }

  /* Umpan balik tap di layar sentuh (tanpa tilt). */
  .villa-card.is-pressed {
    transform: translateY(1px) scale(0.985);
    transition: transform 0.15s ease-out;
  }

  .villa-card__media {
    position: relative;
    display: block;
    height: 220px;
    overflow: hidden;
    border-radius: var(--card-radius) var(--card-radius) 0 0;
  }

  .villa-card__media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .villa-card__price {
    position: absolute;
    left: 14px;
    bottom: 14px;
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 7px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
    background: rgba(91, 141, 239, 0.92);
    backdrop-filter: blur(4px);
  }

  .villa-card__price-old {
    font-size: 0.78em;
    font-weight: 600;
    opacity: 0.78;
  }

  .villa-card__badge {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    padding: 7px 14px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 800;
    color: #4a2c00;
    background: linear-gradient(135deg, #ffd76a 0%, #ffb84d 55%, #ff9d2e 100%);
    box-shadow: 0 6px 18px rgba(255, 170, 40, 0.45);
    letter-spacing: 0.2px;
  }

  .villa-card__discount {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 2;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    padding: 6px 10px 7px;
    border-radius: 12px;
    color: #fff;
    background: linear-gradient(135deg, #ff3d6e 0%, #ff7a18 100%);
    box-shadow: 0 8px 20px rgba(255, 61, 110, 0.45);
    transform: rotate(-3deg);
    transition: transform 0.35s ease;
  }

  .villa-card__discount strong {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.2px;
  }

  .villa-card__discount small {
    margin-top: 2px;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.92;
  }

  .villa-card:hover .villa-card__discount {
    transform: rotate(-3deg);
  }

  .villa-card__badge--flash {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #fff;
    background: linear-gradient(135deg, #ff3d6e 0%, #ff7a18 100%);
    box-shadow: 0 6px 18px rgba(255, 61, 110, 0.45);
    animation: villa-flash-pulse 1.8s ease-in-out infinite;
  }

  @keyframes villa-flash-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  @media (prefers-reduced-motion: reduce) {
    .villa-card__badge--flash { animation: none; }
    .villa-card__discount { transition: none; }

    .villa-card,
    .villa-card.is-tilting,
    .villa-card.is-pressed,
    .villa-card:has(a:focus-visible),
    .villa-card:has(button:focus-visible) {
      transform: none;
      transition: none;
    }

    .villa-card::after { display: none; }
  }

  .villa-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px;
  }

  .villa-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .villa-card__title a {
    color: var(--color-dark);
    text-decoration: none;
  }

  .villa-card__title a:hover {
    color: #5b8def;
  }

  .villa-card__desc {
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0 0 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .villa-card__stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding: 0;
    margin: auto 0 18px;
  }

  .villa-card__stats li {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--color-gray);
  }

  .villa-card__stats strong {
    color: var(--color-dark);
  }

  .villa-card__stat-icon img {
    width: 16px;
    height: 16px;
    display: block;
  }

  .villa-card__btn {
    display: block;
    text-align: center;
    padding: 11px 16px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    color: #fff;
    background: linear-gradient(135deg, #5b8def 0%, #7a5ce0 100%);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .villa-card__btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .villa-card__media {
      height: 190px;
    }

    /* Judul villa juga berfungsi sebagai link, beri area tap yang nyaman. */
    .villa-card__title a {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
    }

    .villa-card__stats {
      margin-bottom: 14px;
    }
  }
</style>