---
interface Props {
  id: number;
  name: string;
  description: string;
  image: string;
  price?: string;
  priceLabel?: string;
  capacity?: number;
  bedrooms?: number;
  bathrooms?: number;
  parking?: number;
}

const {
  id,
  name,
  description,
  image,
  priceLabel,
  price,
  capacity = 0,
  bedrooms = 0,
  bathrooms = 0,
  parking = 0,
} = Astro.props;

const priceText = price ?? priceLabel ?? 'Cek harga';
const link = `/villas/${id}`;
---

<article class="villa-card">
  <a href={link} class="villa-card__media" aria-hidden="true" tabindex="-1">
    <img src={image} alt={name} loading="lazy" />
    <span class="villa-card__price">{priceText}</span>
  </a>

  <div class="villa-card__body">
    <h3 class="villa-card__title">
      <a href={link}>{name}</a>
    </h3>
    <p class="villa-card__desc">{description}</p>

    <ul class="villa-card__stats">
      <li>
        <span class="villa-card__stat-icon">🌙</span>
        <strong>{bedrooms}</strong> kamar
      </li>
      <li>
        <span class="villa-card__stat-icon">🧺</span>
        <strong>{bathrooms}</strong> kamar mandi
      </li>
      <li>
        <span class="villa-card__stat-icon">👥</span>
        <strong>{capacity}</strong> tamu
      </li>
      <li>
        <span class="villa-card__stat-icon">🅿️</span>
        <strong>{parking}</strong> parkir
      </li>
    </ul>

    <a href={link} class="villa-card__btn">Lihat Detail</a>
  </div>
</article>

<style>
  .villa-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    overflow: hidden;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
  }

  .villa-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 22px 44px rgba(91, 141, 239, 0.18);
  }

  .villa-card__media {
    position: relative;
    display: block;
    height: 220px;
    overflow: hidden;
  }

  .villa-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .villa-card:hover .villa-card__media img {
    transform: scale(1.06);
  }

  .villa-card__price {
    position: absolute;
    left: 14px;
    bottom: 14px;
    padding: 7px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
    background: rgba(91, 141, 239, 0.92);
    backdrop-filter: blur(4px);
  }

  .villa-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px;
  }

  .villa-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .villa-card__title a {
    color: var(--color-dark);
    text-decoration: none;
  }

  .villa-card__title a:hover {
    color: #5b8def;
  }

  .villa-card__desc {
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0 0 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .villa-card__stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding: 0;
    margin: auto 0 18px;
  }

  .villa-card__stats li {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--color-gray);
  }

  .villa-card__stats strong {
    color: var(--color-dark);
  }

  .villa-card__stat-icon {
    font-size: 0.9rem;
  }

  .villa-card__btn {
    display: block;
    text-align: center;
    padding: 11px 16px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    color: #fff;
    background: linear-gradient(135deg, #5b8def 0%, #7a5ce0 100%);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .villa-card__btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .villa-card__media {
      height: 190px;
    }
  }
</style>