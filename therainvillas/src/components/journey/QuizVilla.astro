<section class="quiz" id="quiz">
  <div class="quiz__video-bg">
    <video autoplay muted loop playsinline class="quiz__video">
      <source src="/quiz-bg.mp4" type="video/mp4" />
    </video>
    <div class="quiz__video-overlay"></div>
  </div>
  <div class="container" style="position:relative;z-index:1">
    <div class="quiz__box" id="quizBox">
      <div id="quizStart" class="quiz__screen quiz__screen--active">
        <div class="quiz__start-icon">
          <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <h2 class="quiz__title">Cari Villa dengan Spesifikasi Impianmu</h2>
        <p class="quiz__desc">Pilih fasilitas, kapasitas, dan budget — kami rekomendasikan villa paling cocok untukmu!</p>
        <button class="quiz__btn-start" id="quizStartBtn">Mulai Quiz</button>
      </div>

      <div id="quizQ1" class="quiz__screen">
        <div class="quiz__progress-wrap">
          <div class="quiz__progress-bar"><div class="quiz__progress-fill" style="width:33%"></div></div>
          <span class="quiz__progress-label">1 dari 3</span>
        </div>
        <h3 class="quiz__question">Suasana villa impianmu?</h3>
        <div class="quiz__options" data-question="1">
          <button class="quiz__option" data-value="cozy">
            <span class="quiz__option-icon">★</span>
            <span class="quiz__option-text">Cozy & Intimate</span>
          </button>
          <button class="quiz__option" data-value="mewah">
            <span class="quiz__option-icon">★★★</span>
            <span class="quiz__option-text">Mewah & Premium</span>
          </button>
          <button class="quiz__option" data-value="luas">
            <span class="quiz__option-icon">★★★★</span>
            <span class="quiz__option-text">Luas & Lega</span>
          </button>
          <button class="quiz__option" data-value="modern">
            <span class="quiz__option-icon">★★</span>
            <span class="quiz__option-text">Modern & Stylish</span>
          </button>
        </div>
      </div>

      <div id="quizQ2" class="quiz__screen">
        <div class="quiz__progress-wrap">
          <div class="quiz__progress-bar"><div class="quiz__progress-fill" style="width:66%"></div></div>
          <span class="quiz__progress-label">2 dari 3</span>
        </div>
        <h3 class="quiz__question">Jumlah kamar tidur yang dibutuhkan?</h3>
        <div class="quiz__options" data-question="2">
          <button class="quiz__option" data-value="2">
            <span class="quiz__option-icon">★★</span>
            <span class="quiz__option-text">2 kamar</span>
          </button>
          <button class="quiz__option" data-value="3">
            <span class="quiz__option-icon">★★★</span>
            <span class="quiz__option-text">3 kamar</span>
          </button>
          <button class="quiz__option" data-value="4">
            <span class="quiz__option-icon">★★★★</span>
            <span class="quiz__option-text">4 kamar</span>
          </button>
          <button class="quiz__option" data-value="5">
            <span class="quiz__option-icon">★★★★★</span>
            <span class="quiz__option-text">5+ kamar</span>
          </button>
        </div>
      </div>

      <div id="quizQ3" class="quiz__screen">
        <div class="quiz__progress-wrap">
          <div class="quiz__progress-bar"><div class="quiz__progress-fill" style="width:100%"></div></div>
          <span class="quiz__progress-label">3 dari 3</span>
        </div>
        <h3 class="quiz__question">Budget per malam kamu?</h3>
        <div class="quiz__options" data-question="3">
          <button class="quiz__option" data-value="hemat">
            <span class="quiz__option-icon">★</span>
            <span class="quiz__option-text">Hemat (&lt; Rp 1,3jt)</span>
          </button>
          <button class="quiz__option" data-value="sedang">
            <span class="quiz__option-icon">★★</span>
            <span class="quiz__option-text">Sedang (Rp 1,3-1,5jt)</span>
          </button>
          <button class="quiz__option" data-value="premium">
            <span class="quiz__option-icon">★★★</span>
            <span class="quiz__option-text">Premium (Rp 1,5-1,7jt)</span>
          </button>
          <button class="quiz__option" data-value="sultan">
            <span class="quiz__option-icon">★★★★</span>
            <span class="quiz__option-text">Sultan (&gt; Rp 1,7jt)</span>
          </button>
        </div>
      </div>

      <div id="quizResult" class="quiz__screen">
        <div class="quiz__result" id="quizResultContent"></div>
        <button class="quiz__btn-restart" id="quizRestartBtn">Ulang Quiz</button>
      </div>
    </div>
  </div>
</section>

<script>
  const slugify = (s) => String(s).toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
  const villasData = [
    { id: 8, name: "Villa Cyrena", price: "Rp 1.200.000/malam", image: "/thumbnail/Cyrena%20Thumb.jpg", desc: "Villa elegan dengan private pool dan area bersantai. Cocok untuk liburan keluarga atau kumpul teman." },
    { id: 10, name: "Villa Cempaka", price: "Rp 1.200.000/malam", image: "/thumbnail/Cempaka%20Thumb.jpg", desc: "Villa bergaya Eropa dengan arsitektur klasik elegan, private pool, dan taman mediterania." },
    { id: 1, name: "Villa Agave", price: "Rp 1.700.000/malam", image: "/thumbnail/Agave%20Thumb.jpg", desc: "Villa luas dengan 3 bangunan, private pool, dan area billiard. Cocok untuk acara besar dan gathering." },
    { id: 12, name: "Villa Rayya", price: "Rp 1.350.000/malam", image: "/thumbnail/Rayya%20Thumb.jpg", desc: "Villa cozy dengan queen bed, private pool, karaoke, dan chill space. Cocok untuk staycation romantis." },
    { id: 11, name: "Villa Arsy", price: "Rp 1.700.000/malam", image: "/thumbnail/Griya%20Arsy%20Thumb.jpg", desc: "Villa dengan private pool, mushola, dan suasana nyaman. Cocok untuk liburan keluarga yang tenang." },
    { id: 2, name: "Villa Wanela", price: "Rp 1.000.000/malam", image: "/thumbnail/Wanela%20Thumb.jpg", desc: "Villa cozy dengan private pool dan billiard. Cocok untuk staycation santai bersama teman atau keluarga." },
    { id: 4, name: "Villa Aleia", price: "Rp 1.400.000/malam", image: "/thumbnail/Aleia%20Thumb.jpg", desc: "Villa cozy dengan private pool, gazebo, dan kitchen set lengkap. Cocok untuk liburan santai bersama keluarga." },
    { id: 9, name: "Villa Arisyfa", price: "Rp 1.500.000/malam", image: "/thumbnail/Arisyfa%20Thumb.jpg", desc: "Villa luas 3 lantai dengan lapangan badminton dan private pool. Cocok untuk gathering keluarga besar." },
    { id: 3, name: "Villa Cemara", price: "Rp 1.300.000/malam", image: "/thumbnail/Cemara%20Thumb.jpg", desc: "Villa asri dengan private pool, balkon, dan halaman luas. Cocok untuk healing dan quality time." },
    { id: 5, name: "Villa 4D", price: "Rp 1.200.000/malam", image: "/thumbnail/4D%20Thumb.jpg", desc: "Villa dengan konsep ala cafe, private pool, gazebo, dan area billiard. Cocok untuk nongkrong santai." },
    { id: 19, name: "Villa De Summit", price: "Rp 2.000.000/malam", image: "/thumbnail/De%20Summit%20Thumb.jpg", desc: "Villa dengan pendopo view 360, private pool, dan space api unggun. Cocok untuk gathering eksklusif." },
    { id: 7, name: "Villa Twins", price: "Rp 1.500.000/malam", image: "/thumbnail/Twins%20Thumb.jpg", desc: "Villa twin dengan lapangan basket, playground, dan free 2 glamping. Cocok untuk gathering dan acara keluarga." },
  ];

  const scoring = {
    q1: { cozy: [2, 4, 10], mewah: [8, 11, 7], luas: [1, 9, 3], modern: [5, 19, 12] },
    q1_pts: { cozy: 2, mewah: 2, luas: 2, modern: 2 },
    q2: { "2": [2], "3": [8, 10, 12, 4, 7], "4": [11, 5, 19], "5": [9, 3, 1] },
    q2_pts: { "2": 2, "3": 2, "4": 2, "5": 2 },
    q3: { hemat: [2, 8, 10, 5, 3], sedang: [9, 7, 12, 4], premium: [1, 11, 9], sultan: [19, 1, 11] },
    q3_pts: { hemat: 2, sedang: 2, premium: 2, sultan: 2 },
  };

  const qBonus = {
    cozy: { "2": [2], "3": [4, 10] },
    mewah: { "3": [8, 7], "4": [11] },
    luas: { "5": [1, 9, 3] },
    modern: { "3": [8], "4": [5, 19] },
  };

  let answers = {};

  function show(id) {
    document.querySelectorAll(".quiz__screen").forEach((s) => s.classList.remove("quiz__screen--active"));
    const el = document.getElementById(id);
    if (el) el.classList.add("quiz__screen--active");
  }

  document.getElementById("quizStartBtn").addEventListener("click", () => show("quizQ1"));

  document.querySelectorAll(".quiz__option").forEach((btn) => {
    btn.addEventListener("click", function () {
      const q = this.closest(".quiz__options").dataset.question;
      answers[q] = this.dataset.value;
      if (q === "1") show("quizQ2");
      else if (q === "2") show("quizQ3");
      else if (q === "3") showResult();
    });
  });

  function showResult() {
    const scores = {};
    villasData.forEach((v) => (scores[v.id] = 0));

    Object.entries(scoring).forEach(([key, data]) => {
      const qNum = key.replace("q", "");
      const ans = answers[qNum];
      if (!ans || !data[ans]) return;
      data[ans].forEach((id) => (scores[id] += data[`${key}_pts`] ? data[`${key}_pts`][ans] : 2));
    });

    const q1a = answers["1"];
    const q2a = answers["2"];
    if (q1a && q2a && qBonus[q1a] && qBonus[q1a][q2a]) {
      qBonus[q1a][q2a].forEach((id) => (scores[id] += 1));
    }

    let topId = null;
    let topScore = -1;
    Object.entries(scores).forEach(([id, score]) => {
      if (score > topScore) {
        topScore = score;
        topId = parseInt(id);
      }
    });

    const villa = villasData.find((v) => v.id === topId);
    if (!villa) return;

    const content = document.getElementById("quizResultContent");
    content.innerHTML = `
      <div class="quiz__result-card">
        <div class="quiz__result-img-wrap">
          <img src="${villa.image}" alt="${villa.name}" class="quiz__result-img" />
          <div class="quiz__result-badge">Rekomendasi Terbaik</div>
        </div>
        <div class="quiz__result-info">
          <h3 class="quiz__result-name">${villa.name}</h3>
          <p class="quiz__result-desc">${villa.desc}</p>
          <div class="quiz__result-price">${villa.price}</div>
          <div class="quiz__result-actions">
            <a href="/villas/${slugify(villa.name)}" class="quiz__result-btn quiz__result-btn--detail">Lihat Detail</a>
            <a href="https://wa.me/6282125492037?text=Halo%20The%20Rain%20Villas%2C%20saya%20dapat%20rekomendasi%20${encodeURIComponent(villa.name)}%20dari%20quiz.%20Mohon%20info%20ketersediaan." target="_blank" rel="nofollow" class="quiz__result-btn quiz__result-btn--wa">Pesan via WhatsApp</a>
          </div>
        </div>
      </div>
    `;
    show("quizResult");
  }

  document.getElementById("quizRestartBtn").addEventListener("click", () => {
    answers = {};
    show("quizStart");
  });
</script>

