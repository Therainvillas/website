---
import { Image } from 'astro:assets';
import heroPoster from '../../assets/display-poster.jpg';

// Video profil memakai YouTube (bukan file mp4 yang di-hosting), supaya
// bandwidth server & kuota pengunjung hemat. Iframe baru dimuat setelah
// pengguna menekan tombol "Tonton Video".
const YOUTUBE_ID = 'Q5n6ph6eFsU';
const YOUTUBE_URL = `https://www.youtube.com/watch?v=${YOUTUBE_ID}`;
---

<section class="journey-hero" id="hero">
  <div class="journey-hero__bg">
    <Image
      src={heroPoster}
      alt=""
      class="journey-hero__poster"
      widths={[480, 768, 1280]}
      sizes="100vw"
      format="webp"
      quality={72}
      priority
      decoding="async"
    />
    <div
      class="journey-hero__embed"
      id="heroVideo"
      data-video-id={YOUTUBE_ID}
      aria-hidden="true"
    ></div>
    <div class="journey-hero__overlay"></div>
  </div>

  <button class="journey-hero__close" id="heroVideoClose" type="button" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    Tutup video
  </button>

  <div class="container journey-hero__content" id="heroContent">
    <div class="journey-hero__time reveal">The Rain Villas</div>
    <div class="journey-hero__tagline reveal reveal--delay-1">
      Villa Murah, View Mewah di Puncak
    </div>
    <h1 class="journey-hero__title reveal reveal--delay-2">
      <span class="scramble" data-text="Vacation with Family and Gathering with Friends">Vacation with Family and Gathering with Friends</span>
    </h1>
    <p class="journey-hero__subtitle reveal reveal--delay-3">
      Pilih villa, cek jadwal, lalu booking dengan proses yang jelas. Cocok untuk
      keluarga, gathering, dan akhir pekan yang ingin terasa lebih tenang.
    </p>

    <div class="journey-hero__actions reveal reveal--delay-4">
      <a href="/booking" class="journey-hero__btn journey-hero__btn--primary" data-track="booking_click">
        Booking Sekarang
        <span aria-hidden="true">&rarr;</span>
      </a>
      <a href="/availability" class="journey-hero__btn journey-hero__btn--ghost">
        Cek Jadwal
      </a>
      <a
        href={YOUTUBE_URL}
        class="journey-hero__btn journey-hero__btn--ghost journey-hero__play"
        id="heroVideoPlay"
        target="_blank"
        rel="noopener"
      >
        <svg class="journey-hero__play-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z" fill="currentColor" />
        </svg>
        Tonton Video
      </a>
    </div>

    <div class="journey-hero__price-tag reveal reveal--delay-4">
      Booking Sekarang &ndash; Mulai dari <strong>Rp 1.000.000</strong>
    </div>

    <div class="journey-hero__stats reveal reveal--delay-4">
      <div class="journey-hero__stat">
        <span class="journey-hero__stat-number">31</span>
        <span class="journey-hero__stat-label">Pilihan Villa</span>
      </div>
      <div class="journey-hero__stat">
        <span class="journey-hero__stat-number">5000+</span>
        <span class="journey-hero__stat-label">Tamu Terlayani</span>
      </div>
      <div class="journey-hero__stat">
        <span class="journey-hero__stat-number">4.9 <svg class="journey-hero__stat-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.94 6.26 6.87.87-5.06 4.73 1.3 6.79L12 17.27l-6.05 3.38 1.3-6.79L2.19 9.13l6.87-.87z" /></svg></span>
        <span class="journey-hero__stat-label">Rating Bintang</span>
      </div>
    </div>
  </div>
</section>

<script>
  // Facade YouTube: poster tetap elemen LCP, iframe player baru dibuat saat
  // pengguna menekan "Tonton Video" — jadi tidak ada beban ekstra saat load,
  // dan hemat kuota terutama di mobile.
  (() => {
    const hero = document.getElementById('hero') as HTMLElement | null;
    const embed = document.getElementById('heroVideo') as HTMLElement | null;
    const content = document.getElementById('heroContent') as HTMLElement | null;
    const play = document.getElementById('heroVideoPlay') as HTMLAnchorElement | null;
    const close = document.getElementById('heroVideoClose') as HTMLButtonElement | null;
    if (!hero || !embed || !play) return;

    const videoId = embed.dataset.videoId;
    if (!videoId) return;

    let iframe: HTMLIFrameElement | null = null;

    // Isi area hero (cover) tanpa mengubah rasio 16:9 video.
    const sizeIframe = () => {
      if (!iframe) return;
      const w = hero.clientWidth;
      const h = hero.clientHeight;
      if (!w || !h) return;
      const ratio = 16 / 9;
      let fw = w;
      let fh = w / ratio;
      if (fh < h) {
        fh = h;
        fw = h * ratio;
      }
      iframe.style.width = Math.round(fw) + 'px';
      iframe.style.height = Math.round(fh) + 'px';
    };

    const start = () => {
      if (!iframe) {
        iframe = document.createElement('iframe');
        // playsinline=1 penting untuk iOS: video main di tempat, bukan fullscreen.
        iframe.src =
          'https://www.youtube.com/embed/' +
          videoId +
          '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
        iframe.title = 'Video profil The Rain Villas';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.setAttribute('frameborder', '0');
        embed.appendChild(iframe);
      }
      sizeIframe();
      embed.setAttribute('aria-hidden', 'false');
      hero.classList.add('journey-hero--playing');
      if (content) content.setAttribute('inert', '');
      if (close) close.hidden = false;
    };

    const stop = () => {
      hero.classList.remove('journey-hero--playing');
      if (content) content.removeAttribute('inert');
      if (close) close.hidden = true;
      embed.setAttribute('aria-hidden', 'true');
      // Hapus iframe agar pemutaran benar-benar berhenti (hemat memori/kuota).
      if (iframe) {
        iframe.remove();
        iframe = null;
      }
    };

    play.addEventListener('click', (event) => {
      event.preventDefault();
      start();
    });
    if (close) close.addEventListener('click', stop);
    window.addEventListener('resize', sizeIframe);
    window.addEventListener('orientationchange', sizeIframe);
  })();
</script>

<style>
  .journey-hero {
    position: relative;
    min-height: 92svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--color-footer);
  }

  .journey-hero__bg,
  .journey-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .journey-hero__bg {
    z-index: 0;
  }

.journey-hero__poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(0.92) contrast(1.04);
  transition: opacity 0.45s ease;
}

.journey-hero__embed {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background: #000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.45s ease;
}

.journey-hero__embed iframe {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border: 0;
}

  .journey-hero__overlay {
    background:
      linear-gradient(90deg, rgba(8, 18, 16, 0.82) 0%, rgba(8, 18, 16, 0.54) 46%, rgba(8, 18, 16, 0.18) 100%),
      linear-gradient(180deg, rgba(8, 18, 16, 0.18) 0%, rgba(8, 18, 16, 0.72) 100%);
    transition: opacity 0.45s ease;
  }

  .journey-hero__content {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0;
    padding: 112px 24px 88px;
    color: #fff;
    transition: opacity 0.45s ease;
  }

  /* Saat video diputar: poster + konten meredup supaya video terlihat jelas. */
  .journey-hero--playing .journey-hero__poster,
  .journey-hero--playing .journey-hero__overlay,
  .journey-hero--playing .journey-hero__content {
    opacity: 0;
    pointer-events: none;
  }

  .journey-hero--playing .journey-hero__embed {
    opacity: 1;
    pointer-events: auto;
  }

  /* Tombol tutup ikut menempel di layar selama video diputar, supaya selalu
     bisa dijangkau walau halaman digulir sedikit (header tinggi ± 72px). */
  .journey-hero--playing .journey-hero__close {
    position: fixed;
    top: 84px;
    right: 18px;
  }

  .journey-hero__close {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: var(--radius-pill);
    background: rgba(8, 18, 16, 0.62);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .journey-hero__close[hidden] {
    display: none;
  }

  .journey-hero__close svg {
    width: 16px;
    height: 16px;
  }

  .journey-hero__close:hover {
    border-color: rgba(255, 255, 255, 0.62);
    background: rgba(8, 18, 16, 0.8);
  }

  .journey-hero__play-icon {
    width: 16px;
    height: 16px;
  }

  .journey-hero__time {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 34px;
    padding: 8px 14px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    margin-bottom: 28px;
  }

  .journey-hero__time::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px rgba(184, 110, 47, 0.18);
  }

  .journey-hero__tagline {
    display: inline-block;
    margin-bottom: 16px;
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    background: rgba(184, 110, 47, 0.28);
    border: 1px solid rgba(184, 110, 47, 0.5);
    color: #fde8c8;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .journey-hero__title {
    max-width: 720px;
    margin-bottom: 22px;
    font-family: 'Cinzel', serif;
    font-size: 4.2rem;
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: 0;
    text-shadow: 0 16px 42px rgba(0, 0, 0, 0.24);
    text-wrap: balance;
  }

  .scramble {
    display: inline-block;
    font-variant-numeric: tabular-nums;
    font-family: 'Cinzel', serif;
  }

  @media (prefers-reduced-motion: reduce) {
    .scramble {
      animation: none !important;
    }
  }

  .journey-hero__subtitle {
    max-width: 610px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.08rem;
    line-height: 1.85;
    margin-bottom: 34px;
  }

  .journey-hero__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .journey-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 50px;
    padding: 0 22px;
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 0.94rem;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .journey-hero__btn:hover {
    transform: translateY(-2px);
  }

  .journey-hero__btn--primary {
    color: #fff;
    background: var(--color-accent);
    box-shadow: 0 18px 38px rgba(184, 110, 47, 0.26);
  }

  .journey-hero__btn--primary:hover {
    background: var(--color-accent-dark);
  }

  .journey-hero__btn--ghost {
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.34);
    background: rgba(255, 255, 255, 0.08);
  }

  .journey-hero__btn--ghost:hover {
    border-color: rgba(255, 255, 255, 0.62);
    background: rgba(255, 255, 255, 0.14);
  }

  .journey-hero__price-tag {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    margin-bottom: 40px;
    padding: 10px 20px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .journey-hero__price-tag strong {
    color: #fff;
    font-weight: 800;
  }

  .journey-hero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    max-width: 650px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .journey-hero__stat {
    min-height: 92px;
    padding: 18px;
    background: rgba(255, 255, 255, 0.08);
  }

  .journey-hero__stat-number {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #fff;
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1;
  }

  .journey-hero__stat-star {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    fill: #ffd76a;
  }

  .journey-hero__stat-label {
    display: block;
    margin-top: 8px;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.82rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .journey-hero {
      min-height: 88svh;
      align-items: flex-end;
    }

    .journey-hero__content {
      padding: 86px 20px 52px;
    }

    .journey-hero__tagline {
      font-size: 0.7rem;
      letter-spacing: 0.08em;
    }

    .journey-hero__title {
      font-size: 2.55rem;
    }

    .journey-hero__subtitle {
      font-size: 0.98rem;
      line-height: 1.72;
    }

    .journey-hero__actions {
      align-items: stretch;
      flex-direction: column;
      margin-bottom: 34px;
    }

    .journey-hero__stats {
      grid-template-columns: 1fr;
    }

    .journey-hero__stat {
      min-height: auto;
      padding: 15px 16px;
    }
  }

  @media (max-width: 480px) {
    .journey-hero__content {
      padding: 72px 16px 44px;
    }

    .journey-hero__title {
      font-size: 1.9rem;
      line-height: 1.12;
    }

    .journey-hero__subtitle {
      font-size: 0.9rem;
      line-height: 1.66;
    }

    .journey-hero__price-tag {
      width: 100%;
      padding: 10px 14px;
      font-size: 0.8rem;
    }

    .journey-hero__btn {
      min-height: 46px;
      font-size: 0.9rem;
    }

    .journey-hero__stat-number {
      font-size: 1.35rem;
    }

    .journey-hero__stat-label {
      font-size: 0.76rem;
    }

    .journey-hero__close {
      top: 14px;
      right: 14px;
    }
  }
</style>

<script>
  // Scramble text effect: setiap huruf berganti karakter acak sebelum
  // berakhir menampilkan teks asli, di-resolve secara berurutan dari kiri ke kanan.
  (() => {
    const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*';
    const TICK = 40;

    const scramble = (el) => {
      const finalText = el.dataset.text || el.textContent || '';
      const len = finalText.length;
      if (!len) return;

      const resolved = new Array(len).fill(false);
      const current = new Array(len).fill('');
      let nextResolve = 0;

      const tick = () => {
        const batch = Math.max(1, Math.floor(len * 0.08));
        for (let b = 0; b < batch && nextResolve < len; b++, nextResolve++) {
          resolved[nextResolve] = true;
        }

        for (let i = 0; i < len; i++) {
          current[i] = resolved[i] ? finalText[i] : CHARS[Math.floor(Math.random() * CHARS.length)];
        }

        el.textContent = current.join('');

        if (nextResolve < len) {
          setTimeout(tick, TICK);
        } else {
          el.textContent = finalText;
        }
      };

      tick();
    };

    const init = () => {
      document.querySelectorAll('.scramble').forEach(scramble);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
