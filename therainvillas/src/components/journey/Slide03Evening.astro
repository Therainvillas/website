---
import { villas } from '../../data/villas';
import { villaWheelCovers } from '../../data/covers';
import { slugify } from '../../lib/slugify.js';

const total = villas.length;
const stepDeg = 360 / total;
const zones = [...new Set(villas.map((villa) => villa.area))];
const first = villas[0];
const pad = (value) => String(value).padStart(2, '0');

// Varian kecil (480px) untuk mobile; varian besar tetap dipakai di layar
// ber-DPR tinggi. Dengan begitu roda tidak perlu mengunduh/decode 31 gambar
// 900x1250 sekaligus di ponsel.
const wheelCovers = villas.map((villa) => {
  const lg = villaWheelCovers[villa.name];
  if (!lg) return null;
  const sm = lg.replace('/card%20wheel/', '/card%20wheel/sm/');
  return { sm, lg };
});
---

<section class="wheel" id="malam" aria-labelledby="wheelTitle" style={`--step:${stepDeg}deg`}>
  <div class="container wheel__inner">
    <header class="wheel__head">
      <span class="wheel__eyebrow">Koleksi Lengkap</span>
      <h2 class="wheel__title" id="wheelTitle">Putar Roda Villa</h2>
      <p class="wheel__sub">
        31 villa private pool di Puncak dalam satu roda. Geser, ketuk, atau pakai panah
        untuk berkeliling — setiap kartu membuka detail dan harga terbarunya.
      </p>
    </header>

    <div class="wheel__tools">
      <div class="wheel__search">
        <label class="wheel__search-label" for="wheelSearch">Cari nama villa</label>
        <div class="wheel__search-box">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.6-3.6"></path>
          </svg>
          <input
            id="wheelSearch"
            data-wheel-search
            type="search"
            placeholder="Contoh: Agave, Cyrena, atau 07"
            autocomplete="off"
            spellcheck="false"
          />
          <button type="button" class="wheel__search-clear" data-wheel-clear aria-label="Hapus pencarian" hidden>✕</button>
        </div>
        <p class="wheel__results" data-wheel-results aria-live="polite">{total} villa siap dijelajahi</p>
        <p class="wheel__sr-only" data-wheel-announce aria-live="polite"></p>
      </div>

      <div class="wheel__zones" role="group" aria-label="Filter zona villa">
        <span class="wheel__zones-label">Zona</span>
        <div class="wheel__chips">
          <button type="button" class="wheel__chip" data-zone="" aria-pressed="true">Semua</button>
          {zones.map((zone) => (
            <button type="button" class="wheel__chip" data-zone={zone} aria-pressed="false">{zone}</button>
          ))}
        </div>
      </div>
    </div>

    <div class="wheel__viewport">
      <div
        class="wheel__stage"
        data-wheel-stage
        tabindex="0"
        role="group"
        aria-roledescription="carousel"
        aria-label={`Roda ${total} villa The Rain Villas`}
      >
        <div class="wheel__ring" data-wheel-ring>
          <div class="wheel__floor" aria-hidden="true"></div>

          {villas.map((villa, i) => (
            <article
              class="wheel__card"
              data-wheel-card
              data-index={i}
              data-number={i + 1}
              data-name={villa.name}
              data-area={villa.area}
              data-region={villa.region}
              data-bedrooms={villa.bedrooms}
              data-capacity={villa.capacity}
              data-price={villa.priceLabel}
              data-price-old={villa.originalPrice ? `Rp ${villa.originalPrice.toLocaleString('id-ID')}` : ''}
              data-desc={villa.description}
              data-amenities={villa.amenities.slice(0, 7).join(' · ')}
              data-href={`/${slugify(villa.name)}/`}
              data-book={`/booking/?villa=${encodeURIComponent(villa.name)}`}
              data-search={`${villa.name} ${i + 1} ${pad(i + 1)} ${villa.area} ${villa.region}`}
              style={`--i:${i}`}
              aria-label={`${villa.name}, villa ${i + 1} dari ${total}`}
            >
              <span class="wheel__card-shadow" aria-hidden="true"></span>
              <div class="wheel__card-lift">
                <div class="wheel__card-tilt">
                  {[0, 1, 2, 3, 4, 5, 6, 7].map((k) => (
                    <span class="wheel__card-layer" style={`--k:${k}`} aria-hidden="true"></span>
                  ))}
                  <div class="wheel__card-face">
                    <div class="wheel__card-media">
                      <picture>
                        {wheelCovers[i] && (
                          <source media="(max-width: 720px)" srcset={wheelCovers[i].sm} />
                        )}
                        <img
                          src={wheelCovers[i]?.lg ?? villa.image}
                          alt=""
                          width="209"
                          height="290"
                          loading="lazy"
                          decoding="async"
                        />
                      </picture>
                    </div>
                    <span class="wheel__card-number">{pad(i + 1)}</span>
                    <span class="wheel__card-zone">{villa.area}</span>
                    <div class="wheel__card-info">
                      <h3 class="wheel__card-name">{villa.name}</h3>
                      <p class="wheel__card-meta">{villa.bedrooms} kamar · {villa.capacity} tamu</p>
                      <p class="wheel__card-price">
                        {villa.originalPrice && (
                          <s class="wheel__card-old">Rp {villa.originalPrice.toLocaleString('id-ID')}</s>
                        )}
                        <span class="wheel__card-now">{villa.priceLabel}</span>
                      </p>
                    </div>
                    <span class="wheel__card-shade" aria-hidden="true"></span>
                    <span class="wheel__card-fog" aria-hidden="true"></span>
                    <span class="wheel__card-dim" aria-hidden="true"></span>
                    <span class="wheel__card-glare" aria-hidden="true"></span>
                    <span class="wheel__card-hover" aria-hidden="true"></span>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>

    <div class="wheel__controls">
      <button type="button" class="wheel__nav" data-wheel-prev aria-label="Villa sebelumnya">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 5 8 12l7 7"></path>
        </svg>
      </button>
      <p class="wheel__counter" aria-hidden="true">
        <span data-wheel-current>01</span><span class="wheel__counter-total"> / {pad(total)}</span>
      </p>
      <button type="button" class="wheel__nav" data-wheel-next aria-label="Villa berikutnya">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 5 7 7-7 7"></path>
        </svg>
      </button>
    </div>

    <div class="wheel__range-wrap">
      <label class="wheel__sr-only" for="wheelRange">Pilih villa berdasarkan nomor</label>
      <input id="wheelRange" class="wheel__range" data-wheel-range type="range" min="1" max={total} step="1" value="1" />
      <div class="wheel__range-marks" aria-hidden="true"><span>01</span><span>{pad(total)}</span></div>
    </div>

    <div class="wheel__detail" data-wheel-detail aria-live="polite">
      <div class="wheel__detail-main">
        <div class="wheel__detail-top">
          <span class="wheel__detail-num" data-detail-num>01</span>
          <span class="wheel__detail-zone" data-detail-zone>{first.area} · {first.region}</span>
        </div>
        <h3 class="wheel__detail-name" data-detail-name>{first.name}</h3>
        <p class="wheel__detail-desc" data-detail-desc>{first.description}</p>
        <dl class="wheel__detail-facts">
          <div>
            <dt>Kamar</dt>
            <dd data-detail-rooms>{first.bedrooms} kamar</dd>
          </div>
          <div>
            <dt>Kapasitas</dt>
            <dd data-detail-guests>{first.capacity} tamu</dd>
          </div>
          <div>
            <dt>Harga / malam</dt>
            <dd class="wheel__detail-price">
              <s class="wheel__detail-old" data-detail-old hidden={!first.originalPrice}>
                {first.originalPrice ? `Rp ${first.originalPrice.toLocaleString('id-ID')}` : ''}
              </s>
              <span data-detail-price>{first.priceLabel}</span>
            </dd>
          </div>
        </dl>
        <div class="wheel__detail-actions">
          <a class="wheel__cta wheel__cta--primary" data-detail-link href={`/${slugify(first.name)}/`}>Lihat Villa</a>
          <a class="wheel__cta wheel__cta--ghost" data-detail-book href={`/booking/?villa=${encodeURIComponent(first.name)}`}>Booking</a>
          <button type="button" class="wheel__detail-more" data-wheel-more aria-expanded="false" aria-controls="wheelDetailExtra">Detail lengkap</button>
          <button type="button" class="wheel__detail-close" data-wheel-close aria-label="Tutup detail" hidden>✕</button>
        </div>
      </div>
      <div class="wheel__detail-extra" id="wheelDetailExtra">
        <div class="wheel__detail-extra-inner">
          <p class="wheel__detail-extra-label">Fasilitas pilihan</p>
          <p class="wheel__detail-amenities" data-detail-amenities>{first.amenities.slice(0, 7).join(' · ')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Engine 3D (dan animasi intro-nya) baru dimuat saat section mendekati viewport.
  // Dengan begitu first paint & TBT halaman depan tidak terganggu.
  (() => {
    const section = document.getElementById('malam');
    if (!section) return;

    let started = false;
    let observer = null;

    // Muat semua gambar kartu begitu roda hampir terlihat. Lazy-load biasa
    // tidak menjangkau kartu yang posisinya di belakang ring 3D, sehingga
    // beberapa kartu samping tampil kosong saat roda pertama diputar.
    const warmCardImages = () => {
      section.querySelectorAll('.wheel__card-media img').forEach((img) => {
        img.loading = 'eager';
      });
    };

    const start = () => {
      if (started) return;
      started = true;
      if (observer) observer.disconnect();
      warmCardImages();
      import('../../scripts/villaWheel.js')
        .then((mod) => mod.initVillaWheel())
        .catch(() => {});
    };

    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) start();
        },
        { rootMargin: '600px 0px' },
      );
      observer.observe(section);
    } else {
      start();
    }
  })();
</script>

<style>
  .wheel {
    --card-w: 209px;
    --card-h: 290px;
    --radius: 1181.78px;
    --floor-size: 2954.44px;
    --perspective: 1595.4px;
    --step: 11.6129deg;
    --wheel-bg: #f1f6f2;
    --wheel-bg-2: #e5eee8;
    --wheel-ink: #14231f;
    --wheel-sub: #5d6d66;
    --wheel-accent: #2c7a68;
    --wheel-accent-soft: rgba(44, 122, 104, 0.13);
    --wheel-panel: rgba(255, 255, 255, 0.74);
    --wheel-panel-line: rgba(23, 68, 60, 0.13);
    --wheel-floor-line: rgba(23, 68, 60, 0.18);
    --wheel-fog: 241, 246, 242;
    position: relative;
    padding: 92px 0 104px;
    background:
      radial-gradient(70% 52% at 50% 0%, rgba(44, 122, 104, 0.14), transparent 72%),
      linear-gradient(180deg, var(--wheel-bg) 0%, var(--wheel-bg-2) 100%);
    overflow-x: clip;
    isolation: isolate;
  }

  :global(html[data-theme="dark"]) .wheel {
    --wheel-bg: #0a1311;
    --wheel-bg-2: #0f1d19;
    --wheel-ink: #e9f3ee;
    --wheel-sub: #93a8a0;
    --wheel-accent: #63c4a8;
    --wheel-accent-soft: rgba(99, 196, 168, 0.16);
    --wheel-panel: rgba(18, 31, 27, 0.7);
    --wheel-panel-line: rgba(180, 220, 205, 0.15);
    --wheel-floor-line: rgba(180, 220, 205, 0.2);
    --wheel-fog: 10, 19, 17;
  }

  .wheel__inner {
    position: relative;
  }

  .wheel__head {
    max-width: 660px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .wheel__eyebrow {
    display: inline-block;
    margin-bottom: 12px;
    color: var(--wheel-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 3.4px;
    text-transform: uppercase;
  }

  .wheel__title {
    margin: 0 0 12px;
    color: var(--wheel-ink);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.6vw, 3.05rem);
    font-weight: 700;
    line-height: 1.05;
  }

  .wheel__sub {
    margin: 0;
    color: var(--wheel-sub);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .wheel__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 30px;
    max-width: 1010px;
    margin: 0 auto 8px;
  }

  .wheel__search {
    flex: 1 1 280px;
    min-width: 0;
    max-width: 430px;
  }

  .wheel__search-label {
    display: block;
    margin-bottom: 7px;
    color: var(--wheel-sub);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .wheel__search-box {
    display: flex;
    align-items: center;
    gap: 9px;
    height: 46px;
    padding: 0 14px;
    border: 1px solid var(--wheel-panel-line);
    border-radius: 999px;
    background: var(--wheel-panel);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .wheel__search-box:focus-within {
    border-color: var(--wheel-accent);
    box-shadow: 0 0 0 4px var(--wheel-accent-soft);
  }

  .wheel__search-box svg {
    flex-shrink: 0;
    color: var(--wheel-sub);
  }

  .wheel__search-box input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--wheel-ink);
    font: inherit;
    font-size: 0.9rem;
  }

  .wheel__search-box input::placeholder {
    color: var(--wheel-sub);
    opacity: 0.8;
  }

  .wheel__search-box input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .wheel__search-clear {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--wheel-sub);
    font-size: 0.76rem;
    line-height: 1;
    cursor: pointer;
  }

  .wheel__search-clear:hover {
    background: var(--wheel-accent-soft);
    color: var(--wheel-ink);
  }

  .wheel__results {
    min-height: 1.2em;
    margin: 8px 2px 0;
    color: var(--wheel-sub);
    font-size: 0.74rem;
    line-height: 1.45;
  }

  .wheel__zones {
    display: flex;
    flex: 1 1 100%;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .wheel__zones-label {
    flex-shrink: 0;
    color: var(--wheel-sub);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .wheel__chips {
    display: flex;
    gap: 8px;
    padding: 4px 2px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .wheel__chips::-webkit-scrollbar {
    display: none;
  }

  .wheel__chip {
    flex: 0 0 auto;
    padding: 7px 13px;
    border: 1px solid var(--wheel-panel-line);
    border-radius: 999px;
    background: var(--wheel-panel);
    color: var(--wheel-sub);
    font: inherit;
    font-size: 0.73rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .wheel__chip:hover {
    border-color: var(--wheel-accent);
    color: var(--wheel-ink);
  }

  .wheel__chip[aria-pressed="true"] {
    border-color: var(--wheel-accent);
    background: var(--wheel-accent);
    color: #ffffff;
  }

  :global(html[data-theme="dark"]) .wheel__chip[aria-pressed="true"] {
    color: #07130f;
  }

  .wheel__viewport {
    position: relative;
    margin-top: 8px;
    opacity: 0;
    animation: wheel-fade-in 1s ease 0.08s forwards;
  }

  @keyframes wheel-fade-in {
    to {
      opacity: 1;
    }
  }

  .wheel__stage {
    position: relative;
    height: 540px;
    perspective: var(--perspective);
    perspective-origin: 50% 22%;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
  }

  .wheel__stage:active {
    cursor: grabbing;
  }

  .wheel__stage:focus-visible {
    border-radius: 26px;
    outline: 3px solid var(--wheel-accent);
    outline-offset: 2px;
  }

  .wheel--dragging {
    cursor: grabbing;
  }

  .wheel__ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--radius) * -1)) rotateY(var(--rot, 0deg));
  }

  .wheel__floor {
    position: absolute;
    top: calc(var(--card-h) / 2 - var(--floor-size) / 2);
    left: calc(var(--floor-size) / -2);
    width: var(--floor-size);
    height: var(--floor-size);
    border-radius: 50%;
    transform: rotateX(90deg);
    pointer-events: none;
    background-image:
      repeating-conic-gradient(
        from calc(180deg - 0.45deg),
        var(--wheel-floor-line) 0deg 0.9deg,
        transparent 0.9deg var(--step)
      ),
      radial-gradient(circle closest-side, transparent calc(49% - 1px), var(--wheel-floor-line) calc(49% - 1px) calc(49% + 1px), transparent calc(49% + 1px)),
      radial-gradient(circle closest-side, transparent calc(79% - 1px), var(--wheel-floor-line) calc(79% - 1px) calc(79% + 1px), transparent calc(79% + 1px)),
      radial-gradient(circle closest-side, var(--wheel-accent-soft) 0 18%, transparent 34%);
    -webkit-mask-image:
      radial-gradient(circle closest-side, #000 0 76%, rgba(0, 0, 0, 0.55) 90%, transparent 100%),
      linear-gradient(180deg, transparent 0%, #000 36%, #000 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(circle closest-side, #000 0 76%, rgba(0, 0, 0, 0.55) 90%, transparent 100%),
      linear-gradient(180deg, transparent 0%, #000 36%, #000 100%);
    mask-composite: intersect;
  }

  .wheel__card {
    position: absolute;
    top: calc(var(--card-h) / -2);
    left: calc(var(--card-w) / -2);
    width: var(--card-w);
    height: var(--card-h);
    transform: rotateY(calc(var(--i) * var(--step))) translateZ(var(--radius));
    transform-style: preserve-3d;
  }

  .wheel__card-lift {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--lift, 0) * 1px));
  }

  .wheel__card-tilt {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateZ(var(--hover-z, 0px));
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wheel__card--tilt .wheel__card-tilt {
    transition-duration: 0.18s;
  }

  .wheel__stage:focus-visible .wheel__card--active .wheel__card-tilt {
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateZ(calc(var(--hover-z, 0px) + 16px));
  }

  .wheel__card-layer {
    position: absolute;
    inset: 0;
    border-radius: 18px;
    transform: translateZ(calc(var(--k) * -2px));
    background: hsl(calc(176 - var(--k) * 2.2), 38%, calc(36% - var(--k) * 2.6%));
    opacity: var(--side, 1);
    transition: opacity 0.25s ease;
  }

  .wheel__card-face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 18px;
    background: linear-gradient(160deg, #1b554a, #0a2621 72%);
    transform: translateZ(0.5px);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: 0 0 0 1px rgba(7, 28, 23, 0.4);
  }

  .wheel__card-face::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(4, 16, 13, 0) 0%,
      rgba(4, 16, 13, 0) 38%,
      rgba(4, 16, 13, 0.7) 74%,
      rgba(4, 16, 13, 0.95) 100%
    );
    pointer-events: none;
  }

  .wheel__card-face::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 8;
    border-radius: inherit;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.48);
    pointer-events: none;
  }

  .wheel__card--active .wheel__card-face {
    box-shadow:
      0 0 0 2px rgba(168, 235, 216, 0.8),
      0 0 34px rgba(80, 200, 168, 0.3);
  }

  .wheel__card-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .wheel__card-media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .wheel__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: center;
  }

  .wheel__card-number,
  .wheel__card-zone {
    position: absolute;
    top: 10px;
    z-index: 3;
    padding: 4px 8px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    background: rgba(5, 22, 18, 0.52);
    color: #f1fbf7;
    font-size: 0.59rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .wheel__card-number {
    left: 10px;
  }

  .wheel__card-zone {
    right: 10px;
    max-width: 104px;
    overflow: hidden;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wheel__card-info {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    padding: 12px 13px 14px;
    color: #f4fbf8;
  }

