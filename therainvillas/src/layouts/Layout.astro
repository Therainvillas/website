---
import '../styles/global.css';
// Font di-host sendiri (paket Fontsource) supaya tidak ada request ke
// fonts.googleapis.com / fonts.gstatic.com yang menambah 2 round-trip TLS
// sebelum teks bisa memakai font aslinya. Berkasnya identik dengan Google Fonts.
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/work-sans/wght.css';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/dancing-script/wght.css';
import '@fontsource-variable/cinzel/wght.css';
// Dua font yang dipakai di layar pertama: preload agar tidak menunggu CSS.
import interLatinUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import cinzelLatinUrl from '@fontsource-variable/cinzel/files/cinzel-latin-wght-normal.woff2?url';
import FlashSalePopup from '../components/FlashSalePopup.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Gambar hero halaman ini (varian kecil & besar) — akan di-preload. */
  preloadImage?: { sm?: string; lg?: string };
  /** Preload gambar responsif (mis. poster hero) dengan srcset agar LCP tidak menunggu parse. */
  preloadSrcset?: { srcset: string; sizes?: string }[];
  ogType?: string;
  noindex?: boolean;
  jsonLd?: object[];
}

const {
  title = 'Sewa Villa Murah di Puncak, Private Pool & View Mewah | The Rain Villas',
  description = 'Cari sewa villa murah di Puncak untuk keluarga & gathering? Tersedia 30+ pilihan villa private pool kapasitas 20-50 orang. Booking aman, harga transparan!',
  image = '/Agave/Cover.webp',
  preloadImage,
  preloadSrcset,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const siteRoot = Astro.site ?? new URL('https://therainvillas.com/');
const canonicalUrl = new URL(Astro.url.pathname, siteRoot).href;
const shareImage = new URL(image, siteRoot).href;
const isHome = Astro.url.pathname === '/';
const isAdminRoute = /^\/admin(\/|$)/.test(Astro.url.pathname);

// Satu gtag.js saja (milik Google Ads). GA4 dikirim lewat config tambahan di
// blok yang sama, jadi tidak ada permintaan kedua ke googletagmanager.com.
// PUBLIC_GA_ID dipakai bila tersedia; fallback di bawah menjaga tag tetap
// terkirim pada build server yang tidak menyetel environment variable.
const gaId = import.meta.env.PUBLIC_GA_ID || 'G-7VMR5WEJP2';
const gaConfig = import.meta.env.PROD ? `\n  gtag('config', ${JSON.stringify(gaId)});` : '';
const gaBootstrap = `
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  gtag('js', new Date());
  gtag('config', 'AW-18476533015');${gaConfig}
`;
---

<!DOCTYPE html>
<html lang="id" class="no-js">
  <head>
    <meta charset="utf-8" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/markdown" href="/" title="Markdown version" />
    <link rel="llms-txt" href="/llms.txt" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <script is:inline>
      // gtag.js (195 KiB) tidak dimuat saat idle setelah load karena eksekusinya
      // bisa menjadi long task setelah FCP. Muat saat interaksi pertama; pengguna
      // yang pasif tetap dilayani lewat fallback jauh setelah load.
      // Perintah gtag(...) di bawah tetap mengantre di dataLayer sampai siap.
      (function () {
        var loaded = false;
        var timer = 0;
        function loadGtag() {
          if (loaded) return;
          loaded = true;
          if (timer) clearTimeout(timer);
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=AW-18476533015';
          document.head.appendChild(s);
        }
        function schedule() {
          timer = window.setTimeout(loadGtag, 15000);
        }
        if (document.readyState === 'complete') schedule();
        else window.addEventListener('load', schedule, { once: true });
        ['pointerdown', 'keydown', 'touchstart', 'wheel'].forEach(function (ev) {
          window.addEventListener(ev, loadGtag, { once: true, passive: true });
        });
      })();
    </script>
    <script is:inline set:html={gaBootstrap}></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#11120f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interLatinUrl}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={cinzelLatinUrl}
      crossorigin
    />

    {preloadImage?.sm && (
      <link rel="preload" as="image" href={preloadImage.sm} media="(max-width: 768px)" fetchpriority="high" />
    )}
    {preloadImage?.lg && (
      <link rel="preload" as="image" href={preloadImage.lg} media="(min-width: 769px)" fetchpriority="high" />
    )}
    {preloadSrcset?.map((preload) => (
      <link
        rel="preload"
        as="image"
        imagesrcset={preload.srcset}
        imagesizes={preload.sizes ?? '100vw'}
        fetchpriority="high"
      />
    ))}

    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="The Rain Villas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("therainvillas_theme");
          var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (t === "dark" || (!t && prefersDark)) {
            document.documentElement.setAttribute("data-theme", "dark");
          } else {
            document.documentElement.setAttribute("data-theme", "light");
          }
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "The Rain Villas",
      "url": "https://therainvillas.com",
      "description": description,
      "inLanguage": "id",
    })} />
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": ["Organization", "LocalBusiness"],
        "name": "The Rain Villas",
        "url": "https://therainvillas.com",
        "logo": "https://therainvillas.com/logo%20trv2.png",
        "telephone": "+6282125492037",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Kp. Ciburial Cibarengkok, RT.01 RW.05, Tugu Utara",
          "addressLocality": "Cisarua",
          "addressRegion": "Jawa Barat",
          "postalCode": "16750",
          "addressCountry": "ID"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+6282125492037",
          "contactType": "customer service",
          "areaServed": "ID",
          "availableLanguage": "Indonesian",
        },
        "sameAs": [
          "https://www.instagram.com/therainvillas",
          "https://www.tiktok.com/@therainvillas",
          "https://wa.me/6282125492037"
        ]
      })} />
    )}
    {jsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <slot />
    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -20px 0px' });

      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      });
    </script>
    <script>
      // Ikon SVG eksternal (<use href="/icon/svg/...">) diunduh browser
      // walaupun bagiannya masih jauh di bawah lipatan. Setiap berkas berisi
      // dua gambar base64 (~20 KB), jadi 19 ikon = ~190 KB di jalur kritis.
      // href baru dipasang saat bagiannya mendekati viewport.
      const lazyIcons = Array.from(document.querySelectorAll('use[data-icon-href]'));
      if (lazyIcons.length) {
        const iconsByHost = new Map();
        lazyIcons.forEach((use) => {
          const host = use.closest('section, footer, article');
          if (!host) return;
          if (!iconsByHost.has(host)) iconsByHost.set(host, []);
          iconsByHost.get(host).push(use);
        });

        const loadIcons = (uses) => {
          uses.forEach((use) => {
            if (!use.hasAttribute('href')) {
              use.setAttribute('href', use.getAttribute('data-icon-href'));
            }
          });
        };

        if ('IntersectionObserver' in window) {
          const iconObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              loadIcons(iconsByHost.get(entry.target) || []);
              iconObserver.unobserve(entry.target);
            });
          }, { rootMargin: '200px 0px' });
          iconsByHost.forEach((_, host) => iconObserver.observe(host));
        } else {
          iconsByHost.forEach((uses) => loadIcons(uses));
        }
      }
    </script>
    <script>
      import '../scripts/analytics.js';
      import '../scripts/cardTilt.js';
    </script>
    {!isAdminRoute && <FlashSalePopup />}
  </body>
</html>
