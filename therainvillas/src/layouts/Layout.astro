---
import '../styles/global.css';
import PromoPopup from '../components/PromoPopup.vue';
import { promos, isPromoActive } from '../data/promos.js';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Gambar hero halaman ini (varian kecil & besar) — akan di-preload. */
  preloadImage?: { sm?: string; lg?: string };
  ogType?: string;
  noindex?: boolean;
  jsonLd?: object[];
}

const {
  title = 'Sewa Villa Murah di Puncak, Private Pool & View Mewah | The Rain Villas',
  description = 'Cari sewa villa murah di Puncak untuk keluarga & gathering? Tersedia 30+ pilihan villa private pool kapasitas 20-50 orang. Booking aman, harga transparan!',
  image = '/Agave/Cover.webp',
  preloadImage,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const siteRoot = Astro.site ?? new URL('https://therainvillas.com/');
const canonicalUrl = new URL(Astro.url.pathname, siteRoot).href;
const shareImage = new URL(image, siteRoot).href;
const isHome = Astro.url.pathname === '/';

// Popup promo muncul ~0,7 s setelah halaman tampil dan gambarnya jadi elemen
// LCP di halaman yang heronya memakai CSS background (background CSS tidak
// dihitung sebagai LCP). Preload supaya gambarnya tidak baru diminta telat.
const promoAktif =
  !Astro.url.pathname.startsWith('/admin') && promos.some((p) => isPromoActive(p));

// Satu gtag.js saja (milik Google Ads). GA4 dikirim lewat config tambahan di
// blok yang sama, jadi tidak ada permintaan kedua ke googletagmanager.com.
// PUBLIC_GA_ID dipakai bila tersedia; fallback di bawah menjaga tag tetap
// terkirim pada build server yang tidak menyetel environment variable.
const gaId = import.meta.env.PUBLIC_GA_ID || 'G-7VMR5WEJP2';
const gaConfig = import.meta.env.PROD ? `\n  gtag('config', ${JSON.stringify(gaId)});` : '';
const gaBootstrap = `
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  gtag('js', new Date());
  gtag('config', 'AW-18476533015');${gaConfig}
`;
---

<!DOCTYPE html>
<html lang="id" class="no-js">
  <head>
    <meta charset="utf-8" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <script is:inline>
      // gtag.js (195 KiB) baru diunduh setelah halaman selesai dimuat / saat
      // interaksi pertama, supaya tidak berebut bandwidth & CPU dengan konten.
      // Perintah gtag(...) di bawah tetap mengantre di dataLayer sampai siap.
      (function () {
        var loaded = false;
        function loadGtag() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=AW-18476533015';
          document.head.appendChild(s);
        }
        function schedule() {
          if ('requestIdleCallback' in window) requestIdleCallback(loadGtag, { timeout: 3000 });
          else setTimeout(loadGtag, 1200);
        }
        if (document.readyState === 'complete') schedule();
        else window.addEventListener('load', schedule, { once: true });
        ['pointerdown', 'keydown', 'touchstart', 'wheel'].forEach(function (ev) {
          window.addEventListener(ev, loadGtag, { once: true, passive: true });
        });
      })();
    </script>
    <script is:inline set:html={gaBootstrap}></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#11120f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/logo%20trv2.png" />

    <link rel="apple-touch-icon" href="/logo%20trv2.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Work+Sans:wght@500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,750&family=Dancing+Script:wght@600;700&family=Cinzel:wght@400;500;600;700;800;900&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Work+Sans:wght@500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,750&family=Dancing+Script:wght@600;700&family=Cinzel:wght@400;500;600;700;800;900&display=swap" />
    </noscript>

    {preloadImage?.sm && (
      <link rel="preload" as="image" href={preloadImage.sm} media="(max-width: 768px)" fetchpriority="high" />
    )}
    {preloadImage?.lg && (
      <link rel="preload" as="image" href={preloadImage.lg} media="(min-width: 769px)" fetchpriority="high" />
    )}

    {promoAktif && (
      <link rel="preload" as="image" href="/promo/promo oktober.webp" fetchpriority="low" />
    )}

    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="The Rain Villas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("therainvillas_theme");
          var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (t === "dark" || (!t && prefersDark)) document.documentElement.setAttribute("data-theme", "dark");
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "The Rain Villas",
      "url": "https://therainvillas.com",
      "description": description,
      "inLanguage": "id",
    })} />
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "The Rain Villas",
        "url": "https://therainvillas.com",
        "logo": "https://therainvillas.com/logo%20trv2.png",
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+6282125492037",
          "contactType": "customer service",
          "areaServed": "ID",
          "availableLanguage": "Indonesian",
        },
      })} />
    )}
    {jsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <slot />
    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -20px 0px' });

      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      });
    </script>
    <script>
      import '../scripts/analytics.js';
    </script>
    <PromoPopup client:load />
  </body>
</html>
