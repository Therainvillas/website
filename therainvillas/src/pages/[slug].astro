---

<Layout title={`${villa.name} | The Rain Villas`} description={villa.description} image={heroImage} jsonLd={villaJsonLd} showPromo={false}>
  <main class="villa-detail">
    <section class="vd-showcase" id="top">
      <div class="vd-showcase__media">
        <img src={heroImage} alt={villa.name} class="vd-showcase__image" />
      </div>
      <div class="vd-showcase__shade"></div>

      <nav class="vd-nav" aria-label="Navigasi detail villa">
        <div class="vd-nav__pills">
          <a href="/" class="vd-nav__pill vd-nav__pill--active">Beranda</a>
          <a href="/our-villas" class="vd-nav__pill">Villa</a>
          <a href="#gallery" class="vd-nav__pill">Foto</a>
          <a href="#facilities" class="vd-nav__pill">Fasilitas</a>
          <a href="#booking" class="vd-nav__pill">Booking</a>
        </div>

        <a href="/" class="vd-brand" aria-label="The Rain Villas home">
          <span class="vd-brand__mark" aria-hidden="true">
            <img src="/logo%20trv2.png" alt="" />
          </span>
          <span class="vd-brand__name">The Rain Villas</span>
        </a>

        <div class="vd-nav__actions">
          <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="nofollow" class="vd-nav__contact">Kontak</a>
          <a href={waLink} target="_blank" rel="nofollow" class="vd-nav__order">Reservasi <span aria-hidden="true">&rarr;</span></a>
        </div>
      </nav>

      <div class="vd-hero">
        <div class="vd-hero__eyebrow">
          <span>The Rain Villas</span>
          <span>Private Collection</span>
        </div>

        <h1 class={titleClass}>{heroWord}</h1>
        <p class="vd-hero__script">{scriptWord}</p>

        <div class="vd-hero__sub">
          <p>{meta.tone}</p>
          <span aria-hidden="true"></span>
          <p>{meta.location}</p>
        </div>
      </div>

      <div class="vd-property glass">
        <div class="vd-property__top">
          <div>
            <h4>{villa.name}</h4>
            <span class="vd-property__addr">
              <svg class="icon" viewBox="0 0 24 24"><path d="M12 21s7-6.5 7-11a7 7 0 1 0-14 0c0 4.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.4"/></svg>
              {meta.location} • {meta.area}
            </span>
          </div>
          <a href={waLink} target="_blank" rel="nofollow" class="vd-property__round" aria-label="Pesan sekarang">
            <svg viewBox="0 0 24 24" width="16" height="16"><path d="M7 17L17 7M17 7H9M17 7v8"/></svg>
          </a>
        </div>

        <p class="vd-property__desc">{villa.description}</p>

        <div class="vd-property__stats">
          <span>
            <svg class="icon" viewBox="0 0 24 24"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"/></svg>
            {meta.area}
          </span>
          <span>
            <svg class="icon" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
            {villa.bedrooms} bedrooms
          </span>
          <span>
            <svg class="icon" viewBox="0 0 24 24"><path d="M4 12h16v2.5A4.5 4.5 0 0 1 15.5 19h-7A4.5 4.5 0 0 1 4 14.5V12z"/><path d="M4 12V6.5A1.5 1.5 0 0 1 5.5 5h1M9 5.2a1 1 0 1 1 2 0"/></svg>
            {villa.bathrooms} baths
          </span>
          <span>
            <svg class="icon" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg>
            {villa.capacity} guests
          </span>
        </div>

        {villa.pricingLabels && (
          <div class="vd-property__prices">
            {villa.pricingLabels.map((row) => (
              <div class="vd-property__price">
                <span>{row.label}</span>
                <strong>Rp {row.price.toLocaleString('id-ID')}</strong>
              </div>
            ))}
          </div>
        )}

        <a href="#booking" class="vd-property__cta">Pesan Sekarang</a>
      </div>

      <div class="vd-stat glass">
        <div>
          <div class="vd-stat__num">{villa.capacity}<small>+</small></div>
          <div class="vd-stat__lbl">Tamu Maksimal</div>
        </div>
        <div class="vd-stat__meta">
          <span>Mulai dari</span>
          <strong>{villa.priceLabel}</strong>
        </div>
      </div>


    </section>

    <section class="vd-overview section" id="booking">
      <div class="container vd-overview__grid">
        <div class="vd-overview__content">
          <p class="vd-section-label reveal">Detail Villa</p>
          <h2 class="vd-overview__title reveal reveal--delay-1">{villa.name}</h2>
          <p class="vd-overview__lead reveal reveal--delay-2">
            {villa.description} Setiap area dibuat untuk liburan yang tenang, foto yang cantik, dan waktu berkumpul yang nyaman.
          </p>

          {villa.pricingLabels && (
            <div class="vd-prices reveal reveal--delay-3">
              {villa.pricingLabels.map((row) => (
                <div class="vd-spec vd-spec--price">
                  <span class="vd-spec__label">{row.label}</span>
                  <strong class="vd-spec__price">Rp {row.price.toLocaleString('id-ID')}</strong>
                  <span class="vd-spec__pernight">/malam</span>
                </div>
              ))}
            </div>
          )}

          <div class="vd-specs reveal reveal--delay-3">
            <div class="vd-spec">
              <span class="vd-spec__label">Kapasitas</span>
              <strong>{villa.capacity} orang</strong>
            </div>
            <div class="vd-spec">
              <span class="vd-spec__label">Kamar tidur</span>
              <strong>{villa.bedrooms} kamar{villa.bedroomsNote ? ` (${villa.bedroomsNote})` : ''}</strong>
            </div>
            <div class="vd-spec">
              <span class="vd-spec__label">Kamar mandi</span>
              <strong>{villa.bathrooms} kamar</strong>
            </div>
            <div class="vd-spec">
              <span class="vd-spec__label">Parkir</span>
              <strong>{villa.parking} mobil</strong>
            </div>
          </div>

          {villa.capacityNote && (
            <p class="vd-capacity-note reveal reveal--delay-3">ℹ️ {villa.capacityNote}</p>
          )}

          <div class="vd-facilities reveal reveal--delay-4" id="facilities">
            <div class="vd-section-head">
              <p class="vd-section-label">Fasilitas</p>
              <h3>Yang tersedia di {villa.name}</h3>
            </div>
            <div class="vd-facilities__grid">
              {villa.amenities.map((amenity) => (
                <span>{amenity}</span>
              ))}
            </div>
          </div>

          <div class="vd-location reveal reveal--delay-4" id="lokasi">
            <p class="vd-section-label">Lokasi</p>
            <h3>Akses mudah dari Jakarta & Bandung</h3>
            <div class="vd-location__grid">
              <div class="vd-location__map">
                <LocationMap client:load villaId={villa.id} />
              </div>
              <div class="vd-location__info">
                <div class="vd-location__item">
                  <span class="vd-location__item-icon">📍</span>
                  <div>
                    <h4>Kp. Ciburial, Cisarua, Puncak</h4>
                    <p>Desa Tugu Utara, Kec. Cisarua, Kab. Bogor, Jawa Barat 16750</p>
                  </div>
                </div>
                <div class="vd-location__item">
                  <span class="vd-location__item-icon">🚗</span>
                  <div>
                    <h4>~90 menit dari Jakarta</h4>
                    <p>Akses tol via Ciawi</p>
                  </div>
                </div>
                <div class="vd-location__item">
                  <span class="vd-location__item-icon">⛰️</span>
                  <div>
                    <h4>Ketinggian ~800 mdpl</h4>
                    <p>Udara sejuk & pemandangan indah</p>
                  </div>
                </div>
                {mapsUrl && (
                  <a href={mapsUrl} target="_blank" rel="nofollow" class="vd-location__btn">
                    Buka Google Maps
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>

        <aside class="vd-booking reveal reveal--right" aria-label="Booking villa">
          <p class="vd-booking__label">Mulai dari</p>
          <h3>{villa.priceLabel}</h3>
          <p class="vd-booking__desc">per malam, konfirmasi jadwal dan paket melalui WhatsApp.</p>

          <div class="vd-booking__rows">
            <span>{villa.capacity} tamu maksimal</span>
            <span>{villa.bedrooms} kamar tidur</span>
            <span>{villa.bathrooms} kamar mandi</span>
            <span>🅿️ {villa.parking} parkir mobil</span>
          </div>

          {villa.pricingLabels && (
            <div class="vd-booking__pricing">
              {villa.pricingLabels.map((row) => (
                <span class="vd-booking__price-row">
                  <span class="vd-booking__price-day">{row.label}</span>
                  <span class="vd-booking__price-amount">Rp {row.price.toLocaleString('id-ID')}</span>
                </span>
              ))}
            </div>
          )}

          <a href={waLink} target="_blank" rel="nofollow" class="vd-booking__button">Pesan Sekarang</a>
          <a href="/availability" class="vd-booking__link">Cek kalender semua villa &rarr;</a>

          <div class="vd-calendar">
            <h4>Ketersediaan</h4>
            <CalendarPicker client:load initialVillaId={villa.id} />
          </div>
        </aside>
      </div>
    </section>

    <div class="vd-sorotan">
      <div class="container">
        <VillaSorotan client:load images={galleryImages} villaName={villa.name} />
      </div>
    </div>

    <section class="vd-reviews section" id="ulasan">
      <div class="container">
        <div class="vd-reviews__head reveal">
          <p class="vd-section-label" style="color:#7f5f38">Ulasan</p>
          <h2>Pengalaman di {villa.name}</h2>
        </div>
        <div class="vd-reviews__body reveal reveal--delay-1">
          <VillaReviews client:load villaId={villa.id} villaName={villa.name} />
        </div>
      </div>
    </section>

    <section class="vd-gallery-section section" id="gallery">
      <div class="container">
        <div class="vd-gallery-head reveal">
          <p class="vd-section-label">Galeri</p>
          <h2>Foto {villa.name}</h2>
        </div>

        <div class="vd-gallery">
          {galleryImages.map((image, index) => (
            <figure class={`vd-gallery__item ${index === 0 ? 'vd-gallery__item--featured' : ''}`}>
              <img src={image} alt={`${villa.name} foto ${index + 1}`} loading={index === 0 ? 'eager' : 'lazy'} />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="vd-more section">
      <div class="container">
        <div class="vd-more__head reveal">
          <p class="vd-section-label">Rekomendasi</p>
          <h2>Villa Lainnya</h2>
        </div>

        <div class="vd-more__grid">
          {otherVillas.map((item, i) => (
            <div class={`reveal reveal--delay-${Math.min(i + 1, 4)}`}>
              <VillaCard {...item} price={item.priceLabel} />
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <WhatsAppBubble />
</Layout>

<style>
  .villa-detail {
    min-height: 100vh;
    background: #11120f;
    color: #f4ede3;
    font-family: var(--font-primary);
    overflow-x: hidden;
  }

  .vd-showcase {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #1b1d22;
    isolation: isolate;
  }

  .vd-showcase__media,
  .vd-showcase__shade {
    position: absolute;
    inset: 0;
  }

  .vd-showcase__media {
    z-index: -2;
    background: #1b1d22;
  }

  .vd-showcase__image {
    width: 100%;
    height: 100%;
    min-height: 100svh;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.05) brightness(0.72);
  }

  .vd-showcase__shade {
    z-index: -1;
    background:
      linear-gradient(115deg, rgba(8,10,20,.66) 0%, rgba(8,10,20,.3) 34%, rgba(8,10,20,0) 58%),
      linear-gradient(180deg, rgba(0,0,0,.3) 0%, rgba(0,0,0,0) 30%),
      linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(0,0,0,.55) 100%);
  }

  /* ===== shared glass (glassmorphism) ===== */
  .vd-showcase .glass {
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.34);
    box-shadow:
      0 40px 70px rgba(20, 20, 30, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    color: #ffffff;
  }
  .vd-showcase .glass::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(145deg, rgba(255,255,255,.18) 0%, rgba(255,255,255,0) 42%);
  }
  .vd-showcase .icon {
    width: 15px;
    height: 15px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: block;
    flex-shrink: 0;
  }

  .vd-sorotan {
    position: relative;
    z-index: 2;
    background: linear-gradient(180deg, #15161b 0%, #11120f 100%);
    padding: clamp(30px, 5vh, 52px) 0 clamp(10px, 2vh, 22px);
  }

  .vd-sorotan .container {
    max-width: 1320px;
  }

  /* ===== top bar ===== */
  .vd-nav {
    position: absolute;
    top: 4%;
    left: 4%;
    right: 4%;
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .vd-nav__pills {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    border-radius: 999px;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 6px 20px rgba(20,20,30,.10);
    overflow-x: auto;
  }

  .vd-nav__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    color: #57544d;
    transition: background .18s ease, color .18s ease;
  }

  .vd-nav__pill:hover {
    color: #141519;
  }

  .vd-nav__pill--active {
    background: #141519;
    color: #fff;
  }

  .vd-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #fff;
    padding: 8px 14px;
    border-radius: 12px;
    background: rgba(20,21,25,.32);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .vd-brand__mark {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vd-brand__mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .vd-brand__name {
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.98;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .vd-nav__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .vd-nav__contact,
  .vd-nav__order {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0 20px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: transform .18s ease, box-shadow .18s ease;
  }

  .vd-nav__contact {
    color: #fff;
  }

  .vd-nav__order {
    gap: 8px;
    color: #fff;
    background: #141519;
    box-shadow: 0 6px 18px rgba(20,20,30,.18);
  }

  .vd-nav__contact:hover,
  .vd-nav__order:hover {
    transform: translateY(-2px);
  }

  /* ===== hero ===== */
  .vd-hero {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .vd-hero__eyebrow {
    position: absolute;
    top: 16%;
    left: 14.5%;
    display: grid;
    gap: 4px;
    color: rgba(255,255,255,.72);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .vd-hero__title {
    position: absolute;
    left: 14.5%;
    top: 21%;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6.4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    word-break: break-word;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgba(0,0,0,.28), 0 10px 40px rgba(0,0,0,.25);
  }

  .vd-hero__title--compact {
    font-size: clamp(2.7rem, 6.2vw, 5.8rem);
  }

  .vd-hero__script {
    position: absolute;
    left: 15.5%;
    top: 44%;
    color: rgba(255,255,255,.92);
    font-family: var(--font-cursive);
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    font-weight: 600;
    line-height: 1;
    text-shadow: 0 6px 20px rgba(0,0,0,.38);
  }

  .vd-hero__sub {
    position: absolute;
    left: 14.5%;
    bottom: 34%;
    display: flex;
    align-items: center;
    gap: 14px;
    color: rgba(255,255,255,.88);
  }
  .vd-hero__sub p {
    font-size: clamp(0.8rem, 1.1vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    margin: 0;
  }
  .vd-hero__sub span {
    width: 34px;
    height: 1px;
    background: rgba(255,255,255,.55);
  }

  /* ===== property card ===== */
  .vd-property {
    position: absolute;
    right: 4%;
    bottom: 5%;
    z-index: 5;
    width: 38%;
    border-radius: 24px;
    padding: 22px;
  }

  .vd-property__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .vd-property__top h4 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .vd-property__addr {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 5px;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.78);
    font-weight: 500;
  }
  .vd-property__addr .icon {
    width: 12px;
    height: 12px;
    color: rgba(255, 255, 255, 0.85);
  }

  .vd-property__round {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    text-decoration: none;
    transition: transform .18s ease, background .18s ease;
  }
  .vd-property__round:hover {
    transform: scale(1.08) rotate(8deg);
    background: rgba(255, 255, 255, 0.4);
  }

  .vd-property__desc {
    margin: 12px 0 0;
    font-size: 0.82rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 500;
    text-shadow: 0 1px 2px rgba(0,0,0,0.25);
  }

  .vd-property__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.28);
  }
  .vd-property__stats span {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.92);
  }
  .vd-property__stats .icon {
    color: rgba(255, 255, 255, 0.7);
  }

  .vd-property__prices {
    display: grid;
    gap: 8px;
    margin-top: 14px;
    padding: 14px;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 14px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .vd-property__price {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.9);
  }
  .vd-property__price strong {
    font-size: 0.88rem;
    color: #fff;
    white-space: nowrap;
  }

  .vd-property__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 46px;
    margin-top: 14px;
    border-radius: 999px;
    background: linear-gradient(135deg, #5b8def, #7a5ce0);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
    letter-spacing: 0;
    box-shadow: 0 10px 24px rgba(91,141,239,.3);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .vd-property__cta:hover {
    transform: translateY(-2px);
  }

  /* ===== stat card ===== */
  .vd-stat {
    position: absolute;
    left: 4%;
    bottom: 5%;
    z-index: 5;
    width: 24%;
    border-radius: 24px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .vd-stat__num {
    font-size: 2rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
  }
  .vd-stat__num small {
    font-size: 1rem;
    color: #a8c3ff;
  }
  .vd-stat__lbl {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.8);
    font-weight: 600;
    margin-top: 4px;
  }
  .vd-stat__meta {
    display: flex;
    flex-direction: column;
