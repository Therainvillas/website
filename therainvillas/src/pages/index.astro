---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Slide01Hero from '../components/journey/Slide01Hero.astro';

import Slide03Evening from '../components/journey/Slide03Evening.astro';
import Slide04Booking from '../components/journey/Slide04Booking.astro';
import CaraBooking from '../components/journey/CaraBooking.astro';
import Himbauan from '../components/journey/Himbauan.astro';
import LocationSection from '../components/LocationSection.astro';
import ReviewsMarquee from '../components/ReviewsMarquee.astro';
import SatisfactionForm from '../components/SatisfactionForm.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBubble from '../components/WhatsAppBubble.astro';
import VillaCard from '../components/VillaCard.astro';
import { villas } from '../data/villas';

const allVillas = villas;

const homeFaq = [
  {
    q: 'Bagaimana cara booking villa di The Rain Villas?',
    a: 'Cek ketersediaan di story Instagram @therainvillas atau hubungi admin melalui WhatsApp 0821-2549-2037, lalu isi formulir booking. DP minimal 30% dari harga villa, pelunasan wajib H-3 sebelum check-in, dan reschedule maksimal H-7 sebelum tanggal check-in dengan penambahan DP.',
  },
  {
    q: 'Apakah DP bisa di-refund jika batal?',
    a: 'Tidak. DP tidak bisa di-refund dalam kondisi apapun. Jika pelunasan tidak dilakukan H-3 sebelum check-in, uang DP dianggap hangus.',
  },
  {
    q: 'Bagaimana cara cek ketersediaan tanggal?',
    a: 'Buka halaman Cek Ketersediaan untuk melihat kalender semua villa sekaligus, atau tanyakan langsung ke admin via WhatsApp 0821-2549-2037.',
  },
  {
    q: 'Berapa jam check-out dan bagaimana jadwal survey?',
    a: 'Check-out wajib dilakukan pukul 12.00; lebih dari jam tersebut dikenakan charge Rp 500.000. Survey villa dilakukan pukul 12.00–14.00 saat villa sedang kosong, maksimal sampai pukul 17.00.',
  },
  {
    q: 'Berapa kapasitas tamu setiap villa?',
    a: 'Kapasitas bervariasi per villa, mulai dari 20 hingga 50 tamu. Jika melebihi kapasitas, dikenakan charge tambahan Rp 50.000/orang (lihat ketentuan persisnya di halaman detail setiap villa).',
  },
  {
    q: 'Apa saja fasilitas yang tersedia?',
    a: 'Fasilitas bervariasi per villa, antara lain private pool, karaoke, billiard, smart TV & WiFi, gazebo, area BBQ, dan kitchen set. Cek daftar fasilitas lengkap di halaman detail setiap villa.',
  },
  {
    q: 'Di mana lokasi The Rain Villas?',
    a: 'Semua villa berlokasi di kawasan Cisarua–Puncak, Bogor, Jawa Barat pada ketinggian ±800 mdpl, sekitar 90 menit dari Jakarta melalui tol Ciawi.',
  },
  {
    q: 'Apa saja aturan penting saat menginap?',
    a: 'Dilarang membawa minuman keras, obat terlarang, senjata tajam, dan peliharaan. Jam malam berlaku hingga pukul 22.00. Kerusakan barang yang ditimbulkan tamu dikenakan biaya ganti rugi sesuai nominal harga barang.',
  },
  {
    q: 'Bagaimana cara menghubungi admin?',
    a: 'Hubungi WhatsApp 0821-2549-2037 atau ikuti Instagram @therainvillas untuk info ketersediaan, tarif, dan jadwal survey villa.',
  },
];
---

<Layout title="The Rain Villas | Rasakan 24 Jam di Villa Puncak Impianmu" description="Sewa 31 villa private di Puncak Cisarua, Bogor. Private pool, pemandangan gunung, karaoke, billiard, dan fasilitas lengkap mulai Rp1 juta/malam.">
  <Header />
  <Slide01Hero />

  <section class="section featured-villas">
    <div class="container">
      <div class="featured-villas__header reveal">
        <span class="featured-villas__badge">Koleksi</span>
        <h2 class="section__title reveal">Pilihan Villa Terbaik</h2>
        <p class="section__subtitle reveal reveal--delay-1">Setiap villa punya ceritanya sendiri</p>
      </div>
      <div class="villa-grid" id="featured-villa-grid">
        {allVillas.map((villa, i) => (
          <div class="featured-villa-item reveal" data-villa-id={villa.id} style="display: none;">
            <VillaCard {...villa} />
          </div>
        ))}
      </div>
      <div class="featured-villas__cta reveal">
        <a href="/booking" class="btn btn--primary">Booking Sekarang</a>
        <a href="/our-villas" class="btn btn--ghost">Lihat Semua Villa</a>
      </div>
    </div>
  </section>

  <Slide03Evening />

  <ReviewsMarquee />

  <Slide04Booking />

  <CaraBooking />

  <SatisfactionForm />

  <Himbauan />

  <FaqSection faq={homeFaq} />

  <LocationSection />

  <Footer />
  <WhatsAppBubble />
</Layout>

<script>
  // Shuffle and display 3 random villas on each page load
  function showRandomVillas() {
    const grid = document.getElementById('featured-villa-grid');
    if (!grid) return;

    const items = Array.from(grid.querySelectorAll('.featured-villa-item'));

    // Fisher-Yates shuffle
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }

    // Show only the first 3 shuffled items with staggered reveal animation
    items.forEach((item, index) => {
      if (index < 3) {
        item.style.display = '';
        item.classList.add(`reveal--delay-${Math.min(index + 1, 4)}`);
      } else {
        item.remove(); // Remove unused cards from the DOM to keep it clean
      }
    });
  }

  showRandomVillas();
</script>

<style>
  .featured-villas {
    background: var(--color-light);
  }

  .featured-villas__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 48px;
  }

  .featured-villas__badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-primary);
    background: rgba(13, 27, 43, 0.06);
    border-radius: 20px;
    padding: 8px 18px;
    margin-bottom: 16px;
  }

  .villa-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .featured-villas__cta {
    text-align: center;
    margin-top: 40px;
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn--ghost {
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
    background: transparent;
  }

  .btn--ghost:hover {
    background: var(--color-primary);
    color: #fff;
  }

  @media (max-width: 768px) {
    .villa-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

