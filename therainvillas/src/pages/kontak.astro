---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBubble from '../components/WhatsAppBubble.astro';
import Seo from '../components/Seo.astro';
import { makeTitle, makeDescription } from '../lib/seo.js';

const kontakTitle = makeTitle('Kontak The Rain Villas Puncak');
const kontakDesc = makeDescription('Hubungi The Rain Villas untuk konsultasi booking villa private pool di Cisarua, Puncak, Bogor via WhatsApp, Instagram, atau email.');
---

<Layout title={kontakTitle} description={kontakDesc}>
  <Seo title={kontakTitle} description={kontakDesc} />
  <Header />
  <main class="page">
    <section class="page-hero">
      <div class="container">
        <h1 class="page-title">Kontak</h1>
        <p class="page-subtitle">Hubungi kami untuk info ketersediaan dan booking</p>
      </div>
    </section>
    <section class="container content">
      <div class="card">
        <h2>Informasi Kontak</h2>
        <ul>
          <li><strong>WhatsApp:</strong> <a href="https://wa.me/6282125492037">+62 821-2549-2037</a></li>
          <li><strong>Email:</strong> <a href="mailto:therainvillas@gmail.com">therainvillas@gmail.com</a></li>
          <li><strong>Alamat:</strong> Kp. Ciburial Cibarengkok, RT.01 RW.05, Tugu Utara, Kec. Cisarua, Kab. Bogor, Jawa Barat 16750</li>
          <li><strong>Instagram:</strong> <a href="https://www.instagram.com/therainvillas">@therainvillas</a></li>
          <li><strong>TikTok:</strong> <a href="https://www.tiktok.com/@therainvillas">@therainvillas</a></li>
        </ul>
        <p><a class="btn" href="https://wa.me/6282125492037" target="_blank" rel="noopener">Konsultasi via WhatsApp</a></p>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppBubble />
</Layout>

<style>
  .page-hero { background: linear-gradient(135deg, #0d1b2b 0%, #1e3a5f 100%); color: white; padding: 80px 0 60px; text-align: center; }
  .page-title { font-size: 2.5rem; margin-bottom: 12px; }
  .page-subtitle { opacity: 0.9; }
  .content { padding: 60px 24px; max-width: 800px; }
  .card { background: white; padding: 40px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
  .card h2 { margin-bottom: 24px; color: #0d1b2b; }
  .card ul { list-style: none; padding: 0; }
  .card li { padding: 12px 0; border-bottom: 1px solid #eee; line-height: 1.6; }
  .card a { color: #2563eb; }
  .btn { display: inline-block; background: #25D366; color: white !important; padding: 12px 24px; border-radius: 8px; text-decoration: none; margin-top: 20px; }
</style>
