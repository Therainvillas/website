---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import VillaCard from '../../components/VillaCard.astro';
import { villas, formatPrice } from '../../data/villas.js';
import { landingPages } from '../../data/landing-pages.js';

export function getStaticPaths() {
  return landingPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const villaList = page.villaIds
  .map((id) => villas.find((v) => v.id === id))
  .filter(Boolean)
  .sort((a, b) => a.price - b.price);

const canonicalUrl = new URL(`/landing/${page.slug}/`, Astro.site).href;
const waMessage = encodeURIComponent(`Halo, saya cari ${page.title.replace('Sewa ', '').split(' -')[0]}.`);
const waHref = `https://wa.me/6282125492037?text=${waMessage}`;

// Breadcrumb JSON-LD
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://therainvillas.com/' },
    { '@type': 'ListItem', position: 2, name: page.title, item: canonicalUrl },
  ],
};

// Find related landing pages (same villa count range, different slug)
const related = landingPages
  .filter((p) => p.slug !== page.slug && p.villaIds.length >= 3)
  .slice(0, 4);
---

<Layout
  title={page.title}
  description={page.description}
  image={villaList[0]?.image || '/Agave/Cover.webp'}
  jsonLd={[breadcrumbJsonLd]}
  canonical={canonicalUrl}
>
  <Header />
  <main class="landing-page">
    <section class="landing-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Beranda</a>
          <span aria-hidden="true">/</span>
          <span>{page.title}</span>
        </nav>
        <h1>{page.title}</h1>
        <p class="landing-hero__desc">{page.description}</p>
        <a href={waHref} class="btn btn--primary landing-hero__cta" data-track="whatsapp_click" data-landing={page.slug}>
          Booking via WhatsApp
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>

    <section class="landing-intro">
      <div class="container">
        <p>{page.intro}</p>
      </div>
    </section>

    <section class="landing-villas">
      <div class="container">
        <h2>Daftar Villa</h2>
        <p class="landing-villas__count">{villaList.length} villa tersedia</p>
        <div class="landing-villas__grid">
          {villaList.map((villa) => (
            <VillaCard
              id={villa.id}
              name={villa.name}
              description={villa.description}
              image={villa.image}
              price={villa.price}
              priceLabel={villa.priceLabel}
              originalPrice={villa.originalPrice}
              badge={villa.badge}
              capacity={villa.capacity}
              bedrooms={villa.bedrooms}
              bathrooms={villa.bathrooms}
              parking={villa.parking}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="landing-faq">
      <div class="container">
        <h2>Pertanyaan Umum</h2>
        <div class="faq-list">
          {page.faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="landing-related">
        <div class="container">
          <h2>Telusuri Lainnya</h2>
          <div class="landing-related__list">
            {related.map((p) => (
              <a href={`/landing/${p.slug}/`} class="landing-related__link">
                {p.title}
                <span aria-hidden="true">&rarr;</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="landing-cta">
      <div class="container">
        <h2>Siap Booking?</h2>
        <p>Hubungi admin The Rain Villas untuk informasi lebih lanjut dan konfirmasi ketersediaan.</p>
        <a href={waHref} class="btn btn--primary" data-track="whatsapp_click" data-landing={page.slug}>
          Chat WhatsApp
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Track WhatsApp clicks for GA4
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('a[href*="wa.me"]').forEach((link) => {
      link.addEventListener('click', () => {
        const villa = link.closest('.villa-card')?.querySelector('.villa-card__title a')?.textContent?.trim() || '';
        const landing = link.dataset.landing || '';
        if (typeof gtag === 'function') {
          gtag('event', 'whatsapp_click', {
            event_category: 'engagement',
            event_label: villa || landing,
            custom_parameters: {
              villa: villa,
              page: landing,
            },
          });
        }
      });
    });
  });
</script>

<style>
  .landing-page {
    padding-bottom: 80px;
  }

  .landing-hero {
    background: linear-gradient(180deg, var(--b0) 0%, var(--b1) 100%);
    padding: 40px 0 60px;
    text-align: center;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 24px;
    font-size: 0.82rem;
    color: var(--color-gray);
  }

  .breadcrumb a {
    color: var(--color-gray);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .landing-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 16px;
    color: var(--color-dark);
  }

  .landing-hero__desc {
    max-width: 640px;
    margin: 0 auto 28px;
    color: var(--color-gray);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .landing-hero .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .landing-hero .btn--primary {
    color: #fff;
    background: var(--color-accent);
    box-shadow: 0 12px 28px rgba(184, 110, 47, 0.24);
  }

  .landing-hero .btn--primary:hover {
    transform: translateY(-2px);
    background: var(--color-accent-dark);
  }

  .landing-intro {
    padding: 40px 0;
  }

  .landing-intro p {
    max-width: 760px;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-dark);
  }

  .landing-villas {
    padding: 40px 0;
    background: var(--color-panel);
  }

  .landing-villas h2 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    margin-bottom: 8px;
  }

  .landing-villas__count {
    color: var(--color-gray);
    margin-bottom: 24px;
  }

  .landing-villas__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .landing-faq {
    padding: 60px 0;
  }

  .landing-faq h2 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    margin-bottom: 24px;
    text-align: center;
  }

  .faq-list {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 16px 20px;
    transition: box-shadow 0.2s ease;
  }

  .faq-item[open] {
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
  }

  .faq-item summary {
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--color-primary);
    transition: transform 0.2s ease;
  }

  .faq-item[open] summary::after {
    content: '−';
  }

  .faq-item p {
    margin-top: 12px;
    color: var(--color-gray);
    line-height: 1.7;
  }

  .landing-related {
    padding: 60px 0;
    background: var(--color-panel);
  }

  .landing-related h2 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    margin-bottom: 20px;
    text-align: center;
  }

  .landing-related__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .landing-related__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--color-light);
    border: 1px solid var(--color-border);
    color: var(--color-dark);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .landing-related__link:hover {
    background: var(--color-primary);
    color: #fff;
    transform: translateY(-2px);
  }

  .landing-cta {
    padding: 60px 0;
    text-align: center;
  }

  .landing-cta h2 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    margin-bottom: 12px;
  }

  .landing-cta p {
    max-width: 560px;
    margin: 0 auto 24px;
    color: var(--color-gray);
    line-height: 1.7;
  }

  .landing-cta .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    color: #fff;
    background: var(--color-accent);
    box-shadow: 0 12px 28px rgba(184, 110, 47, 0.24);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .landing-cta .btn:hover {
    transform: translateY(-2px);
    background: var(--color-accent-dark);
  }

  @media (max-width: 980px) {
    .landing-villas__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .landing-villas__grid {
      grid-template-columns: 1fr;
    }

    .landing-hero {
      padding: 32px 0 48px;
    }

    .landing-related__list {
      flex-direction: column;
      align-items: stretch;
    }

    .landing-related__link {
      justify-content: center;
    }
  }
</style>
