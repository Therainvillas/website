---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import VillaFilter from '../components/VillaFilter.vue';
import Footer from '../components/Footer.astro';
import WhatsAppBubble from '../components/WhatsAppBubble.astro';
import Seo from '../components/Seo.astro';
import { makeTitle, makeDescription } from '../lib/seo.js';
import { villas } from '../data/villas';
import { villaCovers, villaHeroCovers } from '../data/covers';

const ourVillasTitle = makeTitle('Daftar Villa Puncak: Harga, Kapasitas, Fasilitas');
const ourVillasDesc = makeDescription('Bandingkan harga, kapasitas, dan fasilitas villa private pool di Puncak Cisarua untuk keluarga & gathering. Cek ketersediaan & booking via WhatsApp.');

const filterData = villas.map(v => ({
  id: v.id,
  name: v.name,
  description: v.description,
  image: v.image,
  price: v.price,
  priceLabel: v.priceLabel,
  originalPrice: v.originalPrice,
  badge: v.badge,
  capacity: v.capacity,
  bedrooms: v.bedrooms,
  bathrooms: v.bathrooms,
  parking: v.parking,
  amenities: v.amenities,
}));

const firstCover = villaCovers[villas[0].name] ?? villas[0].image;
const firstCoverSm = villaHeroCovers[villas[0].name] ?? firstCover;
---

<Layout title={ourVillasTitle} description={ourVillasDesc} preloadImage={{ sm: firstCoverSm, lg: firstCover }}>
  <Seo title={ourVillasTitle} description={ourVillasDesc} />
  <Header />

  <section class="page-hero">
    <div class="page-hero__bg">
      {villas.slice(0, 12).map((v, i) => {
        const cover = villaCovers[v.name] ?? v.image;
        const coverSm = villaHeroCovers[v.name] ?? cover;
        return i < 1
          ? <div class="page-hero__slide" style={`--bg-lg: url("${cover}"); --bg-sm: url("${coverSm}")`} data-index={i}></div>
          : <div class="page-hero__slide" data-bg={cover} data-bg-sm={coverSm} data-index={i}></div>;
      })}
      <div class="page-hero__overlay"></div>
    </div>
    <div class="container" style="position:relative;z-index:1">
      <h1 class="page-hero__title reveal">Our Villas</h1>
      <p class="page-hero__subtitle reveal reveal--delay-1">Temukan villa impian Anda untuk liburan yang tak terlupakan</p>
    </div>
  </section>

  <script is:inline>
    // Slide pertama dimuat langsung; slide lainnya dimuat bertahap (3 detik
    // sekali, selaras dengan animation-delay) agar tidak berebut bandwidth.
    (function () {
      var slides = document.querySelectorAll('.page-hero__slide[data-bg]');
      if (!slides.length) return;
      function start() {
        for (var i = 0; i < slides.length; i++) {
          (function (el) {
            var idx = parseInt(el.getAttribute('data-index'), 10) || 0;
            setTimeout(function () {
              el.style.setProperty('--bg-lg', 'url("' + el.getAttribute('data-bg') + '")');
              el.style.setProperty('--bg-sm', 'url("' + (el.getAttribute('data-bg-sm') || el.getAttribute('data-bg')) + '")');
            }, 1500 + (idx - 1) * 3000);
          })(slides[i]);
        }
      }
      if (document.readyState === 'complete') start();
      else window.addEventListener('load', start, { once: true });
    })();
  </script>

  <section class="villa-list section">
    <div class="container">
      <VillaFilter client:visible villas={filterData} />
    </div>
  </section>

  <section class="landing-links">
    <div class="container">
      <h2>Cari Berdasarkan Kapasitas &amp; Fasilitas</h2>
      <p class="landing-links__sub">Telusuri villa sesuai kebutuhan group Anda.</p>
      <div class="landing-links__grid">
        <div>
          <h3>Kapasitas</h3>
          <ul>
            <li><a href="/landing/villa-puncak-20-orang/">Villa untuk 20 Orang</a></li>
            <li><a href="/landing/villa-puncak-30-orang/">Villa untuk 30 Orang</a></li>
            <li><a href="/landing/villa-puncak-40-orang/">Villa untuk 40 Orang</a></li>
            <li><a href="/landing/villa-puncak-50-orang/">Villa untuk 50 Orang</a></li>
          </ul>
        </div>
        <div>
          <h3>Fasilitas</h3>
          <ul>
            <li><a href="/landing/villa-puncak-billiard/">Billiard</a></li>
            <li><a href="/landing/villa-puncak-karaoke/">Karaoke</a></li>
            <li><a href="/landing/villa-puncak-private-pool/">Private Pool</a></li>
            <li><a href="/landing/villa-puncak-playground/">Playground</a></li>
          </ul>
        </div>
        <div>
          <h3>Harga</h3>
          <ul>
            <li><a href="/landing/villa-puncak-murah/">Villa Murah (Under 1.2jt)</a></li>
            <li><a href="/landing/villa-puncak-tahun-baru-2027/">Tahun Baru 2027</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <WhatsAppBubble />
</Layout>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    color: white;
    text-align: center;
    padding: 80px 24px 60px;
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero__slide {
    position: absolute;
    inset: 0;
    background-image: var(--bg-lg);
    background-size: cover;
    background-position: center;
    opacity: 0;
    animation: hero-fade 36s ease-in-out infinite;
  }

  /* Layar kecil: pakai varian hero yang jauh lebih ringan (HP ~60-100 KiB). */
  @media (max-width: 768px) {
    .page-hero__slide { background-image: var(--bg-sm); }
  }

  .page-hero__slide[data-index="0"] { animation-delay: 0s; }
  .page-hero__slide[data-index="1"] { animation-delay: 3s; }
  .page-hero__slide[data-index="2"] { animation-delay: 6s; }
  .page-hero__slide[data-index="3"] { animation-delay: 9s; }
  .page-hero__slide[data-index="4"] { animation-delay: 12s; }
  .page-hero__slide[data-index="5"] { animation-delay: 15s; }
  .page-hero__slide[data-index="6"] { animation-delay: 18s; }
  .page-hero__slide[data-index="7"] { animation-delay: 21s; }
  .page-hero__slide[data-index="8"] { animation-delay: 24s; }
  .page-hero__slide[data-index="9"] { animation-delay: 27s; }
  .page-hero__slide[data-index="10"] { animation-delay: 30s; }
  .page-hero__slide[data-index="11"] { animation-delay: 33s; }

  @keyframes hero-fade {
    0%, 5% { opacity: 0; }
    8%, 22% { opacity: 1; }
    25%, 100% { opacity: 0; }
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(15,23,42,0.7) 0%, rgba(91,141,239,0.5) 100%);
  }

  .page-hero__title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .page-hero__subtitle {
    font-size: 1.1rem;
    opacity: 0.85;
  }

  .villa-list {
    background: var(--color-gray-light);
  }

  .landing-links {
    padding: 60px 0;
    background: var(--color-light);
  }

  .landing-links h2 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    margin-bottom: 8px;
    text-align: center;
  }

  .landing-links__sub {
    text-align: center;
    color: var(--color-gray);
    margin-bottom: 28px;
  }

  .landing-links__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .landing-links h3 {
    font-size: 1rem;
    margin-bottom: 12px;
    color: var(--color-dark);
  }

  .landing-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .landing-links li a {
    display: block;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-dark);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .landing-links li a:hover {
    background: var(--color-primary);
    color: #fff;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .landing-links__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: 60px 20px 40px;
    }

    .page-hero__title {
      font-size: 1.8rem;
    }
  }
</style>
