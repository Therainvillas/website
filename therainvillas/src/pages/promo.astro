---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBubble from '../components/WhatsAppBubble.astro';
import PromoClaim from '../components/PromoClaim.vue';
import FlashSaleBanner from '../components/FlashSaleBanner.astro';
---

<Layout
  title="Promo & Voucher Villa | The Rain Villas"
  description="Klaim promo Oktober 2026 di The Rain Villas — diskon hingga 10% dengan kode hasil klaim setelah memberi rating Google Maps."
>
  <Header />
  <main class="promo-page">
    <FlashSaleBanner />
    <div class="container">
      <header class="promo-page__head">
        <span class="promo-page__badge">Promo &amp; Voucher</span>
        <h1>Promo &amp; Voucher</h1>
        <p>Sedang berlangsung: <strong>Promo Oktober 10%</strong> — klaim kode di halaman ini (wajib rating Google Maps).</p>
        <p>Juga ada <strong>Flash Sale 24 Oktober 2026</strong> untuk Villa Arisyfa, Villa Arsy, Villa De Summit, dan Villa Thymi.</p>
      </header>

      <div class="promo-empty">
        <img src="/promo/promo oktober.webp" alt="Promo Oktober 10% - Kode OKTOBER10" class="promo-page__img" />
        <h2>Promo Oktober Spesial</h2>
        <div class="promo-page__terms">
          <ul>
            <li>Wajib memberikan <strong>rating Google Maps</strong> dan mengirim <strong>bukti rating</strong>.</li>
            <li>Setelah mengirim bukti rating, <strong>kode promo akan muncul secara acak dan hanya berlaku selama 2 menit</strong>.</li>
            <li>Berlaku untuk pemesanan Oktober 2026.</li>
            <li><strong>Tidak berlaku</strong> untuk Rjs Cottage 1, Rjs Cottage 2, Rjs Cottage 3, Villa Kaca 1, dan Villa Kaca 2.</li>
            <li>Potongan dihitung otomatis di formulir booking.</li>
            <li>Tidak dapat digabungkan dengan promo atau voucher lain.</li>
          </ul>
        </div>
        <div class="promo-page__actions">
          <a href="#klaim" class="promo-page__btn promo-page__btn--primary">Klaim Kode Promo</a>
          <a href="/" class="promo-page__btn">Kembali ke Beranda</a>
        </div>
      </div>

      <PromoClaim client:load />
    </div>
  </main>
  <Footer />
  <WhatsAppBubble />
</Layout>

<style>
  .promo-page {
    min-height: 80vh;
    padding: 80px 0 100px;
    background: var(--color-light);
    position: relative;
  }
  .promo-page::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 640px;
    height: 640px;
    background: radial-gradient(circle, rgba(var(--color-accent-rgb), 0.06) 0%, transparent 70%);
    pointer-events: none;
  }
  .promo-page__head {
    text-align: center;
    margin-bottom: 36px;
    position: relative;
    padding: 44px 24px 40px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    isolation: isolate;
  }
  .promo-page__head::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: url('/background.png');
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.18;
  }
  .promo-page__badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-accent);
    background: rgba(var(--color-accent-rgb), 0.09);
    padding: 6px 18px;
    border-radius: 20px;
    margin-bottom: 14px;
  }
  .promo-page__head h1 {
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--color-dark);
    margin-bottom: 10px;
  }
  .promo-page__head p {
    color: var(--color-gray);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .promo-empty {
    text-align: center;
    background: var(--color-panel);
    border: 1px dashed var(--color-border);
    border-radius: 22px;
    padding: 60px 24px;
    margin-bottom: 48px;
  }
  .promo-empty__icon {
    font-size: 2.6rem;
    display: block;
    margin-bottom: 14px;
  }
  .promo-empty h2 {
    font-size: 1.4rem;
    color: var(--color-dark);
    margin-bottom: 6px;
  }
  .promo-page__img {
    max-width: 520px;
    width: 100%;
    height: auto;
    border-radius: 16px;
    margin-bottom: 18px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.08);
  }
  .promo-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 18px;
  }
  .promo-page__btn {
    padding: 10px 18px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    background: var(--color-gray-light, #f2f3f6);
    color: var(--color-dark, #0f172a);
  }
  .promo-page__btn--primary {
    background: linear-gradient(135deg, #5b8def, #7a5ce0);
    color: #fff;
  }
  .promo-page__terms {
    max-width: 560px;
    margin: 16px auto 8px;
    text-align: left;
    background: rgba(var(--color-accent-rgb), 0.05);
    border: 1px solid rgba(var(--color-accent-rgb), 0.15);
    border-radius: 14px;
    padding: 20px 24px;
  }
  .promo-page__terms ul {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--color-gray);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .promo-page {
      padding: 60px 0 80px;
    }
    .promo-page__head h1 {
      font-size: 1.8rem;
    }
  }
</style>
