---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBubble from '../components/WhatsAppBubble.astro';
import FaqSection from '../components/FaqSection.astro';
import { promos, getPromoStatus, promoOfferJsonLd, MAPS_RATING_URL, PROOF_API } from '../data/promos';

const now = new Date();
const statusLabel = { active: 'Aktif', upcoming: 'Segera', expired: 'Berakhir' };
const statusClass = { active: 'promo-status--active', upcoming: 'promo-status--upcoming', expired: 'promo-status--expired' };

const withStatus = promos.map((p) => ({
  ...p,
  status: getPromoStatus(p, now),
  statusText: statusLabel[getPromoStatus(p, now)],
}));
const activePromos = withStatus.filter((p) => p.status === 'active');
const otherPromos = withStatus.filter((p) => p.status !== 'active');

const fmtDate = (s) => {
  if (!s) return '-';
  return new Date(s).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
};
const fmtTime = (s) => {
  if (!s) return '';
  return new Date(s).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
};

const promoFaq = [
  {
    q: 'Bagaimana cara klaim voucher atau promo?',
    a: 'Klik tombol "Klaim & Booking" pada promo atau voucher yang tersedia, lalu lengkapi formulir booking. Kode promo otomatis terisi dan potongan langsung dihitung dari subtotal menginap villa.',
  },
  {
    q: 'Kode promo saya tidak valid, kenapa?',
    a: 'Pastikan kode ditulis persis sesuai yang tertera (tanpa spasi), masih dalam masa berlaku, dan sesuai dengan ketentuan promo yang dipilih.',
  },
  {
    q: 'Apakah promo bisa digabungkan?',
    a: 'Tidak. Setiap pemesanan hanya berlaku untuk satu kode promo/voucher untuk menghindari penumpukan potongan.',
  },
  {
    q: 'Promo tidak berlaku untuk villa mana saja?',
    a: 'Kode promo TRV10 tidak berlaku untuk Rjs Cottage 1, Rjs Cottage 2, Rjs Cottage 3, Villa Kaca 1, dan Villa Kaca 2. Jika anda memilih salah satu villa tersebut, diskon otomatis tidak dihitung.',
  },
];
---

<Layout
  title="Promo & Voucher Villa | The Rain Villas"
  description="Klaim promo dan voucher terbaru The Rain Villas. Potongan dihitung otomatis dari subtotal menginap saat booking via formulir."
  jsonLd={[promoOfferJsonLd]}
  showPromo={false}
>
  <Header />
  <main class="promo-page">
    <div class="container">
      <header class="promo-page__head">
        <span class="promo-page__badge">Promo &amp; Voucher</span>
        <h1>Klaim Promo Terbaru</h1>
        <p>Pilih promo atau voucher aktif di bawah, lalu klaim dan gunakan di formulir pemesanan. Potongan dihitung otomatis dari subtotal menginap villa.</p>
      </header>

      <section class="promo-grid">
        {activePromos.map((p) => (
          <article class="promo-card reveal" data-promo-card>
            <div class="promo-card__top">
              <span class={`promo-status ${statusClass[p.status]}`}>{p.statusText}</span>
              {p.featured && <span class="promo-card__featured">★ Pilihan</span>}
            </div>
            <div class="promo-card__discount">
              <span class="promo-card__discount-value">{p.value}%</span>
              <span class="promo-card__discount-label">{p.label}</span>
            </div>
            <h2 class="promo-card__title">{p.headline}</h2>
            <p class="promo-card__desc">{p.description}</p>
            <ul class="promo-card__terms">
              {p.terms.map((t) => <li>{t}</li>)}
            </ul>
            {p.excluded && p.excluded.length > 0 && (
              <div class="promo-card__excluded">
                <strong>Kecuali:</strong>
                {p.excluded.join(' • ')}
              </div>
            )}
            <div class="promo-card__code">
              <span>Kode</span>
              <strong class="promo-card__code-mask">••••••</strong>
              <strong class="promo-card__code-value" data-code-value>{p.code}</strong>
            </div>
            <p class="promo-card__period">Berlaku {fmtDate(p.validFrom)} s.d. {fmtDate(p.validUntil)} — {fmtTime(p.validUntil)} WIB</p>
            <div class="promo-card__claim-gate" data-claim-gate data-proof-api={PROOF_API}>
              <p class="promo-card__gate-note">🔒 Kode tersembunyi. Untuk membuka kode: 1) beri rating di Google Maps kantor The Rain Villas, 2) ambil screenshot buktinya, 3) upload bukti, lalu klik "Kirim Bukti &amp; Buka Kode" — kode terbuka setelah bukti masuk ke admin dan berlaku 10 menit (habis tempo akan tertutup kembali).</p>
              <a class="btn btn--primary promo-card__rate" href={MAPS_RATING_URL} target="_blank" rel="noopener" data-rate-btn>
                ★ Rating di Google Maps
              </a>
              <div class="promo-card__upload-wrap" data-upload-drop>
                <input type="file" accept="image/*" data-upload-input />
                <button type="button" class="promo-card__upload" data-upload-btn>
                  <span class="promo-card__upload-icon">📷</span>
                  <strong>Upload Bukti Screenshot</strong>
                  <em>JPEG / PNG — di HP, ketuk tombol ini (tarik & taruh kadang tidak didukung)</em>
                </button>
              </div>
              <p class="promo-card__gate-status" data-upload-status role="status"></p>
              <div class="promo-card__preview" data-upload-preview hidden>
                <img alt="Pratinjau bukti rating - klik untuk memperbesar" data-upload-img />
                <span class="promo-card__preview-note">Klik foto untuk memperbesar</span>
              </div>
              <button type="button" class="promo-card__submit" data-submit-proof disabled>
                <span data-submit-label>Kirim Bukti &amp; Buka Kode</span>
              </button>
            </div>
            <div class="promo-card__unlocked" data-unlocked>
              <span class="promo-card__unlocked-label" data-unlocked-label>✅ Kode promo terbuka</span>
              <div class="promo-card__actions">
                <a class="btn btn--primary promo-card__claim" href={`/booking?promo=${p.code}`}>
                  Klaim &amp; Booking
                </a>
                <button type="button" class="btn btn--ghost promo-card__copy" data-copy-code={p.code}>
                  Salin Kode
                </button>
              </div>
            </div>
          </article>
        ))}
      </section>

      {activePromos.length === 0 && (
        <div class="promo-empty">
          <span class="promo-empty__icon">🎟️</span>
          <h2>Belum ada promo aktif</h2>
          <p>Promo dan voucher terbaru akan muncul di halaman ini. Nantikan penawaran menarik dari The Rain Villas.</p>
        </div>
      )}

      {otherPromos.length > 0 && (
        <section class="promo-others">
          <h2 class="promo-others__title">Promo Lainnya</h2>
          <div class="promo-grid">
            {otherPromos.map((p) => (
              <article class={`promo-card promo-card--muted reveal`}>
                <div class="promo-card__top">
                  <span class={`promo-status ${statusClass[p.status]}`}>{p.statusText}</span>
                </div>
                <div class="promo-card__discount">
                  <span class="promo-card__discount-value">{p.value}%</span>
                  <span class="promo-card__discount-label">{p.label}</span>
                </div>
                <h2 class="promo-card__title">{p.headline}</h2>
                <p class="promo-card__desc">{p.description}</p>
                <div class="promo-card__code">
                  <span>Kode</span>
                  <strong>{p.code}</strong>
                </div>
                <p class="promo-card__period">
                  {p.status === 'upcoming' ? `Mulai ${fmtDate(p.validFrom)}` : `Sampai ${fmtDate(p.validUntil)}`}
                </p>
                <div class="promo-card__actions">
                  <span class="btn promo-card__claim promo-card__claim--disabled">
                    {p.status === 'upcoming' ? 'Belum Tersedia' : 'Sudah Berakhir'}
                  </span>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="promo-howto reveal">
        <span class="promo-howto__badge">Cara Pakai</span>
        <h2>Cara Klaim dan Gunakan Promo</h2>
        <div class="promo-howto__steps">
          <div class="promo-howto__step">
            <span class="promo-howto__num">1</span>
            <strong>Pilih promo aktif</strong>
            <p>Klik "Klaim &amp; Booking" pada kartu promo pilihan Anda.</p>
          </div>
          <div class="promo-howto__step">
            <span class="promo-howto__num">2</span>
            <strong>Pilih villa &amp; tanggal</strong>
            <p>Kode otomatis terisi di formulir — diskon dihitung dari subtotal menginap.</p>
          </div>
          <div class="promo-howto__step">
            <span class="promo-howto__num">3</span>
            <strong>Kirim ke WhatsApp</strong>
            <p>Total setelah diskon tercantum di format booking yang dikirim.</p>
          </div>
        </div>
      </section>

      <FaqSection title="Promo & Voucher" subtitle="Pertanyaan seputar promo dan voucher" faq={promoFaq} />
    </div>
  </main>
  <Footer />
  <WhatsAppBubble />

  <div class="promo-lightbox" data-photo-lightbox aria-hidden="true">
    <img alt="Foto bukti rating" data-photo-lightbox-img />
    <button type="button" class="promo-lightbox__close" data-photo-lightbox-close aria-label="Tutup">&times;</button>
  </div>

  <script>
    (function () {
      var CLAIM_KEY = 'trv_promo_claimed';
      var CLAIM_TTL_MS = 10 * 60 * 1000;
      function readCookieClaims() {
        try {
          var m = document.cookie.match(/(?:^|;\s*)trv_promo_claimed=([^;]*)/);
          if (!m) return {};
          return JSON.parse(decodeURIComponent(m[1])) || {};
        } catch (e) {
          return {};
        }
      }
      function readClaims() {
        var c = {};
        try {
          var ls = JSON.parse(localStorage.getItem(CLAIM_KEY) || '{}');
          if (ls && typeof ls === 'object') c = ls;
        } catch (e) {}
        try {
          var ck = readCookieClaims();
          for (var k in ck) c[k] = ck[k];
        } catch (e) {}
        return c;
      }
      function saveClaims(c) {
        try {
          localStorage.setItem(CLAIM_KEY, JSON.stringify(c));
        } catch (e) {}
        try {
          document.cookie = 'trv_promo_claimed=' + encodeURIComponent(JSON.stringify(c)) + '; path=/; max-age=2592000; SameSite=Lax';
        } catch (e) {}
      }
      function sendProof(api, code, file, dataUrl) {
        var payload = {
          action: 'addProof',
          code: code,
          name: file.name,
          type: file.type,
          data: dataUrl,
          ts: new Date().toISOString(),
        };
        return fetch(api, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload),
        });
      }
      function statusFor(gate, msg, cls) {
        var el = gate ? gate.querySelector('[data-upload-status]') : null;
        if (!el) return;
        el.textContent = msg;
        el.className = 'promo-card__gate-status' + (cls ? ' promo-card__gate-status--' + cls : '');
      }
      function fileDropError(gate) {
        statusFor(gate, 'File tidak terbaca saat tarik & taruh. Silakan ketuk tombol "Upload Bukti Screenshot" untuk memilih dari folder/galeri.', 'err');
      }
      function fileFromUri(uri, cb) {
        fetch(uri).then(function (r) { return r.blob(); }).then(function (blob) {
          cb(new File([blob], 'proof.jpg', { type: blob.type || 'image/jpeg' }));
        }).catch(function () { cb(null); });
      }
      document.querySelectorAll('[data-claim-gate]').forEach(function (gate) {
        var card = gate.closest('[data-promo-card]');
        if (!card) return;
        var codeEl = card.querySelector('[data-code-value]');
        if (!codeEl) return;
        var code = codeEl.textContent.trim();
        if (!code) return;
        function unlock(existingTs) {
          var v = typeof existingTs === 'number' ? existingTs : Date.now();
          card.classList.add('promo-card--unlocked');
          var claims = readClaims();
          claims[code] = v;
          saveClaims(claims);
          startCountdown(v);
          scheduleReLock(v);
        }
        function scheduleReLock(ts) {
          var remain = CLAIM_TTL_MS - (Date.now() - ts);
          if (remain <= 0) { reLock(); return; }
          if (card._trvTimer) clearTimeout(card._trvTimer);
          card._trvTimer = setTimeout(function () { reLock(); }, remain + 50);
        }
        function reLock() {
          card.classList.remove('promo-card--unlocked');
          var claims = readClaims();
          delete claims[code];
          saveClaims(claims);
          gate.PENDING = null;
          if (input) input.value = '';
          if (submitBtn) submitBtn.disabled = true;
          setStatus('⏰ Waktu kode terbuka habis (10 menit). Ulangi rating & upload bukti untuk membuka lagi.', 'wait');
        }
        function startCountdown(ts) {
          var labelEl = card.querySelector('[data-unlocked-label]');
          if (!labelEl) return;
          var show = function () {
            var remain = Math.max(0, Math.ceil((CLAIM_TTL_MS - (Date.now() - ts)) / 1000));
            var mm = Math.floor(remain / 60);
            var ss = ('0' + (remain % 60)).slice(-2);
            labelEl.textContent = '✅ Kode terbuka — sisa ' + mm + ':' + ss;
            if (remain > 0) {
              clearTimeout(labelEl._t2);
              labelEl._t2 = setTimeout(show, 1000);
            }
          };
          show();
        }
        var input = gate.querySelector('[data-upload-input]');
        var preview = gate.querySelector('[data-upload-preview]');
        var img = gate.querySelector('[data-upload-img]');
        var statusEl = gate.querySelector('[data-upload-status]');
        var submitBtn = gate.querySelector('[data-submit-proof]');

        function setStatus(msg, cls) {
          if (!statusEl) return;
          statusEl.textContent = msg;
          statusEl.className = 'promo-card__gate-status' + (cls ? ' promo-card__gate-status--' + cls : '');
        }

        function handleFile(file) {
          if (!statusEl) return;
          if (card.classList.contains('promo-card--unlocked')) return;
          if (input) input.value = '';
          if (!file) {
            setStatus('Foto tidak terdeteksi. Ketuk tombol "Upload Bukti Screenshot" untuk memilih dari galeri.', 'err');
            return;
          }
          if (file.type && !/^image\//.test(file.type)) {
            setStatus('Format harus gambar (JPEG / PNG). Pilih ulang bukti screenshot Anda.', 'err');
            return;
          }
          try {
            var reader = new FileReader();
            reader.onload = function (e) {
              try {
                var dataUrl = e.target.result;
                gate.PENDING = { dataUrl: dataUrl, file: file };
                if (img) img.src = dataUrl;
                if (preview) preview.hidden = false;
                if (submitBtn) submitBtn.disabled = false;
                setStatus('Foto berhasil dipilih. Klik "Kirim Bukti & Buka Kode" untuk membuka kode promo.', 'wait');
              } catch (err) {
                setStatus('Gagal memproses foto: ' + err.message, 'err');
              }
            };
            reader.onerror = function () {
              setStatus('Gagal membaca file. Coba screenshot lain.', 'err');
            };
            reader.readAsDataURL(file);
          } catch (err) {
            setStatus('Browser tidak mendukung upload gambar: ' + err.message, 'err');
          }
        }

        function submit() {
          if (!gate.PENDING || !gate.PENDING.dataUrl || !gate.PENDING.file) {
            setStatus('Pilih foto bukti rating terlebih dahulu.', 'err');
            return;
          }
          uploadAndUnlock(gate.PENDING.dataUrl, gate.PENDING.file);
        }

        function uploadAndUnlock(dataUrl, file) {
          var api = gate.getAttribute('data-proof-api');
          if (dataUrl.length > 12000000) {
            setStatus('Ukuran foto terlalu besar untuk dikirim ke admin. Gunakan screenshot dengan ukuran lebih kecil.', 'err');
            if (submitBtn) submitBtn.disabled = false;
            return;
          }
          if (submitBtn) submitBtn.disabled = true;
          if (api) {
            setStatus('Mengirim bukti ke admin…', 'wait');
            sendProof(api, code, file, dataUrl)
              .then(function () {
                setStatus('✅ Bukti terkirim ke admin — kode promo terbuka.', 'ok');
                unlock();
              })
              .catch(function () {
                setStatus('Gagal mengirim bukti ke admin. Periksa koneksi lalu klik tombol lagi.', 'err');
                if (submitBtn) submitBtn.disabled = false;
              });
          } else {
            setStatus('✅ Bukti terupload — kode terbuka (mode lokal, belum terhubung ke admin).', 'ok');
            unlock();
          }
        }

        gate.HANDLE = handleFile;
        gate.SUBMIT = submit;
        var stored = readClaims();
        if (stored[code] !== undefined) {
          var sv = stored[code];
          if (sv === true) {
            unlock(Date.now());
          } else if (typeof sv === 'number' && Date.now() - sv <= CLAIM_TTL_MS) {
            unlock(sv);
          } else {
            delete stored[code];
            saveClaims(stored);
          }
        }
      });

      document.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest ? e.target.closest('[data-upload-btn]') : null;
        if (!btn) return;
        var wrap = btn.closest ? btn.closest('[data-upload-drop]') : null;
        var inp = wrap ? wrap.querySelector('[data-upload-input]') : null;
        if (inp) inp.click();
      });

      document.addEventListener('change', function (e) {
        var el = e.target;
        if (!el || !el.getAttribute || !el.hasAttribute || !el.hasAttribute('data-upload-input')) return;
        var gate = el.closest ? el.closest('[data-claim-gate]') : null;
        if (!gate || typeof gate.HANDLE !== 'function') return;
        var file = el.files && el.files[0];
        if (file) gate.HANDLE(file);
      });

      document.addEventListener('dragover', function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var dt = e.dataTransfer;
        if (!dt) return;
        var types = dt.types;
        var hasFiles = false;
        if (types) {
          for (var k = 0; k < types.length; k++) {
            if (types[k] === 'Files' || types[k] === 'application/x-moz-file') { hasFiles = true; break; }
          }
        }
        if (hasFiles) e.preventDefault();
        if (t.closest('[data-upload-drop]')) {
          dt.dropEffect = 'copy';
          e.preventDefault();
        }
      });

      document.addEventListener('dragenter', function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var wrap = t.closest('[data-upload-drop]');
        if (!wrap) return;
        var b = wrap.querySelector('[data-upload-btn]');
        if (b) b.classList.add('promo-card__upload--dragover');
      });

      document.addEventListener('dragleave', function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var wrap = t.closest('[data-upload-drop]');
        if (!wrap) return;
        var to = e.relatedTarget;
        if (to && to.closest && to.closest('[data-upload-drop]')) return;
        var b = wrap.querySelector('[data-upload-btn]');
        if (b) b.classList.remove('promo-card__upload--dragover');
      });

      document.addEventListener('drop', function (e) {
        var t = e.target;
        if (!t || !t.closest || !e.dataTransfer) return;
        var wrap = t.closest('[data-upload-drop]');
        var card = t.closest('[data-promo-card]');
        if (!wrap && !card) return;
        e.preventDefault();
        var host = wrap || card;
        var b = host.querySelector('[data-upload-btn]');
        if (b) b.classList.remove('promo-card__upload--dragover');
        var gate = wrap ? wrap.closest('[data-claim-gate]') : host.querySelector('[data-claim-gate]');
        if (!gate || typeof gate.HANDLE !== 'function') return;
        var dt = e.dataTransfer;
        var file = null;
        if (dt.files && dt.files.length) file = dt.files[0];
        if (!file && dt.items && dt.items.length) {
          var it = dt.items[0];
          if (it.kind === 'file') {
            try { file = it.getAsFile(); } catch (err) {}
          }
        }
        if (file) {
          gate.HANDLE(file);
          return;
        }
        var uri = dt.getData('text/uri-list') || dt.getData('text/plain') || '';
        if (/^https?:\/\//i.test(uri)) {
          statusFor(gate, 'Memuat gambar dari tautan…', 'wait');
          var im = new Image();
          im.onload = function () {
            fileFromUri(uri, function (f) {
              if (f) gate.HANDLE(f); else fileDropError(gate);
            });
          };
          im.onerror = function () { fileDropError(gate); };
          im.src = uri;
        } else {
          fileDropError(gate);
        }
      });

      window.addEventListener('paste', function (e) {
        var items = e.clipboardData && e.clipboardData.items;
        if (!items || !items.length) return;
        for (var pi = 0; pi < items.length; pi++) {
          if (items[pi].kind !== 'file') continue;
          var pf = items[pi].getAsFile();
          if (!pf) continue;
          var gatesAll = document.querySelectorAll('[data-claim-gate]');
          for (var gi = 0; gi < gatesAll.length; gi++) {
            var g2 = gatesAll[gi];
            var c2 = g2.closest ? g2.closest('[data-promo-card]') : null;
            if (c2 && c2.classList.contains('promo-card--unlocked')) continue;
            if (typeof g2.HANDLE === 'function') { g2.HANDLE(pf); return; }
          }
        }
      });

      document.addEventListener('click', function (e) {
        var sb = e.target && e.target.closest ? e.target.closest('[data-submit-proof]') : null;
        if (sb) {
          var gate = sb.closest ? sb.closest('[data-claim-gate]') : null;
          if (gate && typeof gate.SUBMIT === 'function' && !sb.disabled) gate.SUBMIT();
          return;
        }
      });

      var photoLb = document.querySelector('[data-photo-lightbox]');
      var photoLbImg = document.querySelector('[data-photo-lightbox-img]');
      document.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var pimg = t.closest ? t.closest('[data-upload-img]') : null;
        if (pimg && pimg.src && photoLb && photoLbImg) {
          photoLbImg.src = pimg.src;
          photoLb.classList.add('promo-lightbox--open');
          return;
        }
        if ((t.closest('[data-photo-lightbox-close]') || (t.closest('[data-photo-lightbox]') && t === t.closest('[data-photo-lightbox]'))) && photoLb) {
          photoLb.classList.remove('promo-lightbox--open');
        }
      });
    })();

    document.querySelectorAll('[data-copy-code]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-copy-code');
        const original = btn.textContent;
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(code);
          } else {
            const ta = document.createElement('textarea');
            ta.value = code;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
          }
          btn.textContent = `Tersalin (${code})`;
          btn.classList.add('promo-card__copy--ok');
        } catch (e) {
          prompt('Salin kode promo:', code);
        }
