---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBubble from '../components/WhatsAppBubble.astro';
---

<Layout
  title="Promo & Voucher Villa | The Rain Villas"
  description="Info promo dan voucher The Rain Villas. Saat ini belum ada promo aktif — nantikan penawaran menarik berikutnya."
>
  <Header />
  <main class="promo-page">
    <div class="container">
      <header class="promo-page__head">
        <span class="promo-page__badge">Promo &amp; Voucher</span>
        <h1>Promo &amp; Voucher</h1>
        <p>Saat ini belum ada promo atau voucher yang aktif. Nantikan penawaran menarik dari The Rain Villas.</p>
      </header>

      <div class="promo-empty">
        <span class="promo-empty__icon">🎟️</span>
        <h2>Belum ada promo aktif</h2>
        <p>Promo dan voucher terbaru akan muncul di halaman ini. Nantikan penawaran menarik dari The Rain Villas.</p>
      </div>
    </div>
  </main>
  <Footer />
  <WhatsAppBubble />
</Layout>

<style>
  .promo-page {
    min-height: 80vh;
    padding: 80px 0 100px;
    background: var(--color-light);
    position: relative;
  }
  .promo-page::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 640px;
    height: 640px;
    background: radial-gradient(circle, rgba(var(--color-accent-rgb), 0.06) 0%, transparent 70%);
    pointer-events: none;
  }
  .promo-page__head {
    text-align: center;
    margin-bottom: 36px;
    position: relative;
    padding: 44px 24px 40px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    isolation: isolate;
  }
  .promo-page__head::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: url('/background.png');
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.18;
  }
  .promo-page__badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-accent);
    background: rgba(var(--color-accent-rgb), 0.09);
    padding: 6px 18px;
    border-radius: 20px;
    margin-bottom: 14px;
  }
  .promo-page__head h1 {
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--color-dark);
    margin-bottom: 10px;
  }
  .promo-page__head p {
    color: var(--color-gray);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .promo-empty {
    text-align: center;
    background: var(--color-panel);
    border: 1px dashed var(--color-border);
    border-radius: 22px;
    padding: 60px 24px;
    margin-bottom: 48px;
  }
  .promo-empty__icon {
    font-size: 2.6rem;
    display: block;
    margin-bottom: 14px;
  }
  .promo-empty h2 {
    font-size: 1.4rem;
    color: var(--color-dark);
    margin-bottom: 6px;
  }
  .promo-empty p {
    color: var(--color-gray);
    max-width: 420px;
    margin: 0 auto;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .promo-page {
      padding: 60px 0 80px;
    }
    .promo-page__head h1 {
      font-size: 1.8rem;
    }
  }
</style>
