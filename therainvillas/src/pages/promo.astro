---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBubble from '../components/WhatsAppBubble.astro';
import PromoClaim from '../components/PromoClaim.vue';
---

<Layout
  title="Klaim Harga Promo Villa | The Rain Villas"
  description="Klaim harga promo The Rain Villas dengan memberi rating Google Maps dan mengirim bukti rating. Harga awal dicoret khusus villa yang sedang promo."
>
  <Header />
  <main class="promo-page">
    <div class="container">
      <header class="promo-page__head">
        <span class="promo-page__badge">Promo &amp; Voucher</span>
        <h1>Klaim Harga Promo</h1>
        <p>Harga promo (harga awal dicoret) bisa diklaim dengan memberi rating Google Maps dan mengirim bukti rating.</p>
      </header>

      <section class="promo-card">
        <h2>Harga Promo Spesial</h2>
        <div class="promo-page__terms">
          <p class="promo-page__terms-title">Syarat &amp; Ketentuan</p>
          <ul>
            <li>Berlaku untuk malam Minggu–Kamis pada villa dengan harga promo (harga awal dicoret). Malam Jumat, Sabtu, dan 20–31 Desember tidak wajib klaim kode.</li>
            <li>Wajib memberi rating Google Maps dan mengirimkan bukti rating.</li>
            <li>Kode promo muncul secara acak setelah bukti terkirim dan hanya berlaku selama 2 menit.</li>
            <li>Kode promo hanya membuka akses ke harga promo, bukan potongan tambahan.</li>
            <li>Tidak berlaku untuk Rjs Cottage 1, Rjs Cottage 2, Rjs Cottage 3, Villa Kaca 1, dan Villa Kaca 2.</li>
            <li>Tidak dapat digabungkan dengan promo atau voucher lain.</li>
          </ul>
        </div>
        <div class="promo-page__actions">
          <a href="#klaim" class="promo-page__btn promo-page__btn--primary">Klaim Kode Promo</a>
          <a href="/our-villas" class="promo-page__btn">Lihat Villa</a>
        </div>
      </section>

      <PromoClaim client:load />
    </div>
  </main>
  <Footer />
  <WhatsAppBubble />
</Layout>

<style>
  .promo-page {
    min-height: 80vh;
    padding: 80px 0 100px;
    background: var(--color-light);
    position: relative;
  }
  .promo-page__head {
    text-align: center;
    margin-bottom: 36px;
    position: relative;
    padding: 44px 24px 40px;
    border-radius: var(--radius-lg);
  }
  .promo-page__badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-accent);
    background: rgba(var(--color-accent-rgb), 0.09);
    padding: 6px 18px;
    border-radius: 20px;
    margin-bottom: 14px;
  }
  .promo-page__head h1 {
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--color-dark);
    margin-bottom: 10px;
  }
  .promo-page__head p {
    color: var(--color-gray);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .promo-card {
    text-align: center;
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    border-radius: 22px;
    padding: 48px 24px;
    margin-bottom: 8px;
  }
  .promo-card h2 {
    font-size: 1.4rem;
    color: var(--color-dark);
    margin-bottom: 6px;
  }
  .promo-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 18px;
  }
  .promo-page__btn {
    padding: 10px 18px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    background: var(--color-gray-light, #f2f3f6);
    color: var(--color-dark, #0f172a);
  }
  .promo-page__btn--primary {
    background: linear-gradient(135deg, #5b8def, #7a5ce0);
    color: #fff;
  }
  .promo-page__terms {
    max-width: 560px;
    margin: 16px auto 8px;
    text-align: left;
    background: rgba(var(--color-accent-rgb), 0.05);
    border: 1px solid rgba(var(--color-accent-rgb), 0.15);
    border-radius: 14px;
    padding: 20px 24px;
  }
  .promo-page__terms-title {
    margin: 0 0 12px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-dark);
  }
  .promo-page__terms ul {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--color-gray);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .promo-page {
      padding: 60px 0 80px;
    }
    .promo-page__head h1 {
      font-size: 1.8rem;
    }
    .promo-card {
      padding: 36px 18px;
    }
  }
</style>
