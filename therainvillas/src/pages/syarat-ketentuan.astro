---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBubble from '../components/WhatsAppBubble.astro';
import Seo from '../components/Seo.astro';
import { makeTitle, makeDescription } from '../lib/seo.js';

const skTitle = makeTitle('Syarat & Ketentuan Booking Villa');
const skDesc = makeDescription('Syarat dan ketentuan booking, DP, pelunasan, reschedule, check-in/check-out villa The Rain Villas Puncak.');
---

<Layout title={skTitle} description={skDesc}>
  <Seo title={skTitle} description={skDesc} />
  <Header />
  <main class="page">
    <section class="page-hero">
      <div class="container">
        <h1 class="page-title">Syarat & Ketentuan</h1>
        <p class="page-subtitle">Ketentuan booking dan menginap di The Rain Villas</p>
      </div>
    </section>
    <section class="container content">
      <div class="card">
        <h2>Ketentuan Booking</h2>
        <ul>
          <li>Booking dilakukan melalui WhatsApp admin resmi The Rain Villas.</li>
          <li>DP minimal 30% dari harga villa, pelunasan wajib H-3 sebelum check-in.</li>
          <li>Reschedule maksimal H-7 sebelum tanggal check-in dengan penambahan DP.</li>
          <li>DP tidak bisa di-refund dalam kondisi apapun.</li>
          <li>Jika pelunasan tidak dilakukan H-3 sebelum check-in, uang DP dianggap hangus.</li>
        </ul>
        <h2>Ketentuan Menginap</h2>
        <ul>
          <li>Check-in mengikuti kesepakatan, check-out wajib dilakukan pukul 12.00.</li>
          <li>Lebih dari jam check-out dikenakan charge Rp 500.000.</li>
          <li>Kapasitas tamu disesuaikan per villa. Jika melebihi kapasitas dikenakan charge tambahan Rp 50.000/orang.</li>
          <li>Dilarang membawa minuman keras, obat terlarang, senjata tajam, dan peliharaan.</li>
          <li>Jam malam berlaku hingga pukul 22.00.</li>
          <li>Kerusakan barang yang ditimbulkan tamu dikenakan biaya ganti rugi sesuai nominal harga barang.</li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppBubble />
</Layout>

<style>
  .page-hero { background: linear-gradient(135deg, #0d1b2b 0%, #1e3a5f 100%); color: white; padding: 80px 0 60px; text-align: center; }
  .page-title { font-size: 2.5rem; margin-bottom: 12px; }
  .page-subtitle { opacity: 0.9; }
  .content { padding: 60px 24px; max-width: 900px; }
  .card { background: white; padding: 40px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
  .card h2 { margin: 32px 0 16px; color: #0d1b2b; }
  .card h2:first-of-type { margin-top: 0; }
  .card ul { list-style: disc; padding-left: 24px; }
  .card li { padding: 8px 0; line-height: 1.7; }
</style>
