---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBubble from '../components/WhatsAppBubble.astro';
import AboutSection from '../components/AboutSection.astro';
import TeamSection from '../components/TeamSection.astro';
import LocationSection from '../components/LocationSection.astro';
import { villas } from '../data/villas';
import { villaCovers, villaHeroCovers } from '../data/covers';

const firstCover = villaCovers[villas[0].name] ?? villas[0].image;
const firstCoverSm = villaHeroCovers[villas[0].name] ?? firstCover;
---

<Layout title="Tentang Kami | The Rain Villas" description="Kenali The Rain Villas — manajemen villa murah dan modern di Puncak, Cisarua, Bogor." preloadImage={{ sm: firstCoverSm, lg: firstCover }}>
  <Header />

  <section class="page-hero">
    <div class="page-hero__bg">
      {villas.slice(0, 12).map((v, i) => {
        const cover = villaCovers[v.name] ?? v.image;
        const coverSm = villaHeroCovers[v.name] ?? cover;
        return i < 1
          ? <div class="page-hero__slide" style={`--bg-lg: url("${cover}"); --bg-sm: url("${coverSm}")`} data-index={i}></div>
          : <div class="page-hero__slide" data-bg={cover} data-bg-sm={coverSm} data-index={i}></div>;
      })}
      <div class="page-hero__overlay"></div>
    </div>
    <div class="container" style="position:relative;z-index:1">
      <h1 class="page-hero__title reveal">Tentang Kami</h1>
      <p class="page-hero__subtitle reveal reveal--delay-1">Villa murah & modern di Puncak, Cisarua, Bogor</p>
    </div>
  </section>

  <script is:inline>
    // Slide pertama dimuat langsung; slide lainnya dimuat bertahap (3 detik
    // sekali, selaras dengan animation-delay) agar tidak berebut di awal.
    (function () {
      var slides = document.querySelectorAll('.page-hero__slide[data-bg]');
      if (!slides.length) return;
      function start() {
        for (var i = 0; i < slides.length; i++) {
          (function (el) {
            var idx = parseInt(el.getAttribute('data-index'), 10) || 0;
            setTimeout(function () {
              el.style.setProperty('--bg-lg', 'url("' + el.getAttribute('data-bg') + '")');
              el.style.setProperty('--bg-sm', 'url("' + (el.getAttribute('data-bg-sm') || el.getAttribute('data-bg')) + '")');
            }, 1500 + (idx - 1) * 3000);
          })(slides[i]);
        }
      }
      if (document.readyState === 'complete') start();
      else window.addEventListener('load', start, { once: true });
    })();
  </script>

  <AboutSection />
  <TeamSection />
  <LocationSection />

  <Footer />
  <WhatsAppBubble />
</Layout>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    color: white;
    text-align: center;
    padding: 80px 24px 60px;
    background: #0d1b2b;
  }
  .page-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .page-hero__slide {
    position: absolute;
    inset: 0;
    background-image: var(--bg-lg);
    background-size: cover;
    background-position: center;
    opacity: 0;
    animation: hero-fade 36s ease-in-out infinite;
  }

  /* Layar kecil: pakai varian hero yang jauh lebih ringan (HP ~60-100 KiB). */
  @media (max-width: 768px) {
    .page-hero__slide { background-image: var(--bg-sm); }
  }
  .page-hero__slide[data-index="0"] { animation-delay: 0s; }
  .page-hero__slide[data-index="1"] { animation-delay: 3s; }
  .page-hero__slide[data-index="2"] { animation-delay: 6s; }
  .page-hero__slide[data-index="3"] { animation-delay: 9s; }
  .page-hero__slide[data-index="4"] { animation-delay: 12s; }
  .page-hero__slide[data-index="5"] { animation-delay: 15s; }
  .page-hero__slide[data-index="6"] { animation-delay: 18s; }
  .page-hero__slide[data-index="7"] { animation-delay: 21s; }
  .page-hero__slide[data-index="8"] { animation-delay: 24s; }
  .page-hero__slide[data-index="9"] { animation-delay: 27s; }
  .page-hero__slide[data-index="10"] { animation-delay: 30s; }
  .page-hero__slide[data-index="11"] { animation-delay: 33s; }
  @keyframes hero-fade {
    0%, 5% { opacity: 0; }
    8%, 22% { opacity: 1; }
    25%, 100% { opacity: 0; }
  }
  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(15,23,42,0.7) 0%, rgba(91,141,239,0.5) 100%);
  }
  .page-hero__title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .page-hero__subtitle {
    font-size: 1.1rem;
    opacity: 0.85;
  }

  @media (max-width: 768px) {
    .page-hero__title { font-size: 1.8rem; }
  }
</style>